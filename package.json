{
  "name": "nathan-pannell-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run test:content && astro check && astro build && npm run test:seo",
    "preview": "astro preview",
    "check": "astro check",
    "capture:build-night": "node scripts/capture-build-night.mjs",
    "test:content": "node tests/content-contract.mjs",
    "test:seo": "node tests/seo-contract.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/gaegu": "^5.3.0",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0"
  }
}
