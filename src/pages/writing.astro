---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPublishedWriting } from '../lib/content';
import graduationImage from '../content/writing/_assets/grad.jpg';
import hackathonImage from '../content/writing/_assets/hackathon-code-hack.jpg';

const essays = await getPublishedWriting();
const formatYear = (date: Date) => date.getFullYear().toString();
const essayVisuals: Record<string, string> = {
  graduation: graduationImage.src,
  'icbc-coop': '/media/plates/writing-print.webp',
  'hackathon-learnings': hackathonImage.src,
};
---

<SiteLayout
  title="Writing | Nathan Pannell"
  description="Essays about building software, making mistakes, and learning what holds up in practice."
  pageClass="writing-page"
>
  <main id="main-content" class="writing-main">
    <section class="writing-selector" aria-labelledby="writing-title">
      <SiteHeader tone="light" />
      <div class="writing-selector__intro">
        <h1 id="writing-title">Writing</h1>
        <p>Projects, mistakes, and the lessons that stuck.</p>
      </div>
      <ol class="writing-selector__list">
        {essays.map((essay, index) => {
          const visual = essayVisuals[essay.id] ?? '/media/plates/writing-print.webp';
          return (
          <li
            class:list={['writing-selector__item', { 'writing-selector__item--active': index === 0 }]}
            style={`--writing-image: url(${visual})`}
          >
            <a href={`/${essay.id}/`}>
              <span class="writing-selector__copy">
                <span class="writing-selector__title">{essay.data.title}</span>
                {essay.data.description && <span class="writing-selector__description">{essay.data.description}</span>}
              </span>
              <time datetime={essay.data.pubDate.toISOString()}>{formatYear(essay.data.pubDate)}</time>
            </a>
          </li>
          );
        })}
      </ol>
    </section>
    <SiteFooter />
  </main>
</SiteLayout>

<style>
  .writing-selector {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 3rem) clamp(1.25rem, 3vw, 3rem) clamp(3rem, 6vw, 6rem);
    background: var(--writing-room);
    color: var(--paper);
  }

  .writing-selector__intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-block: clamp(5rem, 9vw, 8rem) clamp(2.5rem, 5vw, 4.5rem);
  }

  .writing-selector__intro h1,
  .writing-selector__intro p {
    margin: 0;
  }

  .writing-selector__intro h1 {
    font-family: var(--display);
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .writing-selector__intro p {
    max-width: 27rem;
    color: var(--writing-copy);
    text-align: right;
  }

  .writing-selector__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--writing-line);
  }

  .writing-selector__item {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--writing-line);
  }

  .writing-selector__item::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(90deg, var(--writing-wash-strong), var(--writing-wash-soft)),
      var(--writing-image) center / cover;
    opacity: 0;
    transform: scale(1.025);
    transition: opacity 240ms var(--ease-out), transform 480ms var(--ease-out);
  }

  .writing-selector__item a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem;
    min-height: clamp(8.5rem, 13vw, 12rem);
    padding: clamp(1.25rem, 2.4vw, 2rem) clamp(0.25rem, 1vw, 1rem);
    color: var(--writing-muted);
    text-decoration: none;
    transition: color 180ms var(--ease-out), transform 180ms var(--ease-out);
  }

  .writing-selector__item--active a,
  .writing-selector__item a:focus-visible {
    color: var(--paper);
  }

  .writing-selector__item--active::before,
  .writing-selector__item:has(a:focus-visible)::before {
    opacity: 1;
    transform: scale(1);
  }

  .writing-selector__list:has(a:focus-visible) .writing-selector__item--active a:not(:focus-visible) {
    color: var(--writing-muted);
  }

  .writing-selector__copy {
    display: grid;
    gap: 0.65rem;
  }

  .writing-selector__item a:focus-visible {
    transform: translateX(0.45rem);
  }

  @media (hover: hover) and (pointer: fine) {
    .writing-selector__item a:hover {
      color: var(--paper);
      transform: translateX(0.45rem);
    }

    .writing-selector__item:has(a:hover)::before {
      opacity: 1;
      transform: scale(1);
    }

    .writing-selector__list:has(a:hover) .writing-selector__item--active a:not(:hover) {
      color: var(--writing-muted);
    }
  }

  .writing-selector__title {
    max-width: 24ch;
    font-family: var(--display);
    font-size: clamp(1.75rem, 4.4vw, 4.65rem);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .writing-selector__description {
    max-width: 62ch;
    color: var(--writing-copy);
    font-size: clamp(0.98rem, 1.15vw, 1.12rem);
    line-height: 1.35;
  }

  .writing-selector time {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .writing-selector__intro {
      display: block;
      margin-top: clamp(4rem, 11vw, 5.5rem);
    }

    .writing-selector__intro p {
      margin-top: 1rem;
      text-align: left;
    }

    .writing-selector__item a {
      gap: 1rem;
      min-height: 9rem;
      padding-inline: 0;
    }

    .writing-selector__title {
      font-size: clamp(2rem, 9.5vw, 3rem);
    }

    .writing-selector__description {
      font-size: 0.95rem;
    }
  }
</style>
