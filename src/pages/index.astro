---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import BuildNight from '../components/BuildNight.astro';
import Hero from '../components/Hero.astro';
import Index from '../components/Index.astro';
import Offbooked from '../components/Offbooked.astro';
import Parkdex from '../components/Parkdex.astro';
import Sandbox from '../components/Sandbox.astro';
import Tempo from '../components/Tempo.astro';
---

<SiteLayout>
  <main id="main-content">
    <Hero />
    <BuildNight />
    <Offbooked />
    <Parkdex />
    <Sandbox />
    <Tempo />
    <Index />
  </main>
</SiteLayout>

<script>
  import { startCover } from '../scripts/cover';
  import { startDoors } from '../scripts/doors';
  import { startFrames } from '../scripts/frames';
  import { startMoments } from '../scripts/moments';
  import { startLoops, startRests } from '../scripts/motion';
  import { startRide } from '../scripts/ride';
  import { startSounds } from '../scripts/sound';
  import { startSteps } from '../scripts/steps';
  import { startSwing } from '../scripts/swing';
  import { startTempo } from '../scripts/tempo';
  import { startWash } from '../scripts/wash';

  // Scenes close first, so everything after finds them in the state they will open from. One of
  // these failing leaves the others running.
  for (const start of [
    startDoors,
    startMoments,
    startSteps,
    startLoops,
    startRests,
    startCover,
    startTempo,
    startRide,
    startSwing,
    startSounds,
    startWash,
    startFrames,
  ]) {
    try {
      start();
    } catch (error) {
      console.error(error);
    }
  }
</script>
