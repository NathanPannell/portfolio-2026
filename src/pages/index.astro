---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import BuildNight from '../components/BuildNight.astro';
import Chrome from '../components/Chrome.astro';
import Hero from '../components/Hero.astro';
import Index from '../components/Index.astro';
import Offbooked from '../components/Offbooked.astro';
import Parkdex from '../components/Parkdex.astro';
import Sandbox from '../components/Sandbox.astro';
---

<SiteLayout>
  <Chrome />
  <main id="main-content">
    <div id="top"></div>
    <Hero />
    <BuildNight />
    <Sandbox />
    <Offbooked />
    <Parkdex />
    <Index />
  </main>
</SiteLayout>

<script>
  import { startCollage } from '../scripts/collage';
  import { startCrowd } from '../scripts/crowd';
  import { startLevel } from '../scripts/level';
  import { startRoom } from '../scripts/room';
  import { startLoops, startReveals, startScroll } from '../scripts/scroll';
  import { startToys } from '../scripts/toys';
  import { startWash } from '../scripts/wash';

  startScroll();
  startReveals();
  startLoops();
  startRoom();
  startLevel();
  startCollage();
  startToys();
  startWash();
  void startCrowd();
</script>
