---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getProjects, getPublishedWriting } from '../lib/content';
import graduationImage from '../content/writing/_assets/grad.jpg';
import hackathonImage from '../content/writing/_assets/hackathon-code-hack.jpg';

const [projects, writing] = await Promise.all([getProjects(), getPublishedWriting()]);

const projectVisuals: Record<string, { src?: string; alt: string }> = {
  parkdex: {
    src: '/media/parkdex/map-overview.webp',
    alt: 'Map of parks across Vancouver Island in Parkdex',
  },
  doxxme: {
    src: '/media/projects/doxxme-home.webp',
    alt: 'Doxxme landing page with a dark globe and yellow product accents',
  },
  commons: {
    src: '/media/projects/commons-demo.webp',
    alt: 'Commons interface for finding people, events, and communities',
  },
  'go-fetch': {
    src: '/media/projects/go-fetch-architecture.jpg',
    alt: 'Go Fetch service architecture diagram',
  },
  'cup-of-sugar': {
    src: '/media/projects/cup-of-sugar-poster.webp',
    alt: 'Cup of Sugar food donation matching interface',
  },
};

const essayDates = new Intl.DateTimeFormat('en-CA', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

const essayVisuals: Record<string, string> = {
  graduation: graduationImage.src,
  'icbc-coop': '/media/plates/writing-print.webp',
  'hackathon-learnings': hackathonImage.src,
};
---

<SiteLayout>
  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <img
        class="hero__photo"
        src="/media/hero/nathan-on-boat-wide.webp"
        alt="Nathan Pannell smiling on a sailboat off Vancouver Island"
        width="1896"
        height="830"
        fetchpriority="high"
      />
      <div class="hero__shade" aria-hidden="true"></div>
      <SiteHeader tone="dark" overlay />
      <h1 id="hero-title" class="hero__title">
        <span>I build products <br />that make life</span>{' '}
        <em>more fun.</em>
      </h1>
      <div class="hero__prints" aria-label="A preview of Nathan's work">
        <a class="hero-print hero-print--parkdex" href="/parkdex/" aria-label="Explore Parkdex">
          <span class="hero-print__window">
            <img src="/media/parkdex/map-overview.webp" alt="Parkdex map of parks across Vancouver Island" width="1600" height="875" loading="lazy" fetchpriority="low" />
          </span>
          <span class="hero-print__label">Parkdex</span>
        </a>
        <a class="hero-print hero-print--writing" href="/writing/" aria-label="Read Nathan's writing">
          <span class="hero-print__window">
            <img src="/media/plates/writing-print.webp" alt="A laptop open to a draft beside an island sunset" width="1586" height="992" loading="lazy" fetchpriority="low" />
          </span>
          <span class="hero-print__label">Writing</span>
        </a>
        <span class="hero-print hero-print--island" aria-hidden="true">
          <span class="hero-print__window">
            <img src="/media/plates/island-print.webp" alt="" width="1586" height="992" loading="lazy" fetchpriority="low" />
          </span>
          <span class="hero-print__label">Vancouver Island</span>
        </span>
      </div>
    </section>

    <section id="parkdex" class="parkdex-story section-shell" aria-labelledby="parkdex-title">
      <div class="parkdex-story__copy">
        <h2 id="parkdex-title">The island needed a Pokédex.</h2>
        <p class="parkdex-story__lede">
          Parkdex started with one goal: visit all 117 provincial parks on Vancouver Island.
        </p>
        <p>
          I built the current web app around profiles, park search, wishlists, visit tracking, completion, and badges across roughly 200 parks and islands.
        </p>
        <p>
          Next up: an Android app that verifies visits by GPS, pings you when you arrive, and lets you take a Polaroid on site.
        </p>
        <div class="button-row">
          <a class="button button--primary" href="https://parkdex.app">Explore Parkdex</a>
          <a class="text-link" href="/parkdex/">
            Read the project story
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg>
          </a>
        </div>
      </div>

      <div class="parkdex-story__gallery" aria-label="Parkdex interface previews">
        <figure class="parkdex-shot parkdex-shot--map">
          <img src="/media/parkdex/map-overview.webp" alt="Parkdex map overview showing Vancouver Island" loading="lazy" width="1600" height="875" />
        </figure>
        <figure class="parkdex-shot parkdex-shot--detail">
          <img src="/media/parkdex/park-detail.webp" alt="A park detail view in Parkdex" loading="lazy" width="720" height="1280" />
        </figure>
        <figure class="parkdex-shot parkdex-shot--progress">
          <img src="/media/parkdex/island-progress.webp" alt="Vancouver Island completion progress in Parkdex" loading="lazy" width="720" height="1280" />
        </figure>
        <figcaption>Parkdex, 2026 · Map © OpenStreetMap contributors.</figcaption>
      </div>
    </section>

    <section id="projects" class="projects section-shell" aria-labelledby="projects-title">
      <div class="section-heading">
        <h2 id="projects-title">Built with good people and a deadline.</h2>
        <p>Five things I’ve shipped, from an island-wide park tracker to six-hour hackathon builds.</p>
      </div>

      <div class="project-deck">
        {projects.map((project) => {
          const visual = projectVisuals[project.id];
          return (
            <a class:list={['project-polaroid', `project-polaroid--${project.id}`]} data-polaroid href={`/${project.id}/`} style={`--project-accent:${project.data.accent}`}>
              <span class="project-polaroid__image">
                {visual?.src ? (
                  <img src={visual.src} alt={visual.alt} loading="lazy" />
                ) : (
                  <span class="commons-diagram" aria-label={visual?.alt ?? `${project.data.title} project visual`} role="img">
                    <span class="commons-diagram__prompt">Your next conversation</span>
                    <span class="commons-diagram__agent">Events</span>
                    <span class="commons-diagram__agent">People</span>
                    <span class="commons-diagram__agent">Groups</span>
                    <span class="commons-diagram__agent">Places</span>
                    <span class="commons-diagram__agent">Ideas</span>
                  </span>
                )}
              </span>
              <span class="project-polaroid__caption">
                <strong>{project.data.title}</strong>
                <span>{project.data.displayDate}</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="writing-preview section-shell" aria-labelledby="writing-title">
      <div class="writing-preview__intro">
        <h2 id="writing-title">Notes from building and learning.</h2>
        <a class="text-link" href="/writing/">
          Enter the writing room
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg>
        </a>
      </div>
      <ol class="essay-list">
        {writing.slice(0, 3).map((essay) => {
          const visual = essayVisuals[essay.id] ?? '/media/plates/writing-print.webp';
          return (
          <li data-essay-item style={`--essay-image: url(${visual})`}>
            <a href={`/${essay.id}/`}>
              <span class="essay-list__title">{essay.data.title}</span>
              <time datetime={essay.data.pubDate.toISOString()}>{essayDates.format(essay.data.pubDate)}</time>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
            </a>
          </li>
          );
        })}
      </ol>
    </section>

    <SiteFooter />
  </main>

  <script>
    import '../scripts/project-polaroids';
  </script>
</SiteLayout>
