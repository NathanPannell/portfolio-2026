---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteLayout from './SiteLayout.astro';

interface ProjectLink {
  label: string;
  href: string;
}

interface Collaborator {
  name: string;
  href?: string | undefined;
}

interface ProjectMedia {
  kind: 'image' | 'video' | 'youtube';
  src: string;
  poster?: string | undefined;
  alt: string;
  caption?: string | undefined;
  width?: number | undefined;
  height?: number | undefined;
}

interface ProjectHighlight {
  value: string;
  label: string;
}

interface Props {
  slug: string;
  title: string;
  tagline: string;
  summary: string;
  projectType: string;
  displayDate: string;
  accent: string;
  cover: string;
  coverAlt: string;
  coverWidth: number;
  coverHeight: number;
  highlights: ProjectHighlight[];
  links: ProjectLink[];
  collaborators?: Collaborator[] | undefined;
  media?: ProjectMedia[] | undefined;
}

const {
  slug,
  title,
  tagline,
  summary,
  projectType,
  displayDate,
  accent,
  cover,
  coverAlt,
  coverWidth,
  coverHeight,
  highlights,
  links,
  collaborators = [],
  media = [],
} = Astro.props;

const detailMedia = media;
---

<SiteLayout title={`${title} | Nathan Pannell`} description={summary} image={cover} imageAlt={coverAlt} imageWidth={coverWidth} imageHeight={coverHeight} pageClass="project-page">
  <SiteHeader />
  <main id="main-content" class="project-main" style={`--project-accent: ${accent}`}>
    <header class:list={['project-intro', `project-intro--${slug}`]}>
      <a class="project-intro__back" href="/#projects">All projects</a>
      <div class="project-intro__content">
        <div class="project-intro__copy">
          <h1>{title}</h1>
          <p class="project-intro__tagline">{tagline}</p>
          <p class="project-intro__summary">{summary}</p>
          <nav class="project-actions" aria-label={`${title} links`}>
            {links.map((link, index) => (
              <a class:list={['project-actions__link', { 'project-actions__link--primary': index === 0 }]} href={link.href}>
                {link.label}
              </a>
            ))}
          </nav>
          <dl class="project-meta">
            <div>
              <dt>Built</dt>
              <dd>{displayDate}</dd>
            </div>
            <div>
              <dt>Type</dt>
              <dd>{projectType}</dd>
            </div>
          </dl>
        </div>
        <figure class="project-intro__visual" style={`--project-cover-ratio: ${coverWidth} / ${coverHeight}`}>
          <span class="project-intro__visual-window">
            <img src={cover} alt={coverAlt} width={coverWidth} height={coverHeight} fetchpriority="high" decoding="async" />
          </span>
        </figure>
      </div>
      <dl class="project-highlights" aria-label={`${title} highlights`}>
        {highlights.map((highlight) => (
          <div>
            <dt>{highlight.value}</dt>
            <dd>{highlight.label}</dd>
          </div>
        ))}
      </dl>
    </header>

    <div class:list={['project-story', { 'project-story--with-media': detailMedia.length > 0 }]}>
      {detailMedia.length > 0 && (
        <section class="project-media" aria-label={`${title} media`}>
          {detailMedia.map((item) => (
            <figure class="project-media__item">
              {item.kind === 'image' && (
                <img src={item.src} alt={item.alt} width={item.width} height={item.height} loading="eager" decoding="async" />
              )}
              {item.kind === 'video' && (
                <video controls preload="metadata" poster={item.poster} width={item.width} height={item.height} aria-label={item.alt}>
                  <source src={item.src} type="video/mp4" />
                  <a href={item.src}>Watch the {title} demo</a>
                </video>
              )}
              {item.kind === 'youtube' && (
                <iframe
                  src={item.src}
                  title={item.alt}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              )}
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )}

      <article class="project-body prose">
        <slot />
      </article>
    </div>

    {collaborators.length > 0 && (
      <aside class="project-collaborators" aria-labelledby="project-collaborators-title">
        <h2 id="project-collaborators-title">Built with</h2>
        <ul>
          {collaborators.map((collaborator) => (
            <li>
              {collaborator.href ? (
                <a href={collaborator.href}>{collaborator.name}</a>
              ) : (
                collaborator.name
              )}
            </li>
          ))}
        </ul>
      </aside>
    )}

    <SiteFooter />
  </main>
</SiteLayout>
