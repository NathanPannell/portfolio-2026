---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
  pageClass?: string;
}

const {
  title = 'Nathan Pannell | Software engineer building Parkdex',
  description = 'I build upbeat apps that get people into the real world. Parkdex turns Vancouver Island into one giant completionist map.',
  image = '/media/hero/nathan-on-boat-wide.webp',
  imageAlt = 'Nathan Pannell on a boat off Vancouver Island',
  imageWidth,
  imageHeight,
  type = 'website',
  publishedTime,
  noindex = false,
  structuredData,
  pageClass = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const personId = new URL('/#person', Astro.site).href;
const homeData =
  Astro.url.pathname === '/'
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Person',
            '@id': personId,
            name: 'Nathan Pannell',
            url: new URL('/', Astro.site).href,
            sameAs: [
              'https://www.github.com/nathanpannell',
              'https://www.linkedin.com/in/nathanpannell',
            ],
          },
          {
            '@type': 'WebSite',
            '@id': new URL('/#website', Astro.site).href,
            name: 'Nathan Pannell',
            url: new URL('/', Astro.site).href,
            publisher: { '@id': personId },
          },
        ],
      }
    : undefined;
const jsonLd = structuredData ?? homeData;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Nathan Pannell" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#f1f0e8" />
    <title>{title}</title>
    {jsonLd && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')}
      />
    )}
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <slot />
    <script>
      import '../scripts/navigation-focus';
    </script>
  </body>
</html>
