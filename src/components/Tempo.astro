---
import '@fontsource-variable/big-shoulders-display';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import Steps from './Steps.astro';

// Each picture is the live game, played through. See ASSETS.md.
const steps = [
  {
    title: 'It’s 5:58 a.m., and you’re the new drummer.',
    image: '/media/tempo/stool',
    alt: 'The view from the drum stool at dawn: the kit, the empty podium and the band, waiting',
  },
  {
    title: 'Keep his tempo. When he stops, call it: rushing, dragging or in time.',
    image: '/media/tempo/stop',
    alt: 'The band stopped, and the game asking: Rushing? Or dragging? With a third button, in time',
  },
  {
    title: 'Duck when the chair comes.',
    image: '/media/tempo/chair',
    alt: 'The conductor with a chair raised over his head, and the word Duck across the screen',
  },
  {
    title: 'Find all three endings.',
    image: '/media/tempo/ending',
    alt: 'The game’s result screen: The Nod, ending 1 of 3',
  },
];

const beats = ['One', 'Two', 'Three', 'Four'];
---

<section
  id="not-quite-my-tempo"
  class="tp"
  data-frame
  data-moment
  data-tempo
  data-loops
  tabindex="-1"
  aria-labelledby="tp-title"
>
  <div class="tp-page">
    <header class="tp__head">
      <h2 id="tp-title">
        <span>Not quite</span>
        <span>my tempo</span>
      </h2>
      <p>A four-minute rhythm horror game in a jazz rehearsal room.</p>
      <a class="tp__cta" href="https://notquitemytempo-sand.vercel.app/" data-opens>
        Take the stool <span aria-hidden="true">→</span>
      </a>
    </header>
    <Steps name="tempo" steps={steps} shape="wide" layout="rotating" address="His patience" pairs />
  </div>

  <div class="tp-closed">
    <picture class="tp-closed__room">
      <source
        media="(max-aspect-ratio: 1/1)"
        srcset="/media/tempo/room-tall-800.webp"
        width="800"
        height="1200"
      />
      <img
        src="/media/tempo/room-1800.webp"
        width="1800"
        height="1013"
        loading="lazy"
        decoding="async"
        alt=""
      />
    </picture>
    <p class="tp-closed__name">
      <span>Not quite</span>
      <span>my tempo</span>
    </p>
    <div class="tp-count" aria-hidden="true">
      {beats.map((beat, index) => (
        <span style={`--beat-index: ${index}`}>{beat}</span>
      ))}
    </div>
    <div class="tp-verdict" aria-hidden="true">
      <strong data-verdict></strong>
      <span data-verdict-by></span>
    </div>
    <button
      class="tp-tap"
      type="button"
      data-moment-control
      aria-expanded="false"
      aria-label="Tap on the beat to start the rehearsal"
    >
      <i class="tp-tap__closing" data-beat></i>
      <span aria-hidden="true">Tap</span>
    </button>
    <p class="tp-closed__hint" aria-hidden="true">
      On the beat
    </p>
  </div>
</section>

<style>
  .tp {
    --tp-ink: #090706;
    --tp-amber: #e3a646;
    --tp-cream: #efe5cf;
    --tp-smoke: #a99c89;
    --tp-red: #e0464d;
    --tp-display: 'Big Shoulders Display Variable', 'Arial Narrow', Impact, sans-serif;
    --tp-serif: 'Cormorant Garamond', Georgia, serif;
    --beat: 625ms;
    --bar: calc(100lvh - 100svh);
    position: relative;
    height: 100lvh;
    overflow: clip;
    background: var(--tp-ink);
    color: var(--tp-cream);
  }

  .tp:focus {
    outline: none;
  }

  /* The opened page. A review pill sits over it, so it is the box for that. */
  .tp-page {
    --steps-room: calc(100svh - 13rem);
    --step-size: clamp(1.2rem, min(1.9vw, 3.4svh), 1.8rem);
    --step-lines: 3;
    --step-number: transparent;
    --step-number-ink: var(--tp-amber);
    --step-frame: 1px solid rgb(239 229 207 / 22%);
    --step-corner: 2px;
    --step-behind: #000;
    --step-weight: 500;
    --step-tracking: 0;
    --step-wait: 1250ms;
    --bar-height: 2.25rem;
    --window: min(58vw, calc((var(--steps-room) - var(--bar-height)) * 1.6));
    --rail-size: clamp(1.35rem, min(2.35vw, 4.2svh), 2.4rem);
    --rail-rows: 0.4rem;
    --rail-number-gap: 0.25em;
    position: relative;
    display: grid;
    grid-template-rows: auto auto;
    gap: clamp(1rem, 3.5svh, 2.5rem);
    align-content: center;
    height: 100svh;
    overflow: hidden;
    padding: 4rem var(--gutter) 2rem;
    background: radial-gradient(70% 90% at 72% 34%, #2b1b11, var(--tp-ink));
    font-family: var(--tp-serif);
    font-style: italic;
  }

  .tp__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 2rem;
    align-items: end;
  }

  h2 {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.28em;
    font-family: var(--tp-display);
    font-size: clamp(2.3rem, min(6vw, 10.5svh), 5.75rem);
    font-style: normal;
    font-weight: 900;
    line-height: 0.86;
    text-transform: uppercase;
  }

  h2 span {
    white-space: nowrap;
  }

  h2 span:first-child,
  .tp-closed__name span:first-child {
    color: var(--tp-amber);
  }

  h2 span:last-child,
  .tp-closed__name span:last-child {
    color: transparent;
    -webkit-text-stroke: 0.022em var(--tp-cream);
  }

  .tp__head p {
    grid-row: 2;
    font-size: clamp(1.05rem, min(1.7vw, 3svh), 1.5rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .tp__cta {
    position: relative;
    z-index: 3;
    grid-row: 1 / span 2;
    grid-column: 2;
    padding: 0.8rem 1.25rem;
    border: 1px solid rgb(239 229 207 / 45%);
    border-radius: 2px;
    background: var(--tp-amber);
    color: var(--tp-ink);
    font-family: var(--mono);
    font-size: 0.85rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .tp__cta:hover {
      background: var(--tp-cream);
    }
  }

  /* The heading follows the steps in, once the room is up. */
  :global(.stage) .tp:not([data-open]) .tp__head {
    opacity: 0;
    transform: translate3d(0, 1.75rem, 0);
  }

  .tp[data-open] .tp__head {
    transition:
      opacity 320ms 1100ms,
      transform 560ms var(--ease) 1100ms;
  }

  /* The closed screen: the view from the stool, and the game's own ring closing on the beat. */
  .tp-closed {
    --ring: clamp(6.5rem, min(44vw, 30svh), 15rem);
    --ring-left: 50%;
    --ring-top: 70%;
    position: absolute;
    z-index: 4;
    inset: 0;
    display: none;
    overflow: clip;
    background: var(--tp-ink);
  }

  :global(.stage) .tp:not([data-open]) .tp-closed {
    display: block;
  }

  /* The verdict hangs in the air, then the room comes up behind it. */
  .tp[data-open] .tp-closed {
    display: block;
    pointer-events: none;
    animation: tp-up 1300ms linear forwards;
  }

  @keyframes tp-up {
    0%,
    68% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      visibility: hidden;
    }
  }

  .tp-closed::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 45%, transparent 45%, rgb(0 0 0 / 62%)), rgb(9 7 6 / 38%);
    pointer-events: none;
  }

  .tp-closed > * {
    position: absolute;
    z-index: 1;
  }

  .tp-closed > .tp-closed__room {
    z-index: 0;
    inset: 0;
  }

  /* The drum is left of the middle of this picture, and the ring sits on it. */
  .tp-closed__room img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 13% 50%;
  }

  .tp-closed__name {
    top: 3.25rem;
    left: var(--gutter);
    font-family: var(--tp-display);
    font-size: clamp(3rem, min(15vw, 11svh), 9.4rem);
    font-weight: 900;
    line-height: 0.84;
    text-transform: uppercase;
  }

  .tp-closed__name span {
    display: block;
  }

  .tp-tap {
    top: var(--ring-top);
    left: var(--ring-left);
    display: grid;
    place-items: center;
    width: var(--ring);
    height: var(--ring);
    padding: 0;
    border: 2px solid rgb(239 229 207 / 60%);
    border-radius: 50%;
    background: rgb(9 7 6 / 38%);
    color: var(--tp-cream);
    font-family: var(--tp-display);
    font-size: calc(var(--ring) * 0.2);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
  }

  .tp-tap__closing {
    position: absolute;
    inset: -2px;
    border: 3px solid var(--tp-amber);
    border-radius: 50%;
    pointer-events: none;
  }

  :global(.stage) .tp-tap__closing {
    animation: tp-close var(--beat) linear infinite;
  }

  @keyframes tp-close {
    from {
      opacity: 0;
      transform: scale(1.75);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .tp-tap:hover {
      background: rgb(227 166 70 / 22%);
    }
  }

  .tp-count,
  .tp-verdict {
    bottom: calc(100% - var(--ring-top) + var(--ring) * 0.72);
    left: var(--ring-left);
    display: grid;
    justify-items: center;
    width: max-content;
    font-family: var(--tp-display);
    font-size: clamp(3rem, min(10vw, 15svh), 8.5rem);
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .tp-count span {
    grid-area: 1 / 1;
    opacity: 0;
    text-shadow: 0 4px 24px rgb(0 0 0 / 90%);
  }

  /* The word lands with the ring, a beat after the ring starts closing. */
  :global(.stage) .tp-count span {
    animation: tp-count calc(var(--beat) * 4) linear calc(var(--beat) * (var(--beat-index) + 1))
      infinite;
  }

  @keyframes tp-count {
    0% {
      opacity: 1;
      transform: scale(1.12);
    }

    6%,
    24.9% {
      opacity: 1;
      transform: none;
    }

    25%,
    100% {
      opacity: 0;
    }
  }

  .tp-closed__hint {
    top: calc(var(--ring-top) + var(--ring) * 0.56);
    left: var(--ring-left);
    color: var(--tp-cream);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  /* Pressed: the ring is gone and the word lands, in the game's colours. */
  .tp[data-open] .tp-tap {
    border-color: var(--tp-amber);
    transform: translate(-50%, -50%) scale(1.5);
    opacity: 0;
    transition:
      transform 420ms var(--ease),
      opacity 420ms;
  }

  .tp[data-open] .tp-tap__closing {
    animation: none;
  }

  .tp[data-open] .tp-count,
  .tp[data-open] .tp-closed__hint {
    display: none;
  }

  .tp-verdict {
    color: var(--tp-amber);
    visibility: hidden;
  }

  .tp-verdict span {
    color: var(--tp-cream);
    font-family: var(--mono);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-shadow: 0 1px 8px rgb(0 0 0 / 90%);
    text-transform: none;
  }

  .tp-verdict strong {
    text-shadow: 0 4px 24px rgb(0 0 0 / 90%);
  }

  .tp-verdict [data-word='good'] {
    color: var(--tp-cream);
  }

  .tp-verdict [data-word='rushing'],
  .tp-verdict [data-word='dragging'] {
    color: var(--tp-red);
  }

  .tp[data-open] .tp-verdict {
    visibility: visible;
    animation: tp-slam 240ms cubic-bezier(0.2, 1.6, 0.4, 1);
  }

  @keyframes tp-slam {
    from {
      opacity: 0;
      transform: translateX(-50%) scale(1.5);
    }
  }

  /* Rotating: the game's own screen, with his patience running out on each step above it. The whole
     list stays on screen in the game's subtitle type, and the step showing is the lit one. */
  .tp-page :global(.steps-window) {
    border: 1px solid rgb(239 229 207 / 22%);
    border-radius: 2px;
    background: #000;
    color: var(--tp-smoke);
    font-family: var(--mono);
    font-style: normal;
  }

  .tp-page :global(.steps-window__bar) {
    gap: 0.75rem;
    justify-content: flex-end;
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .tp-page :global(.steps-window__bar i) {
    display: none;
  }

  .tp-page :global(.steps-window__bar span) {
    flex: none;
    margin: 0;
  }

  .tp-page :global(.steps-window__bar)::after {
    content: '';
    width: clamp(6rem, 20%, 12rem);
    height: 5px;
    background: var(--tp-amber);
    transform-origin: left;
  }

  .tp-page :global([data-counting] .steps-window__bar)::after {
    transform: scaleX(calc(1 - var(--progress)));
  }

  .tp-page :global([data-layout='rotating'] h3) {
    color: var(--tp-smoke);
    line-height: 1.08;
  }

  .tp-page :global([data-layout='rotating'] .step[data-current] h3) {
    color: var(--tp-cream);
  }

  .tp-page :global([data-layout='rotating'] .step__pick) {
    border-left: 3px solid rgb(239 229 207 / 16%);
    transition: border-color 200ms;
  }

  .tp-page :global([data-layout='rotating'] .step[data-current] .step__pick) {
    border-left-color: var(--tp-amber);
  }

  .tp-page :global(.step__number) {
    width: 1em;
    height: auto;
    margin-top: 0;
    font-family: var(--tp-display);
    font-size: 1.15em;
    font-style: normal;
    font-weight: 800;
  }

  @media (max-width: 760px) {
    .tp-page {
      --title: clamp(2.1rem, min(11vw, 6svh), 3.4rem);
      --steps-room: calc(100svh - 10rem - var(--title));
      --step-size: clamp(1rem, min(4.9vw, 2.6svh), 1.3rem);
      --bar-height: 1.75rem;
      --rail-size: clamp(1.05rem, min(5vw, 2.7svh), 1.4rem);
      --rail-rows: 0.2rem;
      --rail-pad: 0.35em 0.5em;
      gap: 0.6rem;
      padding: 3.25rem var(--gutter) 1rem;
    }

    h2 {
      font-size: var(--title);
    }

    .tp__head p {
      font-size: 1.05rem;
    }

    .tp__cta {
      padding: 0.55rem 0.7rem;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
    }
  }

  /* A short phone gives the tagline's room to the steps. */
  @media (max-width: 760px) and (max-height: 700px) and (orientation: portrait) {
    .tp__head p {
      display: none;
    }
  }

  @media (max-height: 560px) and (orientation: portrait) {
    .tp-page {
      --steps-room: calc(100svh - 8.5rem - var(--title));
      --bar-height: 1.1rem;
      --rail-size: 0.9rem;
      --rail-rows: 0;
      --rail-pad: 0.05em 0.4em;
      gap: 0.3rem;
      padding-top: 2.75rem;
    }
  }

  /* Phones on their side keep the name and the link on one line. */
  @media (max-height: 480px) and (orientation: landscape) {
    .tp-page {
      --steps-room: calc(100svh - 6.25rem);
      --step-size: 0.95rem;
      --bar-height: 1.3rem;
      --window: min(50vw, calc((var(--steps-room) - var(--bar-height)) * 1.6));
      --rail-size: 1rem;
      --rail-rows: 0.1rem;
      --rail-pad: 0.2em 0.45em;
      gap: 0.4rem;
      padding-top: 2.75rem;
      padding-bottom: 1rem;
    }

    h2 {
      font-size: 1.8rem;
    }

    .tp__head {
      align-items: center;
    }

    .tp__head p {
      display: none;
    }

    .tp__cta {
      padding: 0.3rem 0.6rem;
    }
  }

  /* On a wide screen the drum is lower and to the left. */
  @media (min-aspect-ratio: 1/1) {
    .tp-closed {
      --ring-left: 43%;
      --ring-top: 76%;
    }

    .tp-closed__room img {
      object-position: 50% 50%;
    }

    .tp-closed__name {
      font-size: clamp(3rem, min(9vw, 17svh), 8.5rem);
    }
  }

  /* Phones on their side: the name takes one line, over the ring. */
  @media (max-height: 480px) and (orientation: landscape) {
    .tp-closed {
      --ring-top: 72%;
    }

    .tp-closed__name {
      top: 2.5rem;
      font-size: 2.2rem;
    }

    .tp-closed__name span {
      display: inline;
    }

    .tp-closed__name span + span {
      margin-left: 0.28em;
    }
  }

  @media (prefers-reduced-motion: reduce), (scripting: none) {
    .tp {
      height: auto;
    }

    .tp-page {
      height: auto;
      min-height: 100svh;
    }
  }
</style>
