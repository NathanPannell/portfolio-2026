---
import StepsToggle from './StepsToggle.astro';

// How a section explains itself: numbered steps, each with its own real picture. As written here
// they are all on screen at once. `src/scripts/steps.ts` can move the pictures into one main window
// that rotates through them beside the list. A section sets `--steps-room`, the height these get,
// `--step-*` for its own colours, `--window` for the main window's width, and dresses the list and
// the window itself. Parkdex has its own stops on the vine, in the same format.
interface Step {
  title: string;
  alt: string;
  // Exported at `{image}-{width}.webp`, the widths in `sizes`.
  image?: string;
  video?: string;
  poster?: string;
}

interface Props {
  // What this set goes by in a review link: `?offbooked=rotating`.
  name: string;
  steps: Step[];
  shape: 'phone' | 'wide';
  // Which layout a visitor starts on.
  layout: 'side' | 'rotating';
  // Two by two on a big screen, for four wide pictures that would be small in a row.
  pairs?: boolean;
  // Gives the main window a browser's address bar, reading this.
  address?: string;
}

const { name, steps, shape, layout, pairs = false, address } = Astro.props;
const widths = shape === 'phone' ? [360, 640] : [480, 900];
---

<div
  class="steps-set"
  data-steps={name}
  data-layout-default={layout}
  data-opens
  style={`--count: ${steps.length}`}
>
  <ol class:list={['steps', `steps--${shape}`, { 'steps--pairs': pairs }]} data-steps-list>
    {steps.map(({ title, alt, image, video, poster }, index) => (
      <li class="step" data-step style={`--step: ${index}`}>
        <h3>
          <span class="step__number" aria-hidden="true">
            {index + 1}
          </span>
          <span>{title}</span>
        </h3>
        <figure class="step__picture">
          {video ? (
            <video
              data-src={video}
              poster={poster}
              width="1120"
              height="700"
              muted
              loop
              playsinline
              preload="none"
              aria-label={alt}
            />
          ) : (
            <img
              src={`${image}-${widths[0]}.webp`}
              srcset={widths.map((width) => `${image}-${width}.webp ${width}w`).join(', ')}
              sizes={
                shape === 'phone'
                  ? '(max-width: 760px) 60vw, 24vw'
                  : '(max-width: 760px) 92vw, 60vw'
              }
              width={shape === 'phone' ? 640 : 900}
              height={shape === 'phone' ? 1385 : 563}
              loading="lazy"
              decoding="async"
              alt={alt}
            />
          )}
        </figure>
      </li>
    ))}
  </ol>
  <div class={`steps-window steps-window--${shape}`} data-steps-window hidden>
    {address && (
      <div class="steps-window__bar" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
        <span>{address}</span>
      </div>
    )}
    <div class="steps-window__view" data-steps-view></div>
  </div>
  <StepsToggle />
</div>

<style>
  /* Side by side, the list is the section's own child. See the rotating layout below. */
  .steps-set {
    display: contents;
  }

  .steps {
    --gap: clamp(0.75rem, 2vw, 2rem);
    --size: var(--step-size, clamp(1.05rem, min(1.75vw, 3.1svh), 1.8rem));
    --title-room: calc(var(--step-lines, 3) * var(--size) * 1.12 + 0.75rem);
    --across: calc((100vw - var(--gutter) * 2 - var(--gap) * (var(--count) - 1)) / var(--count));
    display: grid;
    grid-template-rows: auto auto;
    grid-template-columns: repeat(var(--count), var(--shot));
    gap: 0 var(--gap);
    align-self: center;
    justify-content: center;
  }

  .steps--phone {
    --shot: min(var(--across), calc((var(--steps-room) - var(--title-room)) * 0.4624));
  }

  .steps--wide {
    --shot: min(var(--across), calc((var(--steps-room) - var(--title-room)) * 1.6));
  }

  /* The pictures line up across the row, however many lines each title takes. */
  .step {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    gap: 0.75rem;
    min-width: 0;
  }

  h3 {
    display: flex;
    gap: 0.5em;
    align-items: start;
    font-size: var(--size);
    font-weight: var(--step-weight, 800);
    line-height: 1.12;
    letter-spacing: var(--step-tracking, -0.02em);
  }

  .step__number {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    margin-top: -0.14em;
    border-radius: 50%;
    background: var(--step-number, currentColor);
    color: var(--step-number-ink, #fff);
    font-family: var(--mono);
    font-size: 0.8em;
    font-weight: 700;
    letter-spacing: 0;
  }

  .step__picture {
    overflow: hidden;
    border: var(--step-frame, 2px solid currentColor);
    border-radius: var(--step-corner, 0.6rem);
    background: var(--step-behind, none);
    box-shadow: var(--step-shadow, none);
    rotate: var(--step-tilt, 0deg);
    align-self: start;
  }

  .step:nth-child(even) .step__picture {
    rotate: calc(var(--step-tilt, 0deg) * -1);
  }

  .step__picture img,
  .step__picture video {
    display: block;
    width: 100%;
    height: auto;
  }

  /* In a scene, the steps follow it in one by one. */
  :global(.stage [data-moment]:not([data-open])) .step {
    opacity: 0;
    transform: translate3d(0, 1.75rem, 0);
  }

  :global([data-moment][data-open]) .step {
    --after: calc(var(--step-wait, 0ms) + var(--step) * 130ms);
    transition:
      opacity 320ms var(--after),
      transform 560ms var(--ease) var(--after);
  }

  @media (min-width: 761px) and (min-height: 481px) {
    .steps--pairs {
      --shot: min(
        calc((100vw - var(--gutter) * 2 - var(--gap)) / 2 * 0.54),
        calc((var(--steps-room) - var(--gap)) / 2 * 1.6)
      );
      grid-template-rows: none;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap);
    }

    .steps--pairs .step {
      grid-row: auto;
      grid-template-rows: none;
      grid-template-columns: minmax(0, 1fr) var(--shot);
      gap: clamp(0.75rem, 1.5vw, 1.5rem);
      align-items: center;
    }

    .steps--pairs .step__picture {
      grid-row: 1;
      grid-column: 2;
    }
  }

  /* Too narrow for pictures side by side at any size, so phones keep the words big and crop. */
  @media (max-width: 760px) {
    .steps--phone {
      grid-template-rows: repeat(2, auto minmax(0, 1fr));
      grid-template-columns: repeat(2, minmax(0, 1fr));
      height: var(--steps-room);
    }

    .steps--phone .step {
      grid-row: span 2;
      gap: 0.4rem;
      padding-bottom: 0.6rem;
    }

    .steps--phone .step__picture {
      min-height: 0;
      align-self: stretch;
    }

    .steps--phone img {
      height: 100%;
      object-fit: cover;
      object-position: top;
    }

    .steps--wide {
      grid-template-rows: repeat(var(--count), minmax(min-content, 1fr));
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
      height: var(--steps-room);
    }

    .steps--wide .step {
      grid-row: auto;
      grid-template-rows: none;
      grid-template-columns: minmax(0, 1fr) min(
          42%,
          calc((var(--steps-room) / var(--count) - 0.6rem) * 1.6)
        );
      align-items: center;
    }

    .steps--wide .step__picture {
      align-self: center;
    }
  }

  /* Short and wide, app screens stay across and crop to what the height leaves. */
  @media (min-width: 761px) and (max-height: 560px),
    (max-height: 480px) and (orientation: landscape) {
    .steps--phone {
      grid-template-rows: auto minmax(0, 1fr);
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
      gap: 0 0.75rem;
      height: var(--steps-room);
    }

    .steps--phone .step {
      grid-row: span 2;
      grid-template-rows: subgrid;
      gap: 0.3rem;
      padding-bottom: 0;
    }

    .steps--phone .step__picture {
      min-height: 0;
      align-self: stretch;
    }

    .steps--phone img {
      height: 100%;
      object-fit: cover;
      object-position: top;
    }
  }

  /* Phones on their side: wide pictures go across too, as big as the height leaves them. */
  @media (max-height: 480px) and (orientation: landscape) {
    .steps--wide {
      grid-template-rows: auto auto;
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
      gap: 0 0.75rem;
      height: auto;
    }

    .steps--wide .step {
      grid-row: span 2;
      grid-template-rows: subgrid;
      grid-template-columns: none;
      gap: 0.3rem;
      align-items: stretch;
    }

    .steps--wide .step__picture {
      align-self: start;
      width: min(100%, calc((var(--steps-room) - var(--title-room)) * 1.6));
    }
  }

  /* The rotating layout: every step in a list, and one picture at a time beside it. `--progress`
     runs from 0 to 1 over each step, for a section to draw how long is left. */
  .steps-set[data-layout='rotating'] {
    display: grid;
    grid-template-columns: var(--rail-columns, minmax(0, 1fr) var(--window));
    gap: var(--rail-gap, clamp(1.25rem, 3.5vw, 3.5rem));
    align-items: center;
    height: var(--steps-room);
  }

  [data-layout='rotating'] > .steps {
    display: flex;
    flex-direction: column;
    gap: var(--rail-rows, 0.4rem);
    justify-content: center;
    height: auto;
  }

  [data-layout='rotating'] .step {
    display: block;
    padding: 0;
  }

  [data-layout='rotating'] h3 {
    display: block;
    font-size: var(--rail-size, var(--size));
  }

  h3 :global(.step__pick) {
    display: flex;
    gap: var(--rail-number-gap, 0.6em);
    align-items: center;
    width: 100%;
    padding: var(--rail-pad, 0.55em 0.65em);
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: start;
    cursor: pointer;
  }

  .steps-window {
    position: relative;
    width: var(--window);
  }

  .steps-window[hidden] {
    display: none;
  }

  .steps-window__bar {
    position: relative;
    display: flex;
    gap: 0.35rem;
    align-items: center;
    height: var(--bar-height, 2.5rem);
    padding-inline: 0.8rem;
    font-size: 0.8rem;
    line-height: 1;
  }

  .steps-window__bar i {
    flex: none;
    width: 0.65em;
    height: 0.65em;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.55;
  }

  .steps-window__bar span {
    flex: 1;
    margin-left: 0.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .steps-window__view {
    display: grid;
    overflow: hidden;
  }

  .steps-window__view .step__picture {
    grid-area: 1 / 1;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    opacity: 0;
    rotate: none;
    visibility: hidden;
    transition:
      opacity 320ms,
      visibility 0s 320ms;
  }

  .steps-window__view .step__picture[data-current] {
    opacity: 1;
    visibility: visible;
    transition: opacity 320ms;
  }

  :global(.stage [data-moment]:not([data-open])) .steps-window {
    opacity: 0;
    transform: translate3d(0, 1.75rem, 0);
  }

  :global([data-moment][data-open]) .steps-window {
    transition:
      opacity 320ms var(--step-wait, 0ms),
      transform 560ms var(--ease) var(--step-wait, 0ms);
  }

  /* On an upright phone, wide pictures go above the list, at most about half the height. */
  @media (max-width: 760px) and (orientation: portrait) {
    .steps-set[data-layout='rotating']:has(.steps-window--wide) {
      --window: min(100%, calc((var(--steps-room) * 0.46 - var(--bar-height, 2.5rem)) * 1.6));
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(0.6rem, 2.5svh, 1.5rem);
      align-content: center;
      justify-items: center;
    }

    [data-layout='rotating'] .steps-window--wide {
      order: -1;
    }

    [data-layout='rotating']:has(.steps-window--wide) > .steps {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce), (scripting: none) {
    .step,
    .steps-window,
    .steps-window__view .step__picture,
    .steps-window__view .step__picture[data-current] {
      transition: none;
    }
  }
</style>
