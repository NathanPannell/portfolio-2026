---
import '@fontsource/chewy/latin-400.css';
import '@fontsource/gaegu/latin-400.css';
import '@fontsource/gaegu/latin-700.css';
import Steps from './Steps.astro';

const crayons = ['#e2231a', '#f28b1e', '#f3cf1c', '#2fa84f', '#1f7fd6', '#8a4fd3'];

const steps = [
  {
    title: 'Sandbox is hosting an event for creatives.',
    image: '/media/sandbox/event',
    alt: 'The Play by the Sandbox site: who’s in the sandbox, counted on a sheet of graph paper',
  },
  {
    title: 'They needed an eye-catching website in a child-like crayon style.',
    image: '/media/sandbox/crayon',
    alt: 'The Play by the Sandbox site’s crayon map of the Vancouver Art Gallery',
  },
  {
    title: 'I created a 3D landing page with interactive elements and fun visuals.',
    video: '/media/sandbox/site-loop.mp4',
    poster: '/media/sandbox/site-800.webp',
    alt: 'The Play by the Sandbox homepage: a 3D Vancouver Art Gallery drawn in crayon, with a marquee sign',
  },
];
---

<section id="play-by-the-sandbox" class="sb" data-loops aria-labelledby="sb-title">
  <div class="sb-open" data-frame data-moment data-toy-box tabindex="-1">
    <div class="sb-open__page">
      <header class="sb__head">
        <h2 id="sb-title">Play by the Sandbox</h2>
        <a class="sb__cta" href="https://www.playbythesandbox.ca/" data-opens>
          I wanna play <span aria-hidden="true">→</span>
        </a>
      </header>
      <Steps
        name="sandbox"
        steps={steps}
        shape="wide"
        layout="side"
        address="playbythesandbox.ca"
      />
    </div>

    <div class="sb-box">
      <p class="sb-box__name">Play by the Sandbox</p>
      <button
        class="sb-box__open"
        type="button"
        data-moment-control
        aria-expanded="false"
        aria-label="Open the toy box"
      >
        <svg viewBox="0 0 400 330" aria-hidden="true">
          <g class="sb-box__crayons">
            {crayons.map((colour, index) => (
              <path
                d={`M${82 + index * 44} 190v-70l14-30 14 30v70z`}
                fill={colour}
                style={`--row: ${index}`}
              />
            ))}
          </g>
          <path
            class="sb-box__wall"
            d="M40 140h320l-16 176a10 10 0 0 1-10 9H66a10 10 0 0 1-10-9z"
          />
          <path class="sb-box__plank" d="M46 200h308M51 262h298" />
          <path
            class="sb-box__star"
            d="m200 172 16 34 37 5-27 26 7 37-33-18-33 18 7-37-27-26 37-5z"
          />
          <g class="sb-box__lid">
            <path d="M26 92h348a10 10 0 0 1 10 10v30a10 10 0 0 1-10 10H26a10 10 0 0 1-10-10v-30a10 10 0 0 1 10-10z" />
            <path class="sb-box__latch" d="M182 124h36v42a18 18 0 0 1-36 0z" />
          </g>
        </svg>
        <span class="sb-box__tag" aria-hidden="true">
          open me!
        </span>
      </button>
    </div>

    <div class="wipe" aria-hidden="true">
      {crayons.map((colour, index) => (
        <div class="wipe__band" style={`--band: ${colour}; --row: ${index}`}>
          <svg class="wipe__edge" viewBox="0 0 120 100" preserveAspectRatio="none">
            <path d="M0 0H52L88 8 60 17l48 9-42 9 54 11-50 10 44 10-52 9 46 9-44 8H0z" />
          </svg>
          <svg class="wipe__edge wipe__edge--tail" viewBox="0 0 120 100" preserveAspectRatio="none">
            <path d="M0 0H52L88 8 60 17l48 9-42 9 54 11-50 10 44 10-52 9 46 9-44 8H0z" />
          </svg>
          <svg class="wipe__crayon" viewBox="0 0 200 60">
            <path class="wipe__wax" d="M0 8h150l50 22-50 22H0z" />
            <path class="wipe__label" d="M24 8h96v44H24z" />
          </svg>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .sb {
    --sb-paper: #fff7ec;
    --sb-grid:
      linear-gradient(rgb(46 42 69 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(46 42 69 / 5%) 1px, transparent 1px);
    --sb-grid-size: 2rem 2rem;
    --sand: #f0cf8e;
    --bar: calc(100lvh - 100svh);
    --ink: #2e2a45;
    position: relative;
    overflow: clip;
    background: var(--sb-paper);
    background-image: var(--sb-grid);
    background-size: var(--sb-grid-size);
    color: var(--ink);
    font-family: 'Gaegu', 'Comic Sans MS', cursive;
    font-size: 1.3rem;
    line-height: 1.35;
  }

  /* The sand carries on below the page, under a phone's address bar. */
  .sb-open {
    position: relative;
    height: 100lvh;
    overflow: clip;
    background: var(--sand);
  }

  .sb-open:focus {
    outline: none;
  }

  .sb-open__page {
    --steps-room: calc(100svh - 12.5rem);
    --step-size: clamp(1.15rem, min(2.05vw, 3.6svh), 2.2rem);
    --step-lines: 3;
    --step-number: #6d3fb0;
    --step-number-ink: #fffdf8;
    --step-frame: 3px solid var(--ink);
    --step-corner: 0.5rem 0.9rem 0.6rem 1rem;
    --step-behind: #fffdf8;
    --step-shadow: 0.4rem 0.45rem 0 rgb(46 42 69 / 22%);
    --step-tilt: 1deg;
    --step-weight: 700;
    --step-tracking: 0;
    --step-wait: 1100ms;
    --bar-height: 2.4rem;
    --window: min(58vw, calc((var(--steps-room) - var(--bar-height)) * 1.6));
    --rail-size: clamp(1.2rem, min(2vw, 3.5svh), 2rem);
    --rail-rows: 0.75rem;
    --rail-columns: var(--window) minmax(0, 34rem);
    position: relative;
    display: grid;
    grid-template-rows: auto auto;
    gap: clamp(1rem, 4svh, 3rem);
    align-content: center;
    height: 100svh;
    overflow: hidden;
    padding: 4rem var(--gutter) 3.75rem;
    background:
      linear-gradient(transparent calc(100% - 3.5rem), var(--sand) calc(100% - 3.5rem)),
      var(--sb-paper);
    background-image:
      linear-gradient(transparent calc(100% - 3.5rem), var(--sand) calc(100% - 3.5rem)),
      var(--sb-grid);
    background-size: auto, var(--sb-grid-size), var(--sb-grid-size);
  }

  /* The toy box sits on its own paper, over the page it opens onto. */
  .sb-box {
    position: absolute;
    z-index: 4;
    inset: 0;
    display: none;
    align-content: center;
    justify-items: center;
    gap: clamp(1rem, 3svh, 2rem);
    padding: 3.5rem var(--gutter) calc(1rem + var(--bar));
    background: var(--sb-paper);
    background-image: var(--sb-grid);
    background-size: var(--sb-grid-size);
  }

  :global(.stage) .sb-open:not([data-open]) .sb-box {
    display: grid;
  }

  /* Gone while the rainbow covers the screen, so the wipe is what changes the page. */
  .sb-open[data-open] .sb-box {
    display: grid;
    pointer-events: none;
    animation: cleared 1100ms steps(1, end) forwards;
  }

  @keyframes cleared {
    to {
      visibility: hidden;
    }
  }

  .sb-box__name {
    color: #a0521d;
    font-family: 'Chewy', 'Comic Sans MS', cursive;
    font-size: clamp(2.6rem, min(7vw, 11svh), 5.5rem);
    line-height: 1;
    text-align: center;
    text-shadow: 0.05em 0.05em 0 rgb(160 82 29 / 22%);
  }

  .sb-box__open {
    position: relative;
    width: min(78vw, 56svh, 32rem);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
  }

  .sb-box__open svg {
    width: 100%;
    overflow: visible;
    stroke: var(--ink);
    stroke-width: 6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .sb-box__wall {
    fill: #e8a24c;
  }

  .sb-box__plank {
    fill: none;
    stroke-width: 4;
    opacity: 0.45;
  }

  .sb-box__star {
    fill: #f7e29a;
  }

  .sb-box__lid {
    fill: #c9772f;
    transform-box: view-box;
    transform-origin: 16px 142px;
  }

  .sb-box__latch {
    fill: #f7c948;
  }

  .sb-box__crayons path {
    transform: translateY(70px);
  }

  /* Something in there wants out. */
  :global(.stage) .sb-open[data-here]:not([data-open]) .sb-box__lid {
    animation: rattle 2.8s ease-in-out infinite;
  }

  @keyframes rattle {
    0%,
    68%,
    100% {
      transform: none;
    }

    72% {
      transform: rotate(3deg);
    }

    77% {
      transform: rotate(-0.5deg);
    }

    82% {
      transform: rotate(2deg);
    }

    88% {
      transform: none;
    }
  }

  .sb-open[data-open] .sb-box__lid {
    transform: rotate(-64deg) translate(0, -6px);
    transition: transform 380ms cubic-bezier(0.2, 1.4, 0.4, 1);
  }

  .sb-open[data-open] .sb-box__crayons path {
    transform: translateY(-64px);
    transition: transform 380ms cubic-bezier(0.2, 1.5, 0.4, 1) calc(var(--row) * 24ms);
  }

  .sb-box__tag {
    position: absolute;
    top: 0;
    left: 50%;
    color: #6d3fb0;
    font-family: 'Chewy', cursive;
    font-size: clamp(2.2rem, min(7vw, 9svh), 3.6rem);
    line-height: 1;
    white-space: nowrap;
    transform: translateX(-50%) rotate(-3deg);
  }

  .sb-open[data-open] .sb-box__tag {
    opacity: 0;
  }

  /* The rainbow pours out of the box and straight across the screen, then off the far side, in
     transforms alone. It always plays whole, whatever the scroll is doing. */
  .wipe {
    position: absolute;
    z-index: 5;
    inset: 0;
    overflow: clip;
    visibility: hidden;
    pointer-events: none;
  }

  .sb-open[data-open] .wipe {
    animation: rainbow 2100ms steps(1, end) forwards;
  }

  @keyframes rainbow {
    from {
      visibility: visible;
    }

    to {
      visibility: hidden;
    }
  }

  .wipe__band {
    --way: -1;
    position: absolute;
    top: calc(var(--row) * 100% / 6 - 1%);
    left: -1%;
    width: 102%;
    height: calc(100% / 6 + 3%);
    background:
      repeating-linear-gradient(97deg, rgb(255 255 255 / 9%) 0 0.35rem, transparent 0.35rem 0.9rem),
      var(--band);
    transform: translate3d(calc(var(--way) * (100% + 34vmin)), 0, 0);
    will-change: transform;
  }

  .wipe__band:nth-child(even) {
    --way: 1;
  }

  .sb-open[data-open] .wipe__band {
    animation: sweep 1700ms cubic-bezier(0.45, 0, 0.55, 1) calc(var(--row) * 70ms + 150ms) both;
  }

  @keyframes sweep {
    from {
      transform: translate3d(calc(var(--way) * (100% + 34vmin)), 0, 0);
    }

    42%,
    58% {
      transform: none;
    }

    to {
      transform: translate3d(calc(var(--way) * -1 * (100% + 34vmin)), 0, 0);
    }
  }

  .wipe__edge,
  .wipe__crayon {
    position: absolute;
    max-width: none;
  }

  .wipe__edge {
    top: 0;
    left: calc(100% - 1px);
    width: 14vmin;
    height: 100%;
    fill: var(--band);
  }

  /* The same torn edge on the back of the band, for the way out. */
  .wipe__edge--tail {
    right: calc(100% - 1px);
    left: auto;
    scale: -1 1;
  }

  .wipe__crayon {
    top: 50%;
    left: calc(100% + 10vmin);
    width: 20vmin;
    height: 6vmin;
    translate: 0 -50%;
    rotate: 6deg;
  }

  .wipe__wax {
    fill: var(--band);
    stroke: #2e2a45;
    stroke-width: 4;
    stroke-linejoin: round;
  }

  .wipe__label {
    fill: rgb(255 255 255 / 30%);
    stroke: #2e2a45;
    stroke-width: 3;
  }

  /* Bands that come in from the right run the other way. */
  .wipe__band:nth-child(even) .wipe__edge {
    right: calc(100% - 1px);
    left: auto;
    scale: -1 1;
  }

  .wipe__band:nth-child(even) .wipe__edge--tail {
    right: auto;
    left: calc(100% - 1px);
    scale: 1 1;
  }

  .wipe__band:nth-child(even) .wipe__crayon {
    right: calc(100% + 10vmin);
    left: auto;
    scale: -1 1;
  }

  /* Rotating: a browser drawn in crayon, and a sticker on whichever step is showing. A crayon runs
     under it for as long as the step has left, and each new picture is coloured in from the left. */
  .sb-open__page :global(.steps-set[data-layout='rotating']) {
    justify-content: center;
  }

  .sb-open__page :global(.steps-window) {
    order: -1;
    overflow: hidden;
    border: var(--step-frame);
    border-radius: 0.5rem 0.9rem 0.6rem 1rem;
    background: var(--step-behind);
    box-shadow: 0.5rem 0.55rem 0 rgb(46 42 69 / 22%);
    font-weight: 700;
    rotate: -0.6deg;
  }

  .sb-open__page :global(.steps-window__bar) {
    border-bottom: 3px solid var(--ink);
    font-size: 1.05rem;
  }

  .sb-open__page :global(.steps-window__bar i) {
    border: 2px solid var(--ink);
    background: #e2231a;
    opacity: 1;
  }

  .sb-open__page :global(.steps-window__bar i:nth-child(2)) {
    background: #f3cf1c;
  }

  .sb-open__page :global(.steps-window__bar i:nth-child(3)) {
    background: #2fa84f;
  }

  .sb-open__page :global(.steps-window__view .step__picture[data-current]) {
    animation: colour-in 480ms cubic-bezier(0.4, 0, 0.3, 1);
  }

  @keyframes colour-in {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0);
    }
  }

  .sb-open__page :global([data-layout='rotating'] h3) {
    border: 3px solid transparent;
    border-radius: 0.5rem 0.9rem 0.6rem 1rem;
  }

  .sb-open__page :global([data-layout='rotating'] .step[data-current]) {
    rotate: -0.5deg;
  }

  .sb-open__page :global([data-layout='rotating'] .step[data-current] h3) {
    border-color: var(--ink);
    background: #f7e29a;
    box-shadow: 0.25rem 0.3rem 0 var(--ink);
  }

  .sb-open__page :global(.step__pick) {
    background: linear-gradient(90deg, #6d3fb0, #1f7fd6) 0 100% / 0 0.3rem no-repeat;
  }

  .sb-open__page :global([data-current] .step__pick) {
    background-size: calc(var(--progress) * 100%) 0.3rem;
  }

  .sb__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: space-between;
  }

  h2 {
    color: #a0521d;
    font-family: 'Chewy', 'Comic Sans MS', cursive;
    font-size: clamp(2.2rem, min(5.4vw, 10svh), 5.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.01em;
    text-shadow: 0.05em 0.05em 0 rgb(160 82 29 / 22%);
  }

  .sb__cta {
    position: relative;
    z-index: 3;
    padding: 0.55rem 1.3rem;
    border: 3px solid var(--ink);
    background: #f7e29a;
    box-shadow: 0.25rem 0.3rem 0 var(--ink);
    font-size: 1.5rem;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
    transform: rotate(-2deg);
    transition: transform 160ms var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .sb__cta:hover {
      transform: rotate(1deg) scale(1.05);
    }
  }

  @media (max-width: 760px) {
    .sb-open__page {
      --title: clamp(2rem, min(9.5vw, 5.4svh), 3.2rem);
      --steps-room: calc(100svh - 10.5rem - var(--title));
      --step-size: clamp(0.85rem, min(4.7vw, 2.6svh), 1.25rem);
      --bar-height: 2rem;
      --rail-size: var(--step-size);
      --rail-rows: 0.3rem;
      gap: 0.75rem;
      padding: 3.25rem var(--gutter) 3.25rem;
    }

    h2 {
      font-size: var(--title);
    }

    .sb__cta {
      font-size: 1.2rem;
      padding: 0.3rem 0.9rem;
    }
  }

  @media (max-height: 560px) and (orientation: portrait) {
    .sb-open__page {
      --bar-height: 1.3rem;
      --rail-size: 0.8rem;
      --rail-rows: 0;
      --rail-pad: 0.05em 0.4em;
    }

    .sb-open__page :global([data-layout='rotating'] .step[data-current]) {
      rotate: none;
    }
  }

  /* Phones on their side keep the name and the link on one line. */
  @media (max-height: 480px) and (orientation: landscape) {
    .sb-open__page {
      --steps-room: calc(100svh - 7.5rem);
      --step-size: 0.95rem;
      --bar-height: 1.5rem;
      --window: min(50vw, calc((var(--steps-room) - var(--bar-height)) * 1.6));
      --rail-rows: 0.2rem;
      --rail-pad: 0.2em 0.45em;
      gap: 0.4rem;
      padding-top: 2.75rem;
      padding-bottom: 2rem;
    }

    h2 {
      font-size: 1.7rem;
    }

    .sb__head {
      flex-wrap: nowrap;
    }

    .sb-open__page :global(.steps-window),
    .sb-open__page :global([data-layout='rotating'] .step[data-current]) {
      rotate: none;
    }

    .sb__cta {
      font-size: 1rem;
      padding: 0.15rem 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce), (scripting: none) {
    .sb-open__page :global(.steps-window__view .step__picture[data-current]) {
      animation: none;
    }

    .sb-open {
      height: auto;
    }

    .sb-open__page {
      height: auto;
      min-height: 100svh;
    }
  }
</style>
