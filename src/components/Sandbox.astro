---
import '@fontsource/chewy/latin-400.css';
import '@fontsource/gaegu/latin-400.css';
import '@fontsource/gaegu/latin-700.css';

const crayons = ['#e2231a', '#f28b1e', '#f3cf1c', '#2fa84f', '#1f7fd6', '#8a4fd3'];
const panels = [
  { name: 'team', width: 900, height: 1138, alt: 'Comic panel: a director and a brand high-five' },
  { name: 'make', width: 900, height: 1071, alt: 'Comic panel: filming an ad on set' },
  { name: 'show', width: 900, height: 1167, alt: 'Comic panel: a crowd watching a big screen' },
];
---

<div class="wipe" data-track data-wipe aria-hidden="true">
  <div class="wipe__stage" data-stage>
    {crayons.map((colour, index) => (
      <div class="wipe__band" data-band style={`--band: ${colour}; --row: ${index}`}>
        <svg class="wipe__edge" viewBox="0 0 120 100" preserveAspectRatio="none">
          <path d="M0 0H52L88 8 60 17l48 9-42 9 54 11-50 10 44 10-52 9 46 9-44 8H0z" />
        </svg>
        <svg class="wipe__crayon" viewBox="0 0 200 60">
          <path class="wipe__wax" d="M0 8h150l50 22-50 22H0z" />
          <path class="wipe__label" d="M24 8h96v44H24z" />
        </svg>
      </div>
    ))}
    <div class="wipe__paper" data-paper></div>
  </div>
</div>

<section
  id="play-by-the-sandbox"
  class="sb"
  data-audience="creators"
  data-loops
  aria-labelledby="sb-title"
>
  <header class="sb__head">
    <img
      class="sb__word"
      src="/media/sandbox/wordmark-800.webp"
      srcset="/media/sandbox/wordmark-480.webp 480w, /media/sandbox/wordmark-800.webp 800w"
      sizes="(max-width: 700px) 86vw, 34rem"
      width="800"
      height="225"
      loading="lazy"
      decoding="async"
      alt="Play by the Sandbox, January 2027, Vancouver Art Gallery"
    />
    <h2 id="sb-title">I made an ad showdown look like a toy box.</h2>
    <p class="sb__lede">
      Mello’s event at the Vancouver Art Gallery. I designed and built the site.
    </p>
  </header>

  <figure class="sb__screen" data-reveal style="--reveal-turn: -3deg">
    <span class="sb__tape sb__tape--left" aria-hidden="true"></span>
    <span class="sb__tape sb__tape--right" aria-hidden="true"></span>
    <video
      data-src="/media/sandbox/site-loop.mp4"
      poster="/media/sandbox/site-800.webp"
      width="1120"
      height="700"
      muted
      loop
      playsinline
      preload="none"
      aria-label="The Play by the Sandbox homepage: a pixel-art Vancouver Art Gallery with a marquee sign"
    ></video>
    <span class="sb__bubble" aria-hidden="true">
      premiere night!
    </span>
  </figure>

  <div class="sb__strip">
    {panels.map(({ name, width, height, alt }, index) => (
      <img
        data-reveal
        style={`--reveal-delay: ${index * 90}ms; --reveal-turn: ${index * 2 - 2}deg`}
        src={`/media/sandbox/panel-${name}-480.webp`}
        srcset={`/media/sandbox/panel-${name}-480.webp 480w, /media/sandbox/panel-${name}-900.webp 900w`}
        sizes="(max-width: 700px) 82vw, 30vw"
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        alt={alt}
      />
    ))}
  </div>

  <div class="sb__yard" data-yard>
    <p class="sb__yard-title">grab a toy</p>

    <div class="toy" data-toy>
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <path d="M18 34h64l-9 58H27z" fill="#f4b6c6"></path>
        <path d="M18 34h64l-9 58H27zM26 34C28 4 72 4 74 34" fill="none"></path>
        <path d="m50 50 5 11 12 1-9 8 3 12-11-6-11 6 3-12-9-8 12-1z" fill="#f7e29a"></path>
      </svg>
      <span class="sr-only">Bucket</span>
    </div>
    <div class="toy" data-toy>
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="42" fill="#b9d6f2"></circle>
        <path
          d="M8 50c14-14 70-14 84 0M50 8c-16 22-16 62 0 84M50 8c16 22 16 62 0 84"
          fill="none"
        ></path>
        <circle cx="50" cy="50" r="42" fill="none"></circle>
      </svg>
      <span class="sr-only">Beach ball</span>
    </div>
    <div class="toy" data-toy>
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <path d="M44 8h12v46H44z" fill="#d7b7f0"></path>
        <path d="M28 54h44l-6 26c-3 12-29 12-32 0z" fill="#bfe6c8"></path>
      </svg>
      <span class="sr-only">Spade</span>
    </div>
    <div class="toy" data-toy>
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <path
          d="M22 62c0-22 16-26 26-26 4-22 34-18 30 4-2 8-8 10-8 10 16 2 26-2 28-6 4 26-22 42-46 42S22 78 22 62z"
          fill="#f7e29a"
        ></path>
        <circle cx="66" cy="28" r="3.5" fill="#2e2a45"></circle>
        <path d="M78 34l14 2-13 7" fill="#f28b1e"></path>
      </svg>
      <span class="sr-only">Rubber duck</span>
    </div>
    <div class="toy" data-toy>
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <path d="m50 6 13 28 31 4-23 21 6 31-27-15-27 15 6-31L6 38l31-4z" fill="#f3b48a"></path>
      </svg>
      <span class="sr-only">Star</span>
    </div>
    <a class="sb__cta" href="https://www.playbythesandbox.ca/">
      I wanna play <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .wipe,
  .sb {
    --sb-paper: #fff7ec;
    --sb-grid:
      linear-gradient(rgb(46 42 69 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(46 42 69 / 5%) 1px, transparent 1px);
    --sb-grid-size: 2rem 2rem;
  }

  /* Its own pinned stage, starting on Parkdex's ground colour and ending on Sandbox's paper, so it
     looks the same at any scroll speed and nothing from either world can show through. */
  .wipe {
    position: relative;
    z-index: 2;
    height: 260lvh;
    background: var(--sb-paper);
  }

  .wipe__stage {
    position: sticky;
    top: 0;
    height: 100lvh;
    overflow: clip;
    background: #16452f;
  }

  .wipe__band {
    position: absolute;
    top: calc(var(--row) * 100% / 6 - 1%);
    left: -1%;
    width: 102%;
    height: calc(100% / 6 + 3%);
    background:
      repeating-linear-gradient(97deg, rgb(255 255 255 / 9%) 0 0.35rem, transparent 0.35rem 0.9rem),
      var(--band);
    will-change: transform;
  }

  .wipe__edge,
  .wipe__crayon {
    position: absolute;
    max-width: none;
  }

  .wipe__edge {
    top: 0;
    left: calc(100% - 1px);
    width: 14vmin;
    height: 100%;
    fill: var(--band);
  }

  .wipe__crayon {
    top: 50%;
    left: calc(100% + 10vmin);
    width: 20vmin;
    height: 6vmin;
    translate: 0 -50%;
    rotate: 6deg;
  }

  .wipe__wax {
    fill: var(--band);
    stroke: #2e2a45;
    stroke-width: 4;
    stroke-linejoin: round;
  }

  .wipe__label {
    fill: rgb(255 255 255 / 30%);
    stroke: #2e2a45;
    stroke-width: 3;
  }

  /* Bands that come in from the right run the other way. */
  .wipe__band:nth-child(even) .wipe__edge {
    right: calc(100% - 1px);
    left: auto;
    scale: -1 1;
  }

  .wipe__band:nth-child(even) .wipe__crayon {
    right: calc(100% + 10vmin);
    left: auto;
    scale: -1 1;
  }

  .wipe__paper {
    position: absolute;
    inset: 0;
    background: var(--sb-paper);
    background-image: var(--sb-grid);
    background-size: var(--sb-grid-size);
    will-change: transform;
  }

  .sb {
    --ink: #2e2a45;
    position: relative;
    z-index: 2;
    overflow: clip;
    background: var(--sb-paper);
    background-image: var(--sb-grid);
    background-size: var(--sb-grid-size);
    color: var(--ink);
    font-family: 'Gaegu', 'Comic Sans MS', cursive;
    font-size: 1.3rem;
    line-height: 1.35;
  }

  .sb__head {
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 62rem;
    margin: 0 auto;
    padding: clamp(6rem, 13vw, 10rem) var(--gutter) 2.5rem;
    text-align: center;
  }

  .sb__word {
    width: min(100%, 34rem);
    rotate: -1.5deg;
    border-radius: 1.2rem;
  }

  h2 {
    color: #a0521d;
    font-family: 'Chewy', 'Comic Sans MS', cursive;
    font-size: clamp(2.8rem, 7.4vw, 6.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.01em;
    text-shadow: 0.05em 0.05em 0 rgb(160 82 29 / 22%);
    text-wrap: balance;
  }

  .sb__lede {
    max-width: 42ch;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
  }

  .sb__screen {
    position: relative;
    width: min(calc(100% - var(--gutter) * 2), 66rem);
    margin: 1.5rem auto 3.5rem;
    padding: clamp(0.5rem, 1.2vw, 0.85rem);
    border: 3px solid var(--ink);
    border-radius: 0.5rem 0.9rem 0.6rem 1rem;
    background: #fffdf8;
    box-shadow: 0.55rem 0.6rem 0 rgb(46 42 69 / 22%);
    rotate: -1.4deg;
  }

  .sb__screen video {
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    background: #cdb7d9;
  }

  .sb__tape {
    position: absolute;
    z-index: 1;
    top: -0.8rem;
    width: 7rem;
    height: 1.7rem;
    background: rgb(247 226 154 / 85%);
  }

  .sb__tape--left {
    left: 8%;
    rotate: -6deg;
  }

  .sb__tape--right {
    right: 8%;
    rotate: 5deg;
  }

  .sb__bubble {
    position: absolute;
    right: 5%;
    bottom: -1.1rem;
    padding: 0.35rem 0.9rem;
    border: 3px solid var(--ink);
    border-radius: 1.1rem;
    background: #fffdf8;
    font-weight: 700;
    rotate: 3deg;
    animation: bob 2.6s ease-in-out infinite;
  }

  @keyframes bob {
    50% {
      translate: 0 -0.45rem;
    }
  }

  .sb__strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.75rem);
    align-items: center;
    max-width: 82rem;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 5.5rem) var(--gutter) 1rem;
  }

  .sb__strip img:nth-child(1) {
    rotate: -1.5deg;
  }

  .sb__strip img:nth-child(2) {
    translate: 0 1.25rem;
    rotate: 1deg;
  }

  .sb__strip img:nth-child(3) {
    rotate: -0.75deg;
  }

  .sb__yard {
    position: relative;
    height: clamp(26rem, 64svh, 36rem);
    margin-top: 2rem;
    overflow: hidden;
    background: linear-gradient(transparent calc(100% - 3.5rem), #f0cf8e calc(100% - 3.5rem));
  }

  .sb__yard-title {
    position: absolute;
    top: 8%;
    width: 100%;
    color: #6d3fb0;
    font-family: 'Chewy', cursive;
    font-size: clamp(3rem, 9vw, 6.5rem);
    line-height: 1;
    text-align: center;
  }

  .toy {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: clamp(4.5rem, 10vw, 7.5rem);
    height: clamp(4.5rem, 10vw, 7.5rem);
    cursor: grab;
    touch-action: none;
    user-select: none;
    will-change: transform;
  }

  .toy:active {
    cursor: grabbing;
  }

  .toy svg {
    width: 100%;
    height: 100%;
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linejoin: round;
    stroke-linecap: round;
    pointer-events: none;
  }

  .sb__cta {
    position: absolute;
    z-index: 1;
    top: 46%;
    left: 50%;
    padding: 0.7rem 1.5rem;
    border: 3px solid var(--ink);
    background: #f7e29a;
    box-shadow: 0.25rem 0.3rem 0 var(--ink);
    font-size: 1.6rem;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
    transform: translateX(-50%) rotate(-2deg);
    transition: transform 160ms var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .sb__cta:hover {
      transform: translateX(-50%) rotate(1deg) scale(1.05);
    }
  }

  @media (max-width: 760px) {
    .sb__strip {
      grid-template-columns: minmax(0, 1fr);
      max-width: 28rem;
    }

    .sb__strip img:nth-child(2) {
      translate: none;
    }
  }

  @media (scripting: none) {
    .toy {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce), (scripting: none) {
    .wipe,
    .sb__yard-title {
      display: none;
    }

    .sb__bubble {
      animation: none;
    }
  }
</style>
