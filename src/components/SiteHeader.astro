---
interface Props {
  tone?: 'light' | 'dark';
  overlay?: boolean;
}

const { tone = 'dark', overlay = false } = Astro.props;
---

<header class:list={['site-header', `site-header--${tone}`, { 'site-header--overlay': overlay }]}> 
  <a class="site-header__name" href="/" aria-label="Nathan Pannell, home">Nathan Pannell</a>
  <nav class="site-header__nav" aria-label="Primary navigation">
    <a href="/#parkdex">Parkdex</a>
    <a href="/#projects">Projects</a>
    <a href="/writing/">Writing</a>
    <a class="site-header__contact" href="mailto:contact@nathanpannell.com">
      <span>Email me</span>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" /></svg>
    </a>
  </nav>
</header>
