---
import SitePage from './SitePage.astro';
import Steps from './Steps.astro';
import page from './build-night-page.json';

// The site's own four steps, word for word. Each one stops on the part of the page that fits it. The
// window is a capture of the page, not the live site: Shopify doesn't let it be framed. See
// `scripts/capture-build-night.mjs`. The Night 001 photos and the organisers' portraits are blurred
// there until attendee permission clears, and no stop rests on them.
const titles = [
  'Meet the people building here.',
  'Try the thing you keep reading about.',
  'Show the room what you made.',
  'Keep building after you leave.',
];
const steps = titles.map((title, index) => ({
  title,
  stop: { wide: page.wide.stops[index] ?? 0, phone: page.phone.stops[index] ?? 0 },
}));
---

<section id="ai-build-night" class="abn" aria-labelledby="abn-title">
  <div class="abn-cover" data-frame data-moment data-cover data-loops tabindex="-1">
    <div class="abn-cover__type">
      <h2 id="abn-title">
        AI Build
        <span>
          Night<i data-cursor aria-hidden="true"></i>
        </span>
      </h2>
      <div class="abn-cover__foot">
        <p class="abn-cover__line">Stop reading about AI. Start building with it.</p>
        <button
          class="abn-key"
          type="button"
          data-moment-control
          aria-expanded="false"
          aria-label="Press Enter to see how it works"
        >
          <span class="abn-key__wall">
            <span class="abn-key__cap">
              <span class="abn-key__word">Enter</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 6v6H6M10 8l-4 4 4 4"></path>
              </svg>
            </span>
          </span>
        </button>
      </div>
    </div>

    <div class="abn-show" data-opens>
      <div class="abn-show__top">
        <p class="abn-show__lead">
          A free night in Victoria to build something real with AI.
          <span>I co-run it and built the site.</span>
        </p>
        <a class="abn-show__cta" href="https://aibuildnight.ca/">
          <span>aibuildnight.ca</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <Steps
        name="abn"
        steps={steps}
        shape="wide"
        rotates
        address="aibuildnight.ca"
        href="https://aibuildnight.ca/"
        label="Open the AI Build Night site, aibuildnight.ca"
        dwell={7500}
      >
        <SitePage slot="view" wide={page.wide} phone={page.phone} />
      </Steps>
    </div>
  </div>
</section>

<style>
  .abn {
    --bone: #f5f4f0;
    --ink: #0e1113;
    --harbour: #1f4e5a;
    --signal: #ff5b23;
    --bar: calc(100lvh - 100svh);
    position: relative;
    background: var(--signal);
    color: var(--ink);
    font-family: var(--sans);
  }

  /* The cover: an orange wall, a cursor, and one key. On a stage the live site waits inside the
     cursor. Without one, the cover and the site simply stack. */
  .abn-cover {
    position: relative;
    overflow: clip;
  }

  :global(.stage) .abn-cover {
    height: 100lvh;
  }

  .abn-cover:focus {
    outline: none;
  }

  .abn-cover__type {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 1.5rem;
    min-height: 100svh;
    padding: clamp(4.5rem, 11svh, 7rem) var(--gutter) var(--gutter);
  }

  :global(.stage) .abn-cover .abn-cover__type {
    position: absolute;
    inset: 0 0 auto;
    height: 100svh;
    min-height: 0;
  }

  h2 {
    font-size: clamp(4.4rem, min(21vw, 34svh), 21rem);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: -0.055em;
  }

  h2 span {
    display: block;
  }

  h2 i {
    display: inline-block;
    width: 0.38em;
    height: 0.68em;
    margin-left: 0.1em;
    background: var(--ink);
    animation: cursor 1.1s steps(2, jump-none) infinite;
  }

  @keyframes cursor {
    50% {
      opacity: 0.15;
    }
  }

  .abn-cover__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    align-items: end;
    justify-content: space-between;
  }

  .abn-cover__line {
    max-width: 20ch;
    font-size: clamp(1.7rem, min(3.6vw, 6svh), 3.2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* A real switch in a plate: a dished cap on tall walls, which sink into the plate when pressed. It
     only exists while there is something to press it for. */
  .abn-key {
    --travel: clamp(0.5rem, 1.1svh, 0.8rem);
    position: relative;
    display: none;
    flex: none;
    width: clamp(12rem, min(30vw, 46svh - 4.5rem), 26rem);
    aspect-ratio: 1.5;
    padding: 0;
    border: 0;
    border-radius: 1.5rem;
    background: linear-gradient(160deg, #24282b, #0b0d0e 70%);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 22%),
      inset 0 -0.3rem 0.5rem rgb(0 0 0 / 70%),
      0 1.3rem 1.8rem -0.5rem rgb(70 18 0 / 62%);
  }

  :global(.stage) .abn-cover:not([data-open]) .abn-key {
    display: block;
  }

  .abn-key__wall {
    position: absolute;
    inset: 4.5% 4% calc(5% + var(--travel) * 1.4);
    border-radius: 1.15rem;
    background: linear-gradient(90deg, #a9a69c, #d9d6cc 18%, #d9d6cc 82%, #a9a69c);
    box-shadow:
      0 var(--travel) 0 #7d7a71,
      0 calc(var(--travel) + 0.5rem) 0.7rem rgb(0 0 0 / 72%);
    transition:
      transform 70ms ease-out,
      box-shadow 70ms ease-out;
  }

  .abn-key__cap {
    position: absolute;
    inset: 5% 6.5% 11%;
    display: flex;
    gap: 1rem;
    align-items: end;
    justify-content: space-between;
    padding: 0.9rem 1.15rem;
    border-radius: 0.9rem;
    background: radial-gradient(120% 100% at 50% 8%, #fffefa, #efece3 62%, #dcd8cc);
    box-shadow:
      inset 0 0.18rem 0.3rem #fff,
      inset 0 -0.35rem 0.7rem rgb(60 54 40 / 22%);
    color: var(--ink);
    font-family: var(--mono);
    font-size: clamp(1.5rem, min(2.6vw, 4svh), 2.3rem);
    font-weight: 800;
  }

  .abn-key svg {
    width: 1.5em;
    height: 1.5em;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.4;
  }

  .abn-key:active .abn-key__wall {
    transform: translateY(var(--travel));
    box-shadow:
      0 0.1rem 0 #7d7a71,
      0 0.25rem 0.3rem rgb(0 0 0 / 72%);
  }

  .abn-key:focus-visible {
    outline-color: var(--ink);
    outline-offset: 0.3rem;
  }

  /* The key dips by itself every few seconds, so it reads as something to press. */
  :global(.stage) .abn-cover[data-here]:not([data-open]) .abn-key__wall {
    animation: dip 3.4s ease-in-out infinite;
  }

  @keyframes dip {
    0%,
    80%,
    100% {
      transform: none;
    }

    86%,
    90% {
      transform: translateY(calc(var(--travel) * 0.8));
    }
  }

  /* The steps, opening out of the cursor. */
  .abn-show {
    --steps-room: calc(100svh - 12.5rem);
    --step-size: clamp(1.15rem, min(2.05vw, 3.6svh), 2.2rem);
    --step-lines: 5;
    --step-number: var(--signal);
    --step-number-ink: var(--ink);
    --step-frame: 2px solid var(--ink);
    --step-wait: 700ms;
    --bar-height: 2.5rem;
    --window: min(60vw, calc((var(--steps-room) - var(--bar-height)) * 1.6));
    --rail-size: clamp(1.05rem, min(1.6vw, 2.9svh), 1.75rem);
    --rail-rows: 0;
    --rail-gap: clamp(1rem, 2.5vw, 2.5rem);
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: auto auto;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 4svh, 3rem);
    align-content: center;
    min-height: 100lvh;
    padding: 4.5rem var(--gutter) calc(1.5rem + var(--bar));
    overflow: clip;
    background: var(--bone);
    clip-path: inset(0);
  }

  :global(.stage) .abn-cover .abn-show {
    position: absolute;
    inset: 0;
    height: 100lvh;
    min-height: 0;
  }

  :global(.stage) .abn-cover:not([data-open]) .abn-show {
    clip-path: inset(var(--cursor, 100% 0 0 0));
  }

  /* Cut down to the cursor and painted to match it, so the cursor stays a cursor until the key is
     pressed. */
  .abn-show::after {
    content: '';
    position: absolute;
    z-index: 3;
    inset: 0;
    background: var(--ink);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms;
  }

  :global(.stage) .abn-cover:not([data-open]) .abn-show::after {
    opacity: 1;
    animation: cursor-paint 1.1s steps(2, jump-none) infinite;
  }

  @keyframes cursor-paint {
    50% {
      background: #db5120;
    }
  }

  .abn-cover[data-open] .abn-show {
    transition: clip-path 1000ms cubic-bezier(0.7, 0, 0.15, 1) 120ms;
  }

  /* Rotating: the site in a browser, scrolling to each step in turn, beside a list of every step. */
  .abn-show :global(.steps-window) {
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 0.6rem;
    background: var(--ink);
    color: var(--bone);
    font-family: var(--mono);
  }

  .abn-show :global(.steps-window__bar span) {
    padding: 0.3em 0.8em;
    border-radius: 99rem;
    background: #2a2e30;
  }

  .abn-show :global(.steps-window__bar)::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 3px;
    background: var(--signal);
    transform: scaleX(var(--progress));
    transform-origin: 0 50%;
  }

  .abn-show :global([data-layout='rotating'] .step) {
    border-top: 2px solid var(--ink);
  }

  .abn-show :global([data-layout='rotating'] .step:last-child) {
    border-bottom: 2px solid var(--ink);
  }

  .abn-show :global([data-layout='rotating'] .step[data-current]) {
    background: var(--ink);
    color: var(--bone);
  }

  .abn-show__top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    align-items: end;
    justify-content: space-between;
  }

  .abn-show__lead {
    max-width: 22em;
    font-size: clamp(1.5rem, min(2.8vw, 5svh), 2.8rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .abn-show__lead span {
    display: block;
    margin-top: 0.3em;
    font-size: 0.55em;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .abn-show__cta {
    display: inline-flex;
    gap: 1.2rem;
    padding: 0.9rem 1.2rem;
    background: var(--ink);
    color: var(--bone);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    text-decoration: none;
    transition:
      transform 180ms var(--ease),
      background 180ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .abn-show__cta:hover {
      transform: translate(-0.2rem, -0.2rem);
      background: var(--signal);
      color: var(--ink);
    }
  }

  @media (max-width: 860px) {
    /* The key is the whole point of this screen, so on a phone it gets the whole width. */
    .abn-key {
      width: min(100%, 44svh, 26rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 760px) {
    .abn-show {
      --steps-room: calc(100svh - 13rem);
      --step-size: clamp(0.8rem, min(4.5vw, 2.3svh), 1.2rem);
      --bar-height: 1.9rem;
      --rail-size: var(--step-size);
      --rail-pad: 0.45em 0.55em;
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: 0.75rem;
      padding-top: 1.5rem;
      padding-bottom: calc(1rem + var(--bar));
    }

    .abn-show__top {
      display: contents;
    }

    .abn-show__cta {
      order: 1;
      gap: 0.5rem;
      justify-self: start;
      padding: 0.55rem 0.65rem;
      font-size: 0.95rem;
      white-space: nowrap;
    }
  }

  /* Phones on their side keep the words beside the key, and one line above the steps. */
  /* A tall window suits a phone's capture, and only that. Past this width the desktop capture shows,
     and its last stop only fills a window of the usual shape. A short phone needs its room for the
     list. */
  @media (max-width: 600px) and (min-height: 661px) {
    .abn-show {
      --view-ratio: 1.1;
      --window-share: 0.68;
    }
  }

  @media (max-height: 560px) {
    .abn-cover__type {
      padding-block: 2.75rem 1rem;
    }

    .abn-cover h2 {
      font-size: min(21vw, 24svh);
    }

    .abn-cover__foot {
      flex-wrap: nowrap;
    }

    .abn-cover__line {
      font-size: 1.2rem;
    }

    .abn-key {
      width: 10.5rem;
    }
  }

  @media (max-height: 480px) and (orientation: landscape) {
    .abn-show {
      --steps-room: calc(100svh - 6.75rem);
      --step-size: 0.82rem;
      --bar-height: 1.5rem;
      --window: min(52vw, calc((var(--steps-room) - var(--bar-height)) * 1.6));
      --rail-pad: 0.3em 0.45em;
      grid-template-rows: auto minmax(0, 1fr);
      gap: 0.5rem;
      padding-top: 2.75rem;
      padding-bottom: calc(0.75rem + var(--bar));
    }

    .abn-show__top {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
    }

    .abn-show__lead {
      max-width: none;
      font-size: 1.05rem;
    }

    .abn-show__lead span {
      display: inline;
    }

    .abn-show__cta {
      flex: none;
      order: 0;
      padding: 0.3rem 0.6rem;
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce), (scripting: none) {
    h2 i {
      animation: none;
    }
  }

  /* Until the script makes them buttons, or if it never does, the steps are a list beside the still
     page. */
  .abn-show :global([data-layout='rotating'] h3:not(:has(.step__pick))) {
    display: flex;
    padding: 0.55em 0.65em;
  }

  @media (scripting: none) {
    .abn-show :global(.steps-set[data-layout='rotating']) {
      height: auto;
    }
  }
</style>
