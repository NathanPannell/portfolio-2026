---
const steps = [
  ['Doors.', 'Free, and open to anyone. Any role or background can be a builder.'],
  ['Pick a track.', 'Try an optional challenge, or bring your own project.'],
  ['Build.', 'Laptops open. Paurav and I wander around getting people unstuck.'],
  ['Show-and-tell.', 'Optional, and encouraged. Show what you made, finished or not.'],
  ['Close.', 'Bring a laptop. Leave with something.'],
];
const contours = [
  'M-50 120C180 40 320 210 520 130S830 30 1050 150',
  'M-50 210C150 150 300 310 520 220S860 110 1050 250',
  'M-50 320C200 240 280 430 540 320S840 230 1050 360',
  'M-50 430C170 370 330 520 560 420S820 340 1050 470',
  'M-50 540C160 470 300 640 540 530S850 450 1050 590',
  'M-50 650C200 590 340 730 560 640S860 570 1050 690',
  'M-50 760C180 700 300 850 540 750S830 690 1050 800',
];
---

<section id="ai-build-night" class="abn" data-audience="builders" aria-labelledby="abn-title">
  <div class="abn-open">
    <p class="label">01 / The main thing right now</p>
    <h2 id="abn-title">
      AI Build
      <span>
        Night<i aria-hidden="true"></i>
      </span>
    </h2>
    <div class="abn-open__body">
      <p class="abn-open__line">Come curious. Build something.</p>
      <p>
        A free, hands-on evening in Victoria, BC, for beginners and experienced AI builders. I
        co-run it with Kalen Christ, Carmello Giron and Paurav H Param, and I designed and built its
        website.
      </p>
    </div>
  </div>

  <div class="abn-room" data-track data-room>
    <div class="abn-room__stage">
      <svg
        class="abn-room__contours"
        viewBox="0 0 1000 900"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        {contours.map((d) => (
          <path d={d} pathLength="1" />
        ))}
      </svg>
      <div class="abn-room__copy">
        <p class="label">A night, from above</p>
        <p class="abn-room__clock" data-clock>
          18:00
        </p>
        <ol>
          {steps.map(([title, text]) => (
            <li data-step>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ol>
      </div>
      <figure class="abn-room__plan">
        <canvas
          role="img"
          aria-label="A top-down drawing of a room filling with people and laptops"
        ></canvas>
        <figcaption>Drawn, not counted.</figcaption>
      </figure>
    </div>
  </div>

  <div class="abn-tenets" data-track>
    <div class="abn-tenets__stage">
      <p class="label">Two tenets</p>
      <p class="abn-tenets__one">The next unicorn can come from Vancouver Island.</p>
      <p class="abn-tenets__two">We share what we learn.</p>
      <p class="abn-tenets__note">
        AI is moving too fast for anyone to keep up alone. We stay ahead as a community.
      </p>
    </div>
  </div>

  <div class="abn-site">
    <div class="abn-site__copy" data-reveal>
      <p class="label">The website</p>
      <h3>A site that reports what happened, and skips the hype.</h3>
      <p>
        Heavy headlines, Salish Sea contour lines and one orange cursor. The tools anyone can use on
        the night orbit the headline, because the point is that you pick one and start.
      </p>
      <dl>
        <div>
          <dt>001</dt>
          <dd>Oct 22, 2026 · Herald St Brew Works</dd>
        </div>
        <div>
          <dt>002</dt>
          <dd>Date coming soon · Victoria, BC</dd>
        </div>
      </dl>
      <a class="abn-site__cta" href="https://aibuildnight.ca/">
        <span>aibuildnight.ca</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="abn-site__show">
      <figure class="abn-browser" data-reveal>
        <div class="abn-browser__bar" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
          <span>aibuildnight.ca</span>
        </div>
        <video
          data-src="/media/build-night/site-loop.mp4"
          poster="/media/build-night/site-800.webp"
          width="1120"
          height="700"
          muted
          loop
          playsinline
          preload="none"
          aria-label="The AI Build Night homepage, with AI tools orbiting its headline"
        ></video>
      </figure>
      <img
        class="abn-phone"
        data-reveal
        src="/media/build-night/phone-360.webp"
        srcset="/media/build-night/phone-360.webp 360w, /media/build-night/phone-640.webp 640w"
        sizes="(max-width: 700px) 34vw, 15rem"
        width="640"
        height="1385"
        loading="lazy"
        decoding="async"
        alt="The AI Build Night homepage on a phone"
      />
      <figure class="abn-hosts" data-reveal style="--reveal-turn: 5deg">
        <img
          src="/media/build-night/hosts-480.webp"
          srcset="/media/build-night/hosts-480.webp 480w, /media/build-night/hosts-800.webp 800w"
          sizes="(max-width: 700px) 42vw, 17rem"
          width="800"
          height="1227"
          loading="lazy"
          decoding="async"
          alt="A Polaroid of the four hosts: Kalen Christ, Nathan Pannell, Carmello Giron and Paurav H Param"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .abn {
    --bone: #f5f4f0;
    --ink: #0e1113;
    --glass: #bfe6da;
    --harbour: #1f4e5a;
    --signal: #ff5b23;
    position: relative;
    background: var(--signal);
    color: var(--ink);
    font-family: var(--sans);
  }

  .label {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .abn-open {
    min-height: 100svh;
    display: grid;
    align-content: space-between;
    gap: 2.5rem;
    padding: clamp(5rem, 11svh, 7rem) var(--gutter) var(--gutter);
  }

  h2 {
    font-size: clamp(5rem, 21vw, 21rem);
    font-weight: 900;
    font-stretch: 100%;
    line-height: 0.82;
    letter-spacing: -0.055em;
  }

  h2 span {
    display: block;
  }

  h2 i {
    display: inline-block;
    width: 0.38em;
    height: 0.68em;
    margin-left: 0.1em;
    background: var(--ink);
    animation: cursor 1.1s steps(2, jump-none) infinite;
  }

  @keyframes cursor {
    50% {
      opacity: 0.15;
    }
  }

  .abn-open__body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 3rem;
    max-width: 68rem;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    font-weight: 500;
    line-height: 1.35;
  }

  .abn-open__line {
    font-size: clamp(1.7rem, 3.6vw, 3.2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .abn-room {
    height: 420svh;
    background: var(--bone);
  }

  .abn-room__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 5rem);
    padding: 4.5rem var(--gutter) var(--gutter);
    background: var(--bone);
  }

  .abn-room__contours {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--harbour);
    stroke-width: 1;
    opacity: 0.32;
  }

  .abn-room__contours path {
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - min(1, var(--p, 1) * 1.6));
  }

  .abn-room__copy {
    position: relative;
    z-index: 1;
  }

  .abn-room__clock {
    margin: 0.5rem 0 1rem;
    font-size: clamp(4.5rem, 12vw, 11.5rem);
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--ink);
  }

  .abn-room__copy ol {
    position: relative;
    min-height: 8.5rem;
  }

  .abn-room__copy li {
    position: absolute;
    inset: 0 auto auto 0;
    max-width: 30ch;
    opacity: 0;
    transform: translateY(0.6rem);
    transition:
      opacity 240ms,
      transform 300ms var(--ease);
  }

  .abn-room__copy li[data-on] {
    opacity: 1;
    transform: none;
  }

  .abn-room__copy h3 {
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .abn-room__copy li p {
    margin-top: 0.35rem;
    color: var(--harbour);
    font-size: 1.1rem;
    line-height: 1.35;
  }

  .abn-room__plan {
    position: relative;
    z-index: 1;
    width: min(46vw, calc(100svh - 8rem));
  }

  .abn-room__plan canvas {
    width: 100%;
    aspect-ratio: 1;
    box-shadow: 0.6rem 0.6rem 0 var(--ink);
  }

  figcaption {
    margin-top: 1rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--harbour);
    text-align: right;
  }

  .abn-tenets {
    height: 240svh;
    background: var(--ink);
  }

  .abn-tenets__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
    display: grid;
    align-content: center;
    gap: clamp(1rem, 3svh, 2rem);
    padding: 4rem var(--gutter);
    color: var(--glass);
  }

  .abn-tenets__one,
  .abn-tenets__two {
    font-size: clamp(2.3rem, min(8.6vw, 12svh), 9rem);
    font-weight: 900;
    line-height: 0.93;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .abn-tenets__one {
    clip-path: inset(0 calc(100% - min(1, var(--p, 1) * 2.2) * 100%) 0 0);
  }

  .abn-tenets__two {
    color: var(--signal);
    clip-path: inset(0 calc(100% - min(1, max(0, var(--p, 1) - 0.42) * 2.4) * 100%) 0 0);
  }

  .abn-tenets__note {
    max-width: 38ch;
    color: #cfd6d3;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    opacity: calc((var(--p, 1) - 0.72) * 5);
  }

  .abn-site {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding: clamp(5rem, 12vw, 10rem) var(--gutter);
    background: var(--glass);
  }

  .abn-site h3 {
    margin: 0.8rem 0 1rem;
    font-size: clamp(2.2rem, 4.8vw, 4.75rem);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.04em;
  }

  .abn-site__copy > p:not(.label) {
    max-width: 44ch;
    color: #15363e;
  }

  dl {
    margin: 1.75rem 0;
    border-top: 2px solid var(--ink);
  }

  dl div {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--ink);
  }

  dt {
    font-weight: 900;
    font-size: 1.5rem;
    letter-spacing: -0.03em;
  }

  dd {
    margin: 0;
    font-size: 0.98rem;
  }

  .abn-site__cta {
    display: inline-flex;
    gap: 1.2rem;
    padding: 1rem 1.35rem;
    background: var(--ink);
    color: var(--bone);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    text-decoration: none;
    transition:
      transform 180ms var(--ease),
      background 180ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .abn-site__cta:hover {
      transform: translate(-0.2rem, -0.2rem);
      background: var(--signal);
      color: var(--ink);
    }
  }

  .abn-site__show {
    position: relative;
    padding-bottom: 14%;
  }

  .abn-browser {
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 0.7rem;
    background: var(--bone);
    box-shadow: 0.7rem 0.7rem 0 var(--ink);
  }

  .abn-browser__bar {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    padding: 0.55rem 0.7rem;
    border-bottom: 2px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .abn-browser__bar i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--ink);
  }

  .abn-browser__bar span {
    margin-left: 0.5rem;
  }

  .abn-browser video {
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    background: var(--bone);
  }

  .abn-phone {
    position: absolute;
    right: -2%;
    bottom: 0;
    width: 25%;
    border: 5px solid var(--ink);
    border-radius: 1.5rem;
    box-shadow: 0.5rem 0.5rem 0 var(--ink);
  }

  .abn-hosts {
    position: absolute;
    bottom: -3%;
    left: -3%;
    width: 30%;
    rotate: -5deg;
    filter: drop-shadow(0.4rem 0.6rem 0.8rem rgb(0 0 0 / 28%));
  }

  @media (max-width: 860px) {
    .abn-open__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .abn-site {
      grid-template-columns: minmax(0, 1fr);
    }

    .abn-site__show {
      padding-bottom: 22%;
    }
  }

  @media (max-width: 860px) and (orientation: portrait) {
    .abn-room__stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      gap: 0.85rem;
      align-items: start;
      justify-items: center;
      padding-top: 4rem;
    }

    .abn-room__copy {
      width: 100%;
    }

    .abn-room__clock {
      margin: 0.15rem 0 0.4rem;
      font-size: clamp(3.5rem, 18vw, 6rem);
    }

    .abn-room__copy ol {
      min-height: 6.6rem;
    }

    .abn-room__plan {
      width: min(100%, calc(100svh - 21rem));
    }

    figcaption {
      margin-top: 0.7rem;
    }
  }

  /* Phones on their side keep the drawing beside the clock. */
  @media (max-height: 480px) {
    .abn-room__stage {
      padding-top: 3rem;
      padding-bottom: 0.5rem;
    }

    .abn-room__clock {
      margin: 0;
      font-size: 3.5rem;
    }

    .abn-room__plan {
      width: calc(100svh - 5rem);
    }

    .abn-room__copy ol {
      min-height: 6.5rem;
    }

    figcaption {
      display: none;
    }
  }

  @media (scripting: none) {
    .abn-room__plan {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce), (scripting: none) {
    h2 i {
      animation: none;
    }

    .abn-room,
    .abn-tenets {
      height: auto;
    }

    .abn-room__stage,
    .abn-tenets__stage {
      position: relative;
      height: auto;
      min-height: 100svh;
    }

    .abn-room__copy ol {
      min-height: 0;
    }

    .abn-room__copy li {
      position: static;
      margin-bottom: 1rem;
      opacity: 1;
      transform: none;
    }

    .abn-room__clock {
      display: none;
    }

    .abn-tenets__one,
    .abn-tenets__two {
      clip-path: none;
    }

    .abn-tenets__note {
      opacity: 1;
    }
  }
</style>
