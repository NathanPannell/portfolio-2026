---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';

// Each phone flips through screens on its own beat.
const phones = [
  {
    at: 0.48,
    screens: [
      ['record', 'Offbooked recording screen: an actor records a line of Hamlet'],
      ['cast', 'Offbooked cast list: how many lines each part has recorded'],
      ['home', 'Offbooked home screen in the phone’s browser'],
    ],
  },
  {
    at: 0.52,
    screens: [
      ['play', 'Offbooked run-through: the actor’s own lines are highlighted'],
      ['landing', 'The Offbooked landing page on a phone'],
      ['record', 'Offbooked recording screen: an actor records a line of Hamlet'],
    ],
  },
  {
    at: 0.56,
    screens: [
      ['cast', 'Offbooked cast list: how many lines each part has recorded'],
      ['home', 'Offbooked home screen in the phone’s browser'],
      ['play', 'Offbooked run-through: the actor’s own lines are highlighted'],
    ],
  },
];
const bubbles = [
  ['bubble--one', 'Line?'],
  ['bubble--two', 'Again!'],
  ['bubble--three', 'Places!'],
];
---

<section id="offbooked" class="ob" data-audience="casts" aria-labelledby="ob-title">
  <div class="ob-reveal" data-track data-focus-at="0.9" data-collage data-loops>
    <div class="ob-stage" data-stage>
      <div class="collage">
        <i class="beam beam--left" aria-hidden="true"></i>
        <i class="beam beam--right" aria-hidden="true"></i>
        <div class="slab" data-at="0.27" data-depth="-6"></div>
        <div class="halftone" data-at="0.27" data-depth="14" aria-hidden="true"></div>

        <h2 id="ob-title" data-depth="-10">
          <span data-at="0.31">Run lines with</span>
          <em data-at="0.36">your cast,</em>
          <span data-at="0.41">not a robot.</span>
        </h2>

        <div class="script" data-at="0.45" data-depth="10" aria-hidden="true">
          <p class="script__scene">Act 1, Scene 2</p>
          <p>
            <b>HORATIO</b> Hail to your lordship!
          </p>
          <p>
            <b>HAMLET</b> I am glad to see you well: Horatio, or I do forget myself.
          </p>
          <p class="script__mine">
            <b>HORATIO</b> The same, my lord, and your poor servant ever.
          </p>
          <p>
            <b>HAMLET</b> Sir, my good friend; I’ll change that name with you.
          </p>
          <p class="script__mine">
            <b>HORATIO</b> A truant disposition, good my lord.
          </p>
        </div>

        {phones.map(({ at, screens }, index) => (
          <figure
            class={`handset handset--${index + 1}`}
            data-at={String(at)}
            data-depth={String(18 + index * 12)}
          >
            {screens.map(([name, alt], screen) => (
              <img
                style={`--screen: ${screen}`}
                src={`/media/offbooked/${name}-360.webp`}
                srcset={`/media/offbooked/${name}-360.webp 360w, /media/offbooked/${name}-640.webp 640w`}
                sizes="(max-width: 700px) 42vw, 22vw"
                width="640"
                height="1385"
                loading="lazy"
                decoding="async"
                alt={screen === 0 ? alt : ''}
              />
            ))}
          </figure>
        ))}

        <div class="voices" data-at="0.6" data-depth="20" aria-hidden="true">
          {Array.from({ length: 18 }, (_, i) => (
            <i style={`--i: ${i}`} />
          ))}
        </div>

        {bubbles.map(([name, text]) => (
          <p class={`bubble ${name}`} data-at="0.6" aria-hidden="true">
            <span>{text}</span>
          </p>
        ))}

        <svg class="stamp" viewBox="0 0 200 200" data-at="0.64" data-depth="26" aria-hidden="true">
          <defs>
            <path id="stamp-ring" d="M100 100m-74 0a74 74 0 1 1 148 0a74 74 0 1 1 -148 0"></path>
          </defs>
          <circle cx="100" cy="100" r="98"></circle>
          <text>
            <textPath href="#stamp-ring">PUBLIC BETA · FREE FOR NOW · PUBLIC BETA ·</textPath>
          </text>
          <text class="stamp__mid" x="100" y="112" text-anchor="middle">
            ★
          </text>
        </svg>

        <p class="tape" data-at="0.68" data-depth="16">
          Cast needs no account
        </p>

        <a class="ticket" href="https://offbooked.com/" data-at="0.72" data-depth="-12">
          <span class="ticket__small">Admit the whole cast</span>
          <span class="ticket__big">
            offbooked.com <span aria-hidden="true">↗</span>
          </span>
        </a>

        <p class="marquee" data-at="0.24" aria-hidden="true">
          <span>
            One link · Everyone records on their phone · The whole cast rehearses · One link ·
            Everyone records on their phone · The whole cast rehearses · One link · Everyone records
            on their phone · The whole cast rehearses ·
          </span>
        </p>
      </div>

      <div class="drape drape--left" aria-hidden="true"></div>
      <div class="drape drape--right" aria-hidden="true"></div>
      <div class="billing" aria-hidden="true">
        <span>Now playing</span>
        <strong>Offbooked</strong>
      </div>
    </div>
  </div>
</section>

<style>
  .ob {
    --paper: #f3ecdd;
    --ink: #1d1c1a;
    --red: #a8382a;
    --red-deep: #6f1f17;
    --marker: #f3d98b;
    --spring: cubic-bezier(0.2, 1.5, 0.35, 1);
    position: relative;
    z-index: 2;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Newsreader Variable', Georgia, serif;
  }

  .ob-reveal {
    height: 620lvh;
  }

  .ob-stage {
    --u: min(1vw, 1.62svh);
    /* Opens in the first quarter of the track; everything after that is the ad assembling. */
    --open: clamp(0, calc((var(--p, 1) - 0.03) * 4.5), 1);
    /* Runs once the ad is up, so the finished page keeps moving under the scroll. */
    --late: clamp(0, calc((var(--p, 1) - 0.72) * 3.6), 1);
    /* What a phone's address bar hides at the bottom of this taller-than-the-bar stage. */
    --bar: calc(100lvh - 100svh);
    position: sticky;
    top: 0;
    height: 100lvh;
    overflow: clip;
    background: var(--paper);
  }

  .collage {
    position: absolute;
    inset: 0;
    background-color: var(--paper);
    background-image: radial-gradient(rgb(29 28 26 / 7%) 0.5px, transparent 0.6px);
    background-size: 5px 5px;
  }

  [data-depth] {
    --move: calc(var(--mx, 0) * var(--d, 0) * 1px);
    --lift: calc(var(--my, 0) * var(--d, 0) * 1px + var(--late, 0) * var(--drift, 0px));
    translate: var(--move) var(--lift);
  }

  /* Off stage until scroll calls each piece on, and only once the script that does so is running. */
  @media (prefers-reduced-motion: no-preference) {
    .ob-stage[data-sprung] [data-at] {
      transition:
        transform 620ms var(--spring),
        opacity 200ms;
    }

    .ob-stage[data-ready] .slab:not([data-on]) {
      transform: translate3d(-104%, 0, 0);
    }

    .ob-stage[data-ready] .halftone:not([data-on]) {
      transform: scale(0);
    }

    .ob-stage[data-ready] h2 [data-at]:not([data-on]) {
      opacity: 0;
      transform: translate3d(-3rem, 0, 0) rotate(-4deg);
    }

    .ob-stage[data-ready] .script:not([data-on]) {
      transform: translate3d(0, -130%, 0) rotate(-22deg);
    }

    .ob-stage[data-ready] .handset:not([data-on]) {
      transform: translate3d(0, 130lvh, 0) rotate(14deg);
    }

    .ob-stage[data-ready] .voices:not([data-on]) {
      opacity: 0;
      transform: scaleY(0);
    }

    .ob-stage[data-ready] .stamp:not([data-on]) {
      opacity: 0;
      transform: scale(3.4);
    }

    .ob-stage[data-ready] .tape:not([data-on]) {
      opacity: 0;
      transform: translate3d(5rem, -2rem, 0) rotate(30deg);
    }

    .ob-stage[data-ready] .ticket:not([data-on]) {
      opacity: 0;
      transform: translate3d(0, 140%, 0) rotate(-14deg);
    }

    .ob-stage[data-ready] .marquee:not([data-on]) {
      transform: translate3d(0, 100%, 0);
    }

    .ob-stage[data-ready] .bubble:not([data-on]) {
      opacity: 0;
    }
  }

  /* Two follow spots hunting across the set. */
  .beam {
    position: absolute;
    z-index: 8;
    top: -12%;
    width: 34vmax;
    height: 150lvh;
    background: linear-gradient(rgb(255 243 200 / 34%), rgb(255 243 200 / 4%));
    clip-path: polygon(46% 0, 54% 0, 100% 100%, 0 100%);
    pointer-events: none;
    transform-origin: 50% 0;
    opacity: var(--open);
  }

  .beam--left {
    left: 8%;
    animation: hunt 7s ease-in-out infinite alternate;
  }

  .beam--right {
    right: 4%;
    animation: hunt 9s ease-in-out infinite alternate-reverse;
  }

  @keyframes hunt {
    from {
      transform: rotate(-20deg);
    }

    to {
      transform: rotate(24deg);
    }
  }

  .slab {
    position: absolute;
    inset: -2% 37% -2% -2%;
    background: var(--red);
    clip-path: polygon(
      0 0,
      99% 0,
      97% 7%,
      100% 13%,
      96% 21%,
      99% 30%,
      95% 38%,
      98% 46%,
      94% 55%,
      98% 63%,
      95% 71%,
      99% 80%,
      96% 89%,
      99% 100%,
      0 100%
    );
  }

  .halftone {
    position: absolute;
    top: 8%;
    right: 3%;
    width: calc(var(--u) * 42);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(var(--red) 34%, transparent 36%) 0 0 / 0.75rem 0.75rem;
    opacity: 0.55;
    rotate: calc(var(--late) * 40deg);
  }

  h2 {
    position: absolute;
    top: calc(var(--u) * 9);
    left: calc(var(--gutter) + 1.5vw);
    width: calc(var(--u) * 43);
    color: var(--paper);
    font-size: calc(var(--u) * 8.4);
    font-weight: 500;
    line-height: 0.93;
    letter-spacing: -0.035em;
  }

  h2 span,
  h2 em {
    display: block;
    width: fit-content;
  }

  h2 em {
    padding: 0 0.1em 0.04em;
    background: var(--marker);
    color: var(--red-deep);
    font-weight: 500;
    rotate: -1.5deg;
  }

  .script {
    position: absolute;
    top: 7%;
    right: 24%;
    width: calc(var(--u) * 27);
    padding: calc(var(--u) * 2);
    background: #fffdf7;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 22%);
    font-size: calc(var(--u) * 1.25);
    line-height: 1.32;
    rotate: calc(5deg - var(--late) * 9deg);
    clip-path: polygon(
      0 0,
      100% 0,
      100% 92%,
      96% 95%,
      90% 92%,
      80% 97%,
      70% 94%,
      58% 99%,
      44% 95%,
      30% 98%,
      16% 94%,
      6% 98%,
      0 94%
    );
  }

  .script p {
    margin-bottom: 0.65em;
  }

  .script b {
    display: block;
    font-family: var(--mono);
    font-size: 0.72em;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .script__scene {
    font-size: 1.3em;
    font-style: italic;
  }

  /* The highlighter keeps going over the actor's own lines. */
  .script__mine {
    padding: 0.25em 0.45em;
    background: linear-gradient(var(--marker), var(--marker)) no-repeat 0 0 / 100% 100%;
    animation: highlight 4.4s var(--ease) infinite;
  }

  .script__mine:last-child {
    animation-delay: -2.2s;
  }

  @keyframes highlight {
    0% {
      background-size: 0 100%;
    }

    35%,
    100% {
      background-size: 100% 100%;
    }
  }

  .handset {
    position: absolute;
    width: calc(var(--u) * 19.5);
    aspect-ratio: 640 / 1385;
    box-sizing: content-box;
    padding: calc(var(--u) * 0.55);
    border-radius: calc(var(--u) * 3);
    background: #161514;
    box-shadow: 0 1.5rem 3rem rgb(29 16 12 / 42%);
  }

  /* Screens stack, and each one takes a turn on top. */
  .handset img {
    position: absolute;
    width: calc(100% - var(--u) * 1.1);
    border-radius: calc(var(--u) * 2.5);
    animation: screen 9s steps(1, end) infinite;
    animation-delay: calc(var(--screen) * 3s - 9s);
  }

  .handset img:first-child {
    animation-name: none;
  }

  @keyframes screen {
    0%,
    33.3% {
      opacity: 1;
    }

    33.4%,
    100% {
      opacity: 0;
    }
  }

  .handset--1 {
    z-index: 3;
    top: 16%;
    right: 26%;
    rotate: -7deg;
    --drift: -5lvh;
  }

  .handset--2 {
    z-index: 4;
    top: 11%;
    right: 12%;
    rotate: 3deg;
    --drift: 5lvh;
  }

  .handset--3 {
    z-index: 2;
    top: 24%;
    right: -3%;
    rotate: 9deg;
    --drift: -8lvh;
  }

  /* Everyone's voices, in the run-through. */
  .voices {
    position: absolute;
    z-index: 5;
    bottom: 22%;
    left: calc(var(--gutter) + 1.5vw);
    display: flex;
    gap: 0.28rem;
    align-items: center;
    width: calc(var(--u) * 30);
    height: calc(var(--u) * 8);
    transform-origin: 50% 100%;
  }

  .voices i {
    flex: 1;
    height: 100%;
    border-radius: 99rem;
    background: var(--marker);
    transform: scaleY(0.2);
    animation: speak 1.1s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -170ms);
  }

  @keyframes speak {
    to {
      transform: scaleY(1);
    }
  }

  .bubble {
    position: absolute;
    z-index: 7;
    pointer-events: none;
  }

  .bubble span {
    display: block;
    padding: 0.25em 0.75em;
    border: 3px solid var(--ink);
    border-radius: 1.2em 1.2em 1.2em 0.2em;
    background: #fff;
    font-size: clamp(1.1rem, 2.2vw, 2rem);
    font-style: italic;
    font-weight: 500;
    animation: pop 7.5s var(--spring) infinite;
  }

  .bubble--one {
    top: 12%;
    right: 37%;
  }

  .bubble--two {
    top: 50%;
    right: 3%;
  }

  .bubble--two span {
    animation-delay: -2.5s;
  }

  .bubble--three {
    top: 74%;
    right: 34%;
  }

  .bubble--three span {
    animation-delay: -5s;
  }

  @keyframes pop {
    0%,
    100% {
      transform: scale(0) rotate(-12deg);
    }

    6%,
    26% {
      transform: none;
    }

    33% {
      transform: scale(0) rotate(8deg);
    }
  }

  .stamp {
    position: absolute;
    z-index: 6;
    bottom: calc(13% + var(--bar));
    right: 41%;
    width: calc(var(--u) * 13);
    animation: turn 18s linear infinite;
  }

  .stamp circle {
    fill: var(--marker);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .stamp text {
    fill: var(--ink);
    font-family: var(--mono);
    font-size: 15.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .stamp .stamp__mid {
    font-size: 44px;
  }

  @keyframes turn {
    to {
      rotate: 360deg;
    }
  }

  .tape {
    position: absolute;
    z-index: 6;
    top: 6%;
    right: 4%;
    padding: 0.35rem 1.1rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: clamp(0.72rem, 1vw, 0.92rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    rotate: 6deg;
    transform-origin: 100% 0;
    animation: flutter 2.8s ease-in-out infinite alternate;
  }

  @keyframes flutter {
    to {
      rotate: 3deg;
    }
  }

  .ticket {
    position: absolute;
    z-index: 6;
    bottom: calc(11% + var(--bar));
    left: calc(var(--gutter) + 1.5vw);
    display: grid;
    padding: 0.65rem 1.4rem 0.75rem 1.1rem;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    rotate: -2deg;
    mask:
      radial-gradient(circle 0.55rem at 100% 50%, transparent 98%, #000) right,
      radial-gradient(circle 0.55rem at 0 50%, transparent 98%, #000) left;
    mask-size: 51% 100%;
    mask-repeat: no-repeat;
    animation: admit 3.2s ease-in-out infinite alternate;
  }

  @keyframes admit {
    to {
      rotate: 1.5deg;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .ticket:hover {
      animation-play-state: paused;
    }
  }

  /* The ticket's mask would clip an outline, so its focus ring is drawn inside the paper. */
  .ticket:focus-visible {
    outline-offset: -0.55rem;
  }

  .ticket__small {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ticket__big {
    font-size: clamp(1.45rem, 2.6vw, 2.25rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.1;
  }

  .marquee {
    position: absolute;
    z-index: 7;
    right: 0;
    bottom: var(--bar);
    left: 0;
    overflow: hidden;
    padding: 0.5rem 0;
    background: var(--marker);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marquee span {
    display: inline-block;
    animation: slide 40s linear infinite;
  }

  @keyframes slide {
    to {
      transform: translateX(-33.33%);
    }
  }

  /* Velvet: folds bunch up at the wings as the drapes open. The scalloped hem and fringe come down
     over the last world like a house curtain. */
  .drape {
    position: absolute;
    z-index: 10;
    top: 0;
    bottom: 0;
    width: 51%;
    background:
      linear-gradient(transparent 92%, #d8a93c 92%, #d8a93c 93%, transparent 93%),
      linear-gradient(rgb(0 0 0 / 18%), transparent 25%, transparent 70%, rgb(0 0 0 / 35%)),
      repeating-linear-gradient(
        90deg,
        #5e1612 0,
        #8d241c 3vw,
        #b3372a 4.4vw,
        #8d241c 6vw,
        #5e1612 8.5vw
      );
    will-change: transform;
  }

  .drape--left {
    left: 0;
    transform-origin: 0 50%;
    transform: scaleX(calc(1 - var(--open) * 0.95));
  }

  .drape--right {
    right: 0;
    transform-origin: 100% 50%;
    transform: scaleX(calc(1 - var(--open) * 0.95));
  }

  .billing {
    position: absolute;
    z-index: 11;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.4rem;
    color: #f7ecd2;
    text-align: center;
    opacity: calc(1 - var(--open) * 3.4);
    pointer-events: none;
  }

  .billing span {
    font-family: var(--mono);
    font-size: 0.85rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .billing strong {
    font-size: clamp(4rem, 15vw, 15rem);
    font-style: italic;
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  @media (max-aspect-ratio: 5/6) {
    .ob-stage {
      --u: min(2.45vw, 1.14svh);
    }

    .slab {
      inset: -2% -2% 55% -2%;
      clip-path: polygon(
        0 0,
        100% 0,
        100% 94%,
        90% 98%,
        78% 93%,
        64% 99%,
        50% 94%,
        36% 100%,
        22% 94%,
        10% 98%,
        0 93%
      );
    }

    h2 {
      top: 5.2rem;
      left: 1.5rem;
      width: calc(100% - 3rem);
      font-size: clamp(2.7rem, 13vw, 6.5rem);
    }

    .halftone {
      top: auto;
      right: auto;
      bottom: 6%;
      left: -14%;
      width: 70%;
    }

    .script {
      top: 46%;
      right: auto;
      left: -8%;
      width: 44%;
      font-size: 0.72rem;
      rotate: calc(-6deg + var(--late) * 8deg);
    }

    .handset {
      width: calc(44% - 0.6rem);
      padding: 0.3rem;
      border-radius: 1.5rem;
    }

    .handset img {
      width: calc(100% - 0.6rem);
      border-radius: 1.25rem;
    }

    .handset--1 {
      top: 43%;
      right: auto;
      left: 5%;
    }

    .handset--2 {
      top: 40%;
      right: 2%;
    }

    .handset--3 {
      display: none;
    }

    .voices {
      z-index: 5;
      bottom: calc(8.5rem + var(--bar));
      left: 1.25rem;
      width: 42%;
      height: 2.2rem;
      gap: 0.18rem;
    }

    .bubble--one {
      top: 38%;
      right: auto;
      left: 4%;
    }

    .bubble--two {
      top: 62%;
      right: 2%;
    }

    .bubble--three {
      display: none;
    }

    .stamp {
      top: 37%;
      right: 2%;
      bottom: auto;
      width: 5.75rem;
    }

    .tape {
      top: auto;
      right: -1%;
      bottom: calc(5.5rem + var(--bar));
      font-size: 0.68rem;
    }

    .ticket {
      bottom: calc(3.1rem + var(--bar));
      left: 1.25rem;
      background: var(--marker);
    }

    .beam {
      opacity: calc(var(--open) * 0.55);
    }

    @media (max-width: 380px) {
      .tape {
        display: none;
      }
    }

    @media (max-height: 700px) {
      .bubble--two {
        display: none;
      }
    }
  }

  /* Phones on their side: too short for the waveform and the bubbles next to the headline. */
  @media (max-height: 480px) {
