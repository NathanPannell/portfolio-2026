---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';

// Everything on the ticket is as stated on offbooked.com. No prices until they can be paid.
const details = [
  ['Admission', 'Free in public beta. Cast never pay.'],
  ['Cast', 'One link. No account needed.'],
  ['Playing on', 'Any phone, tablet or laptop.'],
  ['Now running', 'Casts in British Columbia and Nova Scotia.'],
];
---

<section
  id="offbooked"
  class="ob"
  data-frame
  data-moment
  data-loops
  tabindex="-1"
  aria-labelledby="ob-title"
>
  <div class="ob-stage">
    <button
      class="rope"
      type="button"
      data-moment-control
      data-pull
      aria-expanded="false"
      aria-label="Pull the rope to open the curtains"
    >
      <i class="rope__cord"></i>
      <svg class="rope__tassel" viewBox="0 0 60 130" aria-hidden="true">
        <circle cx="30" cy="18" r="16"></circle>
        <path d="M18 32h24l10 84H8z"></path>
        <path class="rope__strand" d="M20 44l-5 68M30 44v70M40 44l5 68"></path>
      </svg>
      <span class="rope__tag" aria-hidden="true">
        Pull
      </span>
    </button>

    <div class="collage">
      <i class="beam beam--left" aria-hidden="true"></i>
      <i class="beam beam--right" aria-hidden="true"></i>
      <div class="ob-copy">
        <h2 id="ob-title">
          <span style="--at: 1.2s" data-at>
            Run lines with
          </span>
          <em style="--at: 1.45s" data-at>
            your cast,
          </em>
          <span style="--at: 1.7s" data-at>
            not a robot.
          </span>
        </h2>

        <div class="voices" style="--at: 2s" data-at aria-hidden="true">
          {Array.from({ length: 18 }, (_, i) => (
            <i style={`--i: ${i}`} />
          ))}
        </div>

        <a class="ticket" href="https://offbooked.com/" style="--at: 2.3s" data-at data-opens>
          <span class="ticket__main">
            <span class="ticket__small">Admit the whole cast</span>
            <dl class="ticket__details">
              {details.map(([label, text]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{text}</dd>
                </div>
              ))}
            </dl>
          </span>
          <span class="ticket__stub">
            <span class="ticket__small">Places, everyone.</span>
            <span class="ticket__big">
              offbooked.com <span aria-hidden="true">↗</span>
            </span>
          </span>
        </a>
      </div>

      <figure class="handset" style="--at: 1.9s" data-at>
        <img
          src="/media/offbooked/play-360.webp"
          srcset="/media/offbooked/play-360.webp 360w, /media/offbooked/play-640.webp 640w"
          sizes="(max-width: 700px) 46vw, 24vw"
          width="640"
          height="1385"
          loading="lazy"
          decoding="async"
          alt="Offbooked run-through: the actor’s own lines are highlighted"
        />
      </figure>
    </div>

    <div class="drape drape--left" aria-hidden="true"></div>
    <div class="drape drape--right" aria-hidden="true"></div>
    <div class="billing" aria-hidden="true">
      <span>Now playing</span>
      <strong>Offbooked</strong>
    </div>
  </div>
</section>

<style>
  .ob {
    --paper: #f3ecdd;
    --ink: #1d1c1a;
    --red: #a8382a;
    --red-deep: #6f1f17;
    --marker: #f3d98b;
    --spring: cubic-bezier(0.2, 1.5, 0.35, 1);
    position: relative;
    z-index: 2;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Newsreader Variable', Georgia, serif;
  }

  .ob:focus {
    outline: none;
  }

  .ob-stage {
    --u: min(1vw, 1.62svh);
    position: relative;
    height: 100lvh;
    overflow: clip;
    background: var(--paper);
  }

  .collage {
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 80% at 72% 40%, var(--red), var(--red-deep));
  }

  /* Off stage while the curtains are shut. Each piece then lands at its own --at. */
  .ob[data-open] [data-at] {
    transition:
      transform 620ms var(--spring) var(--at),
      opacity 200ms var(--at);
  }

  :global(.stage) .ob:not([data-open]) h2 [data-at] {
    opacity: 0;
    transform: translate3d(-3rem, 0, 0) rotate(-4deg);
  }

  :global(.stage) .ob:not([data-open]) .handset {
    transform: translate3d(0, 130lvh, 0) rotate(14deg);
  }

  :global(.stage) .ob:not([data-open]) .voices {
    opacity: 0;
    transform: scaleY(0);
  }

  :global(.stage) .ob:not([data-open]) .ticket {
    opacity: 0;
    transform: translate3d(0, 140%, 0) rotate(-6deg);
  }

  /* Two follow spots hunting across the set. */
  .beam {
    position: absolute;
    z-index: 8;
    top: -12%;
    width: 34vmax;
    height: 150lvh;
    background: linear-gradient(rgb(255 243 200 / 34%), rgb(255 243 200 / 4%));
    clip-path: polygon(46% 0, 54% 0, 100% 100%, 0 100%);
    pointer-events: none;
    transform-origin: 50% 0;
    transition: opacity 900ms 900ms;
  }

  :global(.stage) .ob:not([data-open]) .beam {
    opacity: 0;
  }

  .beam--left {
    left: 8%;
    animation: hunt 7s ease-in-out infinite alternate;
  }

  .beam--right {
    right: 4%;
    animation: hunt 9s ease-in-out infinite alternate-reverse;
  }

  @keyframes hunt {
    from {
      transform: rotate(-20deg);
    }

    to {
      transform: rotate(24deg);
    }
  }

  /* Everything sits inside the small viewport, so an address bar can't cover any of it. */
  .ob-copy {
    position: absolute;
    z-index: 6;
    top: 0;
    left: calc(var(--gutter) + 2.5vw);
    display: grid;
    align-content: center;
    justify-items: start;
    gap: calc(var(--u) * 2.4);
    width: calc(var(--u) * 54);
    height: 100svh;
    padding-top: 2.5rem;
  }

  h2 {
    color: var(--paper);
    font-size: calc(var(--u) * 7);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  h2 span,
  h2 em {
    display: block;
    width: fit-content;
  }

  h2 em {
    padding: 0 0.1em 0.04em;
    background: var(--marker);
    color: var(--red-deep);
    font-weight: 500;
    rotate: -1.5deg;
  }

  /* One phone, in the run-through. */
  .handset {
    position: absolute;
    z-index: 5;
    top: calc(50svh - var(--u) * 26.7);
    right: calc(var(--gutter) + 6vw);
    width: calc(var(--u) * 24);
    aspect-ratio: 640 / 1385;
    box-sizing: content-box;
    padding: calc(var(--u) * 0.6);
    border-radius: calc(var(--u) * 3.4);
    background: #161514;
    box-shadow: 0 1.5rem 3rem rgb(29 16 12 / 50%);
    rotate: 3deg;
  }

  .handset img {
    width: 100%;
    border-radius: calc(var(--u) * 2.9);
  }

  /* Everyone's voices, in the run-through. */
  .voices {
    display: flex;
    gap: 0.28rem;
    align-items: center;
    width: calc(var(--u) * 34);
    height: calc(var(--u) * 7);
    transform-origin: 50% 100%;
  }

  .voices i {
    flex: 1;
    height: 100%;
    border-radius: 99rem;
    background: var(--marker);
    transform: scaleY(0.2);
    animation: speak 1.1s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -170ms);
  }

  @keyframes speak {
    to {
      transform: scaleY(1);
    }
  }

  /* A proper ticket: the show's details on the left, a stub to tear off on the right. */
  .ticket {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    width: 100%;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    mask:
      radial-gradient(circle 0.6rem at 100% 50%, transparent 98%, #000) right,
      radial-gradient(circle 0.6rem at 0 50%, transparent 98%, #000) left;
    mask-size: 51% 100%;
    mask-repeat: no-repeat;
    transition: background 160ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .ticket:hover {
      background: var(--marker);
    }
  }

  /* The ticket's mask would clip an outline, so its focus ring is drawn inside the paper. */
  .ticket:focus-visible {
    outline-offset: -0.55rem;
  }

  .ticket__main {
    display: grid;
    gap: 0.5rem;
    padding: calc(var(--u) * 1.3) calc(var(--u) * 1.6) calc(var(--u) * 1.4) calc(var(--u) * 2);
  }

  .ticket__small {
    font-family: var(--mono);
    font-size: clamp(0.66rem, calc(var(--u) * 0.85), 0.82rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ticket__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(var(--u) * 0.7) calc(var(--u) * 1.5);
    margin: 0;
  }

  dt {
    color: var(--red);
    font-family: var(--mono);
    font-size: clamp(0.6rem, calc(var(--u) * 0.72), 0.72rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-size: clamp(0.85rem, calc(var(--u) * 1.15), 1.2rem);
    line-height: 1.12;
  }

  .ticket__stub {
    display: grid;
    align-content: center;
    gap: 0.35rem;
    padding: calc(var(--u) * 1.3) calc(var(--u) * 2.2) calc(var(--u) * 1.3) calc(var(--u) * 1.6);
    border-left: 2px dashed rgb(29 28 26 / 45%);
  }

  .ticket__big {
    font-size: clamp(1.2rem, calc(var(--u) * 2.2), 2.1rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.05;
    white-space: nowrap;
  }

  /* Velvet: folds bunch up at the wings as the drapes open. The scalloped hem and fringe come down
     over the last world like a house curtain. */
  .drape {
    position: absolute;
    z-index: 10;
    top: 0;
    bottom: 0;
    width: 51%;
    transform: scaleX(0.05);
    background:
      linear-gradient(transparent 92%, #d8a93c 92%, #d8a93c 93%, transparent 93%),
      linear-gradient(rgb(0 0 0 / 18%), transparent 25%, transparent 70%, rgb(0 0 0 / 35%)),
      repeating-linear-gradient(
        90deg,
        #5e1612 0,
        #8d241c 3vw,
        #b3372a 4.4vw,
        #8d241c 6vw,
        #5e1612 8.5vw
      );
    will-change: transform;
  }

  .drape--left {
    left: 0;
    transform-origin: 0 50%;
  }

  .drape--right {
    right: 0;
    transform-origin: 100% 50%;
  }

  :global(.stage) .ob:not([data-open]) .drape {
    transform: none;
  }

  .ob[data-open] .drape {
    transition: transform 1200ms cubic-bezier(0.65, 0, 0.2, 1) 120ms;
  }

  .billing {
    position: absolute;
    z-index: 11;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.4rem;
    color: #f7ecd2;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 280ms;
  }

  :global(.stage) .ob:not([data-open]) .billing {
    opacity: 1;
  }

  .billing span {
    font-family: var(--mono);
    font-size: 0.85rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .billing strong {
    font-size: clamp(4rem, 15vw, 15rem);
    font-style: italic;
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  /* The pulley: a tassel to grab, on a cord up to the top of the frame. Only the tassel is the
     button, because it can't scroll the page: a swipe on the cord still does. */
  .rope {
    --pull: 0px;
    position: absolute;
    z-index: 12;
    top: calc(min(66svh, 34rem) - 8.2rem);
    right: clamp(1rem, 11vw, 11rem);
    display: none;
    width: 4.5rem;
    height: 8.2rem;
    padding: 0;
    border: 0;
    background: none;
    color: #f7ecd2;
    cursor: grab;
    transform: translateY(var(--pull));
    touch-action: none;
    user-select: none;
  }

  .rope:active {
    cursor: grabbing;
  }

  :global(.stage) .ob:not([data-open]) .rope {
    display: block;
  }

  /* Used once. It runs on down and is hauled back up with the curtains. */
  .ob[data-open] .rope {
    display: block;
    pointer-events: none;
    animation: haul 1000ms var(--ease) forwards;
  }

  @keyframes haul {
    30% {
      transform: translateY(calc(var(--pull) + 5rem));
    }

    100% {
      visibility: hidden;
      transform: translateY(-100lvh);
    }
  }

  .rope__cord {
    position: absolute;
    bottom: calc(100% - 0.7rem);
    left: calc(50% - 0.3rem);
    width: 0.6rem;
    height: 120lvh;
    background: repeating-linear-gradient(
      -38deg,
      #f0cf7a 0,
      #f0cf7a 0.28rem,
      #a8791f 0.28rem,
      #a8791f 0.5rem
    );
    box-shadow: 0.2rem 0 0.5rem rgb(0 0 0 / 35%);
    pointer-events: none;
  }

  .rope__tassel {
    position: absolute;
    top: 0;
    left: calc(50% - 1.75rem);
    width: 3.5rem;
    height: auto;
    fill: #e2b64c;
    stroke: #6f4a0b;
    stroke-width: 3;
    stroke-linejoin: round;
    filter: drop-shadow(0.2rem 0.4rem 0.4rem rgb(0 0 0 / 40%));
  }

  .rope__strand {
    fill: none;
  }

  .rope__tag {
    position: absolute;
    top: 5.25rem;
    left: calc(50% + 1.6rem);
    padding: 0.1rem 0.6rem;
    background: #f7ecd2;
    color: var(--red-deep);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    rotate: 6deg;
  }

  /* The rope gives a tug now and then, so it reads as something to grab. */
  :global(.stage) .ob[data-here]:not([data-open]) .rope {
    animation: tug 2.6s ease-in-out infinite;
  }

  @keyframes tug {
    0%,
    62%,
    100% {
      translate: 0 0;
    }

    72% {
      translate: 0 0.9rem;
    }

    84% {
      translate: 0 -0.2rem;
    }
  }

  .rope:focus-visible {
    outline-offset: -0.25rem;
  }

  @media (max-aspect-ratio: 5/6) {
    .ob-stage {
      --u: min(2.45vw, 1.14svh);
    }

    .ob-copy {
      left: 1.25rem;
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      align-content: stretch;
      gap: 0.75rem;
      width: calc(100% - 2.5rem);
      padding-block: 3.75rem 1.25rem;
    }

    h2 {
      font-size: clamp(2.5rem, min(12.5vw, 7.4svh), 6rem);
    }

    .voices {
      grid-row: 3;
      align-self: center;
      width: 42%;
      height: 3.5rem;
      gap: 0.18rem;
    }

    .ticket {
      grid-row: 4;
      grid-template-columns: minmax(0, 1fr);
    }

    .ticket__main,
    .ticket__stub {
      padding-inline: 1.4rem;
    }

    .ticket__stub {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      padding-block: 0.5rem 0.6rem;
      border-top: 2px dashed rgb(29 28 26 / 45%);
      border-left: 0;
    }

    .ticket__details {
      gap: 0.4rem 1rem;
    }

    /* Hangs in the gap between the title and the ticket, beside the waveform. */
    .handset {
      top: 29svh;
      right: 1.25rem;
      width: min(46vw, 19svh);
      padding: 0.3rem;
      border-radius: 1.6rem;
    }

    .handset img {
      border-radius: 1.3rem;
    }

    /* The ticket takes more of a small phone, so the handset gets less. */
    @media (max-height: 700px) {
      .handset {
        width: 15svh;
      }
    }

    .beam {
      opacity: 0.55;
    }

    /* Short enough to hang clear of the title. */
    .rope {
      top: calc(40svh - 8.2rem);
      right: 0.5rem;
    }

    .rope__tag {
      right: calc(50% + 1.6rem);
      left: auto;
      rotate: -6deg;
    }
  }

  /* Phones on their side: the phone and the waveform go, for the title and the ticket. */
  @media (max-height: 480px) and (min-aspect-ratio: 5/6) {
    .ob-copy {
      width: calc(100% - var(--gutter) * 2 - 5vw - 22svh);
      gap: 0.5rem;
    }

    h2 {
      font-size: 13svh;
    }

    .voices {
      display: none;
    }

    .handset {
      top: 12svh;
      right: 2.5vw;
      width: 20svh;
    }

    .ticket__main,
    .ticket__stub {
      padding-block: 0.4rem;
    }

    .ticket__details {
      gap: 0.2rem 0.75rem;
    }

    dd {
      font-size: 0.78rem;
    }

    .ticket__big {
      font-size: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce), (scripting: none) {
    .drape,
    .billing,
    .beam {
      display: none;
    }

    .voices i {
      animation: none;
      transform: scaleY(0.55);
    }
  }
</style>
