---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import Steps from './Steps.astro';

// Each screen is the real app, run locally on its Hamlet demo. See ASSETS.md.
const steps = [
  {
    title: 'Upload your script.',
    image: '/media/offbooked/upload',
    alt: 'Offbooked new production screen: Hamlet, with its script file added',
  },
  {
    title: 'Invite your cast.',
    image: '/media/offbooked/invite',
    alt: 'Offbooked invite screen: Sam invited you to Hamlet. Who are you playing?',
  },
  {
    title: 'Everyone records their lines.',
    image: '/media/offbooked/record',
    alt: 'Offbooked recording screen for Francisco, with a take in progress',
  },
  {
    title: 'Practise with your castmates’ voices.',
    image: '/media/offbooked/practise',
    alt: 'Offbooked playing the scene back, with the actor’s own lines highlighted',
  },
];
---

<section
  id="offbooked"
  class="ob"
  data-frame
  data-moment
  data-curtains
  data-loops
  tabindex="-1"
  aria-labelledby="ob-title"
>
  <div class="ob-stage">
    <button
      class="rope"
      type="button"
      data-moment-control
      data-pull
      aria-expanded="false"
      aria-label="Pull the rope to open the curtains"
    >
      <i class="rope__cord"></i>
      <svg class="rope__tassel" viewBox="0 0 60 130" aria-hidden="true">
        <circle cx="30" cy="18" r="16"></circle>
        <path d="M18 32h24l10 84H8z"></path>
        <path class="rope__strand" d="M20 44l-5 68M30 44v70M40 44l5 68"></path>
      </svg>
      <span class="rope__tag" aria-hidden="true">
        Pull
      </span>
    </button>

    <div class="collage">
      <i class="beam beam--left" aria-hidden="true"></i>
      <i class="beam beam--right" aria-hidden="true"></i>
      <div class="ob-copy">
        <h2 id="ob-title">
          <span style="--at: 1.2s" data-at>
            Run lines with
          </span>
          <em style="--at: 1.45s" data-at>
            your cast,
          </em>
          <span style="--at: 1.7s" data-at>
            not a robot.
          </span>
        </h2>

        <a class="ticket" href="https://offbooked.com/" style="--at: 2s" data-at data-opens>
          <span class="ticket__small">Free in public beta</span>
          <span class="ticket__big">
            offbooked.com <span aria-hidden="true">↗</span>
          </span>
        </a>
        <Steps name="offbooked" steps={steps} shape="phone" layout="rotating" />
      </div>
    </div>

    <div class="drape drape--left" aria-hidden="true"></div>
    <div class="drape drape--right" aria-hidden="true"></div>
    <div class="billing" aria-hidden="true">
      <span>Now playing</span>
      <strong>Offbooked</strong>
    </div>
  </div>
</section>

<style>
  .ob {
    --paper: #f3ecdd;
    --ink: #1d1c1a;
    --red: #a8382a;
    --red-deep: #6f1f17;
    --marker: #f3d98b;
    --spring: cubic-bezier(0.2, 1.5, 0.35, 1);
    position: relative;
    z-index: 2;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Newsreader Variable', Georgia, serif;
  }

  .ob:focus {
    outline: none;
  }

  .ob-stage {
    --u: min(1vw, 1.62svh);
    position: relative;
    height: 100lvh;
    overflow: clip;
    background: var(--paper);
  }

  .collage {
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 80% at 72% 40%, var(--red), var(--red-deep));
  }

  /* Off stage while the curtains are shut. Each piece then lands at its own --at. */
  .ob[data-open] [data-at] {
    transition:
      transform 620ms var(--spring) var(--at),
      opacity 200ms var(--at);
  }

  :global(.stage) .ob:not([data-open]) h2 [data-at] {
    opacity: 0;
    transform: translate3d(-3rem, 0, 0) rotate(-4deg);
  }

  :global(.stage) .ob:not([data-open]) .ticket {
    opacity: 0;
    transform: translate3d(0, 140%, 0) rotate(-6deg);
  }

  /* Two follow spots hunting across the set. */
  .beam {
    position: absolute;
    z-index: 8;
    top: -12%;
    width: 34vmax;
    height: 150lvh;
    background: linear-gradient(rgb(255 243 200 / 34%), rgb(255 243 200 / 4%));
    clip-path: polygon(46% 0, 54% 0, 100% 100%, 0 100%);
    pointer-events: none;
    transform-origin: 50% 0;
    transition: opacity 900ms 900ms;
  }

  :global(.stage) .ob:not([data-open]) .beam {
    opacity: 0;
  }

  .beam--left {
    left: 8%;
    animation: hunt 7s ease-in-out infinite alternate;
  }

  .beam--right {
    right: 4%;
    animation: hunt 9s ease-in-out infinite alternate-reverse;
  }

  @keyframes hunt {
    from {
      transform: rotate(-20deg);
    }

    to {
      transform: rotate(24deg);
    }
  }

  /* Everything sits inside the small viewport, so an address bar can't cover any of it. */
  .ob-copy {
    --steps-room: calc(100svh - 10.25rem);
    --step-size: clamp(1.05rem, min(1.75vw, 3.1svh), 1.7rem);
    --step-lines: 3;
    --step-number: var(--marker);
    --step-number-ink: var(--red-deep);
    --step-frame: 0.35rem solid #161514;
    --step-corner: 1.4rem;
    --step-behind: #161514;
    --step-shadow: 0 1rem 2rem rgb(29 16 12 / 45%);
    --step-tracking: -0.01em;
    --step-weight: 600;
    --step-wait: 1200ms;
    --window: calc(var(--steps-room) * 0.46);
    --rail-size: clamp(1.15rem, min(2vw, 3.5svh), 2rem);
    --rail-rows: 0.4rem;
    --rail-gap: clamp(1.5rem, 6vw, 6rem);
    --rail-pad: 0.3em 0.5em;
    --toggle-inset: 0;
    position: absolute;
    z-index: 6;
    top: 0;
    left: var(--gutter);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(0.75rem, 2.5svh, 1.75rem) 2rem;
    align-items: center;
    width: calc(100% - var(--gutter) * 2);
    height: 100svh;
    padding-block: 4rem 1.25rem;
    color: var(--paper);
  }

  h2 {
    color: var(--paper);
    font-size: clamp(2rem, min(4.2vw, 8svh), 4.4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  h2 span,
  h2 em {
    display: inline-block;
  }

  h2 em {
    margin-inline: 0.22em;
    padding: 0 0.1em 0.04em;
    background: var(--marker);
    color: var(--red-deep);
    font-weight: 500;
    rotate: -1.5deg;
  }

  .ob-copy :global(.steps) {
    grid-column: 1 / -1;
    align-self: start;
  }

  /* Rotating: one big phone, beside a page of the script with each line marked in turn, the way an
     actor marks their own. The marker runs along the line for as long as the step has left. */
  .ob-copy :global(.steps-set[data-layout='rotating']) {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 36rem) var(--window);
    justify-content: center;
  }

  .ob-copy :global([data-layout='rotating'] > .steps) {
    grid-row: auto;
    grid-column: auto;
    align-self: center;
    padding: 1.1rem 1.25rem;
    background: var(--paper);
    box-shadow: 0 1rem 2rem rgb(29 16 12 / 45%);
    color: var(--ink);
    rotate: -0.5deg;
  }

  .ob-copy :global([data-layout='rotating'] .step__number) {
    background: none;
    color: var(--red);
  }

  .ob-copy :global(.step__pick) {
    background: linear-gradient(var(--marker), var(--marker)) 0 0 / 0 100% no-repeat;
  }

  .ob-copy :global([data-current] .step__pick) {
    background-size: calc(var(--progress) * 100%) 100%;
  }

  .ob-copy :global(.steps-window) {
    overflow: hidden;
    border: 0.45rem solid #161514;
    border-radius: 2.4rem;
    background: #161514;
    box-shadow: 0 1.5rem 3rem rgb(29 16 12 / 55%);
  }

  .ob-copy :global(.steps-window__view) {
    border-radius: 1.95rem;
  }

  /* One link, on what's left of the ticket. */
  .ticket {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 1.75rem 0.8rem;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    mask:
      radial-gradient(circle 0.6rem at 100% 50%, transparent 98%, #000) right,
      radial-gradient(circle 0.6rem at 0 50%, transparent 98%, #000) left;
    mask-size: 51% 100%;
    mask-repeat: no-repeat;
    transition: background 160ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .ticket:hover {
      background: var(--marker);
    }
  }

  /* The ticket's mask would clip an outline, so its focus ring is drawn inside the paper. */
  .ticket:focus-visible {
    outline-offset: -0.55rem;
  }

  .ticket__small {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ticket__big {
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.05;
    white-space: nowrap;
  }

  /* Velvet: folds bunch up at the wings as the drapes open. The scalloped hem and fringe come down
     over the last world like a house curtain. */
  .drape {
    position: absolute;
    z-index: 10;
    top: 0;
    bottom: 0;
    width: 51%;
    transform: scaleX(0.05);
    background:
      linear-gradient(transparent 92%, #d8a93c 92%, #d8a93c 93%, transparent 93%),
      linear-gradient(rgb(0 0 0 / 18%), transparent 25%, transparent 70%, rgb(0 0 0 / 35%)),
      repeating-linear-gradient(
        90deg,
        #5e1612 0,
        #8d241c 3vw,
        #b3372a 4.4vw,
        #8d241c 6vw,
        #5e1612 8.5vw
      );
    will-change: transform;
  }

  .drape--left {
    left: 0;
    transform-origin: 0 50%;
  }

  .drape--right {
    right: 0;
    transform-origin: 100% 50%;
  }

  :global(.stage) .ob:not([data-open]) .drape {
    transform: none;
  }

  .ob[data-open] .drape {
    transition: transform 1200ms cubic-bezier(0.65, 0, 0.2, 1) 120ms;
  }

  .billing {
    position: absolute;
    z-index: 11;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.4rem;
    color: #f7ecd2;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 280ms;
  }

  :global(.stage) .ob:not([data-open]) .billing {
    opacity: 1;
  }

  .billing span {
    font-family: var(--mono);
    font-size: 0.85rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .billing strong {
    font-size: clamp(4rem, 15vw, 15rem);
    font-style: italic;
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  /* The pulley: a tassel to grab, on a cord up to the top of the frame. Only the tassel is the
     button, because it can't scroll the page: a swipe on the cord still does. */
  .rope {
    --pull: 0px;
    position: absolute;
    z-index: 12;
    top: calc(min(66svh, 34rem) - 8.2rem);
    right: clamp(1rem, 11vw, 11rem);
    display: none;
    width: 4.5rem;
    height: 8.2rem;
    padding: 0;
    border: 0;
    background: none;
    color: #f7ecd2;
    cursor: grab;
    transform: translateY(var(--pull));
    touch-action: none;
    user-select: none;
  }

  .rope:active {
    cursor: grabbing;
  }

  :global(.stage) .ob:not([data-open]) .rope {
    display: block;
  }

  /* Used once. It runs on down and is hauled back up with the curtains. */
  .ob[data-open] .rope {
    display: block;
    pointer-events: none;
    animation: haul 1000ms var(--ease) forwards;
  }

  @keyframes haul {
    30% {
      transform: translateY(calc(var(--pull) + 5rem));
    }

    100% {
      visibility: hidden;
      transform: translateY(-100lvh);
    }
  }

  .rope__cord {
    position: absolute;
    bottom: calc(100% - 0.7rem);
    left: calc(50% - 0.3rem);
    width: 0.6rem;
    height: 120lvh;
    background: repeating-linear-gradient(
      -38deg,
      #f0cf7a 0,
      #f0cf7a 0.28rem,
      #a8791f 0.28rem,
      #a8791f 0.5rem
    );
    box-shadow: 0.2rem 0 0.5rem rgb(0 0 0 / 35%);
    pointer-events: none;
  }

  .rope__tassel {
    position: absolute;
    top: 0;
    left: calc(50% - 1.75rem);
    width: 3.5rem;
    height: auto;
    fill: #e2b64c;
    stroke: #6f4a0b;
    stroke-width: 3;
    stroke-linejoin: round;
    filter: drop-shadow(0.2rem 0.4rem 0.4rem rgb(0 0 0 / 40%));
  }

  .rope__strand {
    fill: none;
  }

  .rope__tag {
    position: absolute;
    top: 5.25rem;
    left: calc(50% + 1.6rem);
    padding: 0.1rem 0.6rem;
    background: #f7ecd2;
    color: var(--red-deep);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    rotate: 6deg;
  }

  /* The rope gives a tug now and then, so it reads as something to grab. */
  :global(.stage) .ob[data-here]:not([data-open]) .rope {
    animation: tug 2.6s ease-in-out infinite;
  }

  @keyframes tug {
    0%,
    62%,
    100% {
      translate: 0 0;
    }

    72% {
      translate: 0 0.9rem;
    }

    84% {
      translate: 0 -0.2rem;
    }
  }

  .rope:focus-visible {
    outline-offset: -0.25rem;
  }

  @media (max-aspect-ratio: 5/6) {
    /* Short enough to hang clear of the title. */
    .rope {
      top: calc(40svh - 8.2rem);
      right: 0.5rem;
    }

    .rope__tag {
      right: calc(50% + 1.6rem);
      left: auto;
      rotate: -6deg;
    }

    .beam {
      opacity: 0.55;
    }
  }

  @media (max-width: 760px) {
    .ob-copy {
      --title: clamp(1.8rem, min(8.6vw, 5svh), 3rem);
      --steps-room: calc(100svh - 9.5rem - var(--title) * 2);
      --step-size: clamp(0.85rem, min(4.3vw, 2.2svh), 1.15rem);
      --step-frame: 0.22rem solid #161514;
      --step-corner: 0.9rem;
      grid-template-rows: auto minmax(0, 1fr) auto;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
      padding-block: 3.25rem 0.9rem;
    }

    h2 {
      font-size: var(--title);
    }

    .ticket {
      grid-row: 3;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .ob-copy :global(.steps) {
      grid-row: 2;
    }

    .ob-copy :global(.steps-set[data-layout='rotating']) {
      grid-row: 2;
    }
  }

  @media (max-width: 760px) and (orientation: portrait) {
    .ob-copy {
      --window: min(54vw, calc(var(--steps-room) * 0.46));
      --rail-size: clamp(0.9rem, 4.2vw, 1.15rem);
      --rail-gap: 0.75rem;
    }

    .ob-copy :global(.steps-set[data-layout='rotating']) {
      grid-template-columns: minmax(0, 1fr) var(--window);
    }

    .ob-copy :global([data-layout='rotating'] > .steps) {
      padding: 0.6rem 0.5rem;
    }

    .ob-copy :global(.steps-window) {
      border-width: 0.3rem;
      border-radius: 1.5rem;
    }

    .ob-copy :global(.steps-window__view) {
      border-radius: 1.2rem;
    }
  }

  /* Tall enough for the phone to stand over the whole script. */
  @media (max-width: 760px) and (orientation: portrait) and (min-height: 700px) {
    .ob-copy {
      --window: calc((var(--steps-room) - 9.5rem) * 0.46);
    }

    .ob-copy :global(.steps-set[data-layout='rotating']) {
      grid-template-rows: minmax(0, 1fr) auto;
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 0.6rem;
    }

    .ob-copy :global([data-layout='rotating'] > .steps) {
      width: 100%;
    }

    .ob-copy :global([data-layout='rotating'] .steps-window) {
      order: -1;
    }
  }

  /* Phones on their side: the title and the ticket share a line above the steps. */
  @media (max-height: 480px) and (orientation: landscape) {
    .ob-copy {
      --steps-room: calc(100svh - 7rem);
      --step-size: 0.85rem;
      --step-frame: 0.2rem solid #161514;
      --step-corner: 0.7rem;
      --rail-size: 0.9rem;
      --rail-rows: 0;
      --rail-gap: 1.25rem;
      --rail-pad: 0.2em 0.45em;
      grid-template-rows: auto minmax(0, 1fr);
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.4rem 1rem;
      padding-block: 2.75rem 0.6rem;
    }

    h2 {
      font-size: 1.6rem;
    }

    .ticket {
      grid-row: auto;
      display: block;
      padding: 0.25rem 1.2rem;
    }

    .ticket__small {
      display: none;
    }

    .ticket__big {
      font-size: 1rem;
    }

    .ob-copy :global(.steps) {
      grid-row: auto;
    }

    .ob-copy :global(.steps-set[data-layout='rotating']) {
      grid-row: auto;
    }

    .ob-copy :global([data-layout='rotating'] > .steps) {
      padding: 0.35rem 0.4rem;
      rotate: none;
    }

    .ob-copy :global(.steps-window) {
      border-width: 0.2rem;
      border-radius: 1rem;
    }

    .ob-copy :global(.steps-window__view) {
      border-radius: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce), (scripting: none) {
    .drape,
    .billing,
    .beam {
      display: none;
    }
  }
</style>
