---
import Doors from './heroes/Doors.astro';
---

<section class="hero" data-frame>
  <Doors />

  <a class="hero__next" href="#ai-build-night" aria-label="Next: AI Build Night">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 4v15M5 12l7 7 7-7"></path>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 100lvh;
    overflow: clip;
    background: var(--ink);
  }

  .hero__next {
    position: absolute;
    z-index: 5;
    right: var(--gutter);
    bottom: calc(0.85rem + 100lvh - 100svh);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--bone);
    color: var(--ink);
  }

  .hero__next svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.6;
  }

  .hero__next svg {
    animation: hero-next 1.8s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__next svg {
      animation: none;
    }
  }

  @keyframes hero-next {
    50% {
      transform: translateY(0.2rem);
    }
  }
</style>
