---
const audiences = [
  { word: 'BUILDERS', label: 'Builders', href: '#ai-build-night', colour: '#ff5b23' },
  { word: 'CASTS', label: 'Casts', href: '#offbooked', colour: '#f3e2b6' },
  { word: 'RIVALS', label: 'Rivals', href: '#parkdex', colour: '#7be0ae' },
  { word: 'CREATORS', label: 'Creators', href: '#play-by-the-sandbox', colour: '#f7c948' },
];
---

<section class="hero" data-hero data-track data-loops data-focus-at="0" data-audience="real people">
  <div class="hero__stage" data-stage>
    <canvas class="hero__crowd" data-crowd aria-hidden="true"></canvas>

    <div class="hero__copy">
      <p class="hero__name">Nathan Pannell</p>
      <h1>
        <span class="sr-only">Nathan Pannell builds things for real people.</span>
        <span aria-hidden="true">I build for</span>
      </h1>
      <p class="hero__fallback" aria-hidden="true">
        real people
      </p>
    </div>

    <div class="hero__foot">
      <ul class="hero__chips">
        {audiences.map((audience) => (
          <li>
            <a
              href={audience.href}
              data-word={audience.word}
              data-colour={audience.colour}
              style={`--chip: ${audience.colour}`}
            >
              {audience.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__block" data-block aria-hidden="true"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 240svh;
    background: var(--ink);
  }

  .hero__stage {
    position: sticky;
    top: 0;
    height: 100lvh;
    overflow: clip;
    touch-action: pan-y pinch-zoom;
  }

  .hero__crowd {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__copy {
    position: absolute;
    top: clamp(4.5rem, 12svh, 7.5rem);
    left: var(--gutter);
    right: var(--gutter);
    pointer-events: none;
    opacity: calc(1 - var(--p, 0) * 5);
  }

  .hero__name {
    margin-bottom: 0.4rem;
    color: #9da19e;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.7rem, 7.6vw, 6.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .hero__fallback {
    margin-top: 1rem;
    color: var(--signal);
    font-size: clamp(3.5rem, 15vw, 13rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  :global(.js) .hero__fallback {
    display: none;
  }

  .hero__foot {
    position: absolute;
    right: var(--gutter);
    bottom: calc(clamp(1.25rem, 5svh, 2.75rem) + 100lvh - 100svh);
    left: var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2.5rem;
    opacity: calc(1 - var(--p, 0) * 5);
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-right: clamp(2.5rem, 5vw, 4.5rem);
  }

  .hero__chips a {
    display: block;
    padding: 0.5rem 0.8rem;
    border: 1px solid #3a3e3f;
    border-radius: 99rem;
    color: #d6d6d0;
    font-family: var(--mono);
    font-size: 0.8rem;
    text-decoration: none;
    transition:
      background 200ms,
      border-color 200ms,
      color 200ms;
  }

  .hero__chips a[data-current] {
    border-color: var(--chip);
    background: var(--chip);
    color: var(--ink);
  }

  /* Starts as the AI Build Night wordmark's cursor and grows until it is the next screen. */
  .hero__block {
    position: absolute;
    right: var(--gutter);
    bottom: calc(clamp(1.4rem, 5.2svh, 3rem) + 100lvh - 100svh);
    width: 2vmax;
    height: 3.2vmax;
    background: var(--signal);
    transform-origin: 50% 50%;
    transform: scale(calc(1 + max(0, var(--p, 0) - 0.42) * 190));
    animation: blink 1.1s steps(2, jump-none) infinite;
  }

  /* Once it starts growing it is a surface, and a blinking surface would strobe the screen. */
  .hero__block[data-solid] {
    animation: none;
  }

  .hero[data-leaving] .hero__foot {
    pointer-events: none;
  }

  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  @media (max-width: 640px) {
    .hero {
      height: 210svh;
    }

    .hero__chips {
      margin-right: 2.25rem;
    }

    .hero__chips a {
      padding: 0.42rem 0.62rem;
      font-size: 0.74rem;
    }
  }

  @media (prefers-reduced-motion: reduce), (scripting: none) {
    .hero {
      height: auto;
    }

    .hero__stage {
      position: relative;
    }

    .hero__block {
      animation: none;
    }
  }
</style>
