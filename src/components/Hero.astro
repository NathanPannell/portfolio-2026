---
import Badge from './heroes/Badge.astro';
import Board from './heroes/Board.astro';
import Doors from './heroes/Doors.astro';
import Poster from './heroes/Poster.astro';
import Sentence from './heroes/Sentence.astro';
import { heroes } from './heroes/worlds';
---

<section class="hero" data-frame data-heroes data-audience="real people">
  <div class="hero__slot" data-hero-slot data-hero-shown="doors">
    <Doors />
  </div>

  <template data-hero-option="poster">
    <Poster />
  </template>
  <template data-hero-option="sentence">
    <Sentence />
  </template>
  <template data-hero-option="badge">
    <Badge />
  </template>
  <template data-hero-option="board">
    <Board />
  </template>

  <a class="hero__next" href="#ai-build-night" aria-label="Next: AI Build Night">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 4v15M5 12l7 7 7-7"></path>
    </svg>
  </a>

  <!-- A review tool for choosing a hero. See OPERATIONS.md for how to take it out. -->
  <nav class="hero-toggle" data-hero-toggle aria-label="Landing page options" hidden>
    <span class="hero-toggle__label">Hero</span>
    {heroes.map(({ id, name }, index) => (
      <button type="button" data-hero-pick={id} aria-label={`Option ${index + 1}: ${name}`}>
        {index + 1}
      </button>
    ))}
    <span class="hero-toggle__name" data-hero-name aria-live="polite"></span>
  </nav>
</section>

<style>
  .hero {
    position: relative;
    height: 100lvh;
    overflow: clip;
    background: var(--ink);
  }

  .hero__next {
    position: absolute;
    z-index: 5;
    right: var(--gutter);
    bottom: calc(0.85rem + 100lvh - 100svh);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--bone);
    color: var(--ink);
  }

  .hero__next svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.6;
  }

  .hero__next svg {
    animation: hero-next 1.8s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__next svg {
      animation: none;
    }
  }

  @keyframes hero-next {
    50% {
      transform: translateY(0.2rem);
    }
  }

  .hero-toggle {
    position: absolute;
    z-index: 6;
    bottom: calc(0.85rem + 100lvh - 100svh);
    left: var(--gutter);
    display: flex;
    gap: 0.2rem;
    align-items: center;
    padding: 0.25rem 0.75rem 0.25rem 0.8rem;
    border: 2px solid var(--ink);
    border-radius: 99rem;
    background: #fff;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.82rem;
    box-shadow: 0 0.35rem 1.2rem rgb(0 0 0 / 28%);
  }

  .hero-toggle[hidden] {
    display: none;
  }

  .hero-toggle__label {
    margin-right: 0.3rem;
    font-weight: 700;
  }

  .hero-toggle button {
    width: 2.35rem;
    height: 2.35rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    font-weight: 700;
  }

  .hero-toggle button[aria-pressed='true'] {
    background: var(--ink);
    color: #fff;
  }

  .hero-toggle__name {
    margin-left: 0.4rem;
    white-space: nowrap;
  }

  /* A phone has room for the numbers and the arrow, not the label. */
  @media (max-width: 520px) {
    .hero-toggle__label,
    .hero-toggle__name {
      display: none;
    }

    .hero-toggle {
      padding: 0.2rem 0.4rem;
    }
  }
</style>
