---
import { worlds } from './worlds';

const words = ['Nathan', 'Pannell'];
let letter = 0;
---

<div class="poster">
  <h1>
    <span class="sr-only">Nathan Pannell builds things for real people.</span>
    <span class="poster__name" aria-hidden="true">
      {words.map((word) => (
        <span class="poster__word">
          {[...word].map((character) => {
            letter += 1;
            return <span style={`--i: ${letter}`}>{character}</span>;
          })}
        </span>
      ))}
    </span>
    <span class="poster__line" aria-hidden="true">
      I build things for real people.
    </span>
  </h1>
  <ul class="poster__worlds">
    {worlds.map(({ name, href, colour, who }) => (
      <li>
        <a href={href} style={`--flood: ${colour}`}>
          <b>{name}</b>
          <span>{who}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .poster {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: end;
    gap: clamp(1rem, 4svh, 2.5rem);
    height: 100svh;
    overflow: clip;
    padding: 4rem var(--gutter) 5.25rem;
    background: var(--bone);
    color: var(--ink);
  }

  h1 {
    display: grid;
    gap: clamp(0.5rem, 2svh, 1.25rem);
    font-weight: 900;
  }

  .poster__name {
    display: flex;
    gap: 0 0.22em;
    font-size: min(12vw, 34svh);
    line-height: 0.86;
    letter-spacing: -0.055em;
  }

  .poster__word {
    display: flex;
    overflow: clip;
    padding-bottom: 0.08em;
  }

  .poster__word span {
    display: block;
  }

  .poster__line {
    color: var(--signal);
    font-size: min(6.6vw, 14svh);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .poster__worlds {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 1rem;
    border-top: 2px solid var(--ink);
  }

  .poster__worlds a {
    display: grid;
    padding: 0.7rem 0;
    text-decoration: none;
  }

  .poster__worlds b {
    font-size: clamp(1.05rem, 2vw, 1.7rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .poster__worlds span {
    font-family: var(--mono);
    font-size: 0.8rem;
  }

  /* Pointing at a project floods the whole poster in its colour. */
  .poster__worlds a::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--flood);
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms var(--ease);
  }

  .poster__worlds a:focus-visible::before {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .poster__worlds a:hover::before {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .poster__word span {
      animation: letter-up 700ms var(--ease) calc(var(--i) * 34ms + 80ms) both;
    }

    .poster__line {
      animation: line-in 700ms var(--ease) 650ms backwards;
    }

    .poster__worlds {
      /* Backwards only: a held transform would trap the flood inside this strip. */
      animation: line-in 700ms var(--ease) 850ms backwards;
    }
  }

  @keyframes letter-up {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @media (max-aspect-ratio: 1/1) {
    .poster__name {
      display: grid;
      gap: 0;
      font-size: min(24.2vw, 22svh);
    }

    .poster__line {
      font-size: min(13vw, 8svh);
      line-height: 0.98;
    }

    .poster__worlds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .poster__worlds a {
      padding: 0.45rem 0;
    }
  }
</style>
