---
import { worlds } from './worlds';
---

<div class="badge-room" data-badge-room>
  <div class="badge" data-badge>
    <i class="badge__strap" aria-hidden="true"></i>
    <i class="badge__clip" aria-hidden="true"></i>
    <div class="badge__card">
      <p class="badge__hello">
        <b>Hello</b> my name is
      </p>
      <h1>
        <span class="badge__name">Nathan Pannell</span>
        <span class="badge__line">I build things for real people.</span>
      </h1>
      <ul class="badge__stickers">
        {worlds.map(({ name, href, colour }, index) => (
          <li>
            <a href={href} style={`--c: ${colour}; --turn: ${index % 2 === 0 ? -2 : 2}deg`}>
              {name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .badge-room {
    position: relative;
    height: 100svh;
    overflow: clip;
    background:
      radial-gradient(rgb(14 17 19 / 9%) 1px, transparent 1.5px) 0 0 / 1.4rem 1.4rem,
      var(--signal);
    color: var(--ink);
  }

  /* Hangs from a point above the screen, and swings about it. */
  .badge {
    --width: min(84vw, calc((100svh - 9rem) * 0.98), 44rem);
    position: absolute;
    top: -8svh;
    left: calc(50% - var(--width) / 2);
    width: var(--width);
    padding-top: calc(8svh + 4.5rem);
    transform-origin: 50% 0;
    touch-action: pan-y pinch-zoom;
    cursor: grab;
    user-select: none;
    will-change: transform;
  }

  .badge:active {
    cursor: grabbing;
  }

  .badge__strap {
    position: absolute;
    top: 0;
    left: calc(50% - 1rem);
    width: 2rem;
    height: calc(8svh + 4.75rem);
    background: repeating-linear-gradient(0deg, #0e1113 0 0.6rem, #2b2f31 0.6rem 1.2rem);
  }

  .badge__clip {
    position: absolute;
    top: calc(8svh + 3.75rem);
    left: calc(50% - 1.5rem);
    z-index: 1;
    width: 3rem;
    height: 1.6rem;
    border: 3px solid var(--ink);
    border-radius: 0.4rem;
    background: #d8dad6;
  }

  .badge__card {
    position: relative;
    overflow: hidden;
    border: 3px solid var(--ink);
    border-radius: 1.4rem;
    background: #fffdf8;
    box-shadow: 0.6rem 0.8rem 0 rgb(14 17 19 / 32%);
  }

  .badge__hello {
    padding: 0.8rem 1rem 0.9rem;
    background: var(--ink);
    color: #fffdf8;
    font-family: var(--mono);
    font-size: clamp(0.8rem, 1.5svh, 1rem);
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .badge__hello b {
    display: block;
    font-family: var(--sans);
    font-size: clamp(2.2rem, 7.5svh, 4.2rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: none;
  }

  h1 {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: clamp(0.6rem, 2.4svh, 1.5rem) 1rem clamp(0.5rem, 1.6svh, 1rem);
    text-align: center;
  }

  .badge__name {
    font-family: 'Gaegu', 'Comic Sans MS', cursive;
    font-size: calc(var(--width) * 0.145);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    white-space: nowrap;
    rotate: -1.5deg;
  }

  .badge__line {
    font-size: clamp(1rem, calc(var(--width) * 0.052), 1.7rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .badge__stickers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
    padding: 0 0.75rem 1.1rem;
  }

  .badge__stickers a {
    display: block;
    padding: 0.3rem 0.8rem 0.35rem;
    border: 3px solid var(--ink);
    border-radius: 99rem;
    background: var(--c);
    color: var(--ink);
    font-size: clamp(0.92rem, calc(var(--width) * 0.04), 1.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
    rotate: var(--turn);
    transition: scale 160ms var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .badge__stickers a:hover {
      scale: 1.08;
    }
  }

  .badge__stickers a:focus-visible {
    outline-color: var(--ink);
  }
</style>
