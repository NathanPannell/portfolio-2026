---
import { worlds } from './worlds';

// Thin and thick bars, in a pattern that means nothing: it is only the look of a barcode.
const bars = [3, 1, 2, 1, 4, 1, 1, 3, 2, 2, 1, 4, 1, 2, 3, 1, 1, 2, 4, 1, 3, 1, 2, 2, 1, 3, 1, 4];
---

<div class="till">
  <i class="till__slot" aria-hidden="true"></i>
  <div class="receipt">
    <div class="receipt__paper">
      <h1>
        <span class="receipt__name">Nathan Pannell</span>
        <span class="receipt__line">builds things for real people</span>
      </h1>
      <p class="receipt__place" aria-hidden="true">
        Victoria, BC
      </p>
      <ul>
        {worlds.map(({ name, href, status }) => (
          <li>
            <a href={href}>
              <span class="receipt__item">{name}</span>
              <span class="receipt__status">{status}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="receipt__total" aria-hidden="true">
        <span>Items</span>
        <span>4</span>
      </p>
      <p class="receipt__thanks" aria-hidden="true">
        All of it is live. Thank you!
      </p>
      <p class="receipt__bars" aria-hidden="true">
        {bars.map((bar) => (
          <i style={`--w: ${bar}`} />
        ))}
      </p>
    </div>
  </div>
</div>

<style>
  .till {
    --type: min(4vw, 2.15svh);
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    height: 100svh;
    overflow: clip;
    padding-top: 2.5rem;
    background:
      radial-gradient(rgb(14 17 19 / 9%) 1px, transparent 1.5px) 0 0 / 1.2rem 1.2rem,
      #ffc83d;
    color: #16181a;
  }

  /* The slot it prints from. */
  .till__slot {
    position: relative;
    z-index: 2;
    width: min(calc(var(--type) * 26), 92vw);
    height: 0.9rem;
    border-radius: 0.5rem;
    background: #16181a;
    box-shadow: 0 0.2rem 0 rgb(14 17 19 / 30%);
  }

  .receipt {
    overflow: clip;
    width: min(calc(var(--type) * 23.5), 86vw);
    margin-top: -0.45rem;
    padding-bottom: 1.2rem;
  }

  /* The zigzag along the torn end is cut with two mirrored gradients. */
  .receipt__paper {
    --tooth: 0.7rem;
    display: grid;
    gap: calc(var(--type) * 0.75);
    padding: calc(var(--type) * 1.5) calc(var(--type) * 1.5) calc(var(--type) * 1.6);
    background: #fffdf4;
    filter: drop-shadow(0 0.35rem 0.35rem rgb(14 17 19 / 30%));
    font-family: var(--mono);
    font-size: var(--type);
    line-height: 1.25;
    mask:
      linear-gradient(#000, #000) top / 100% calc(100% - var(--tooth)) no-repeat,
      conic-gradient(from -45deg at 50% 100%, #000 90deg, transparent 0) bottom /
        calc(var(--tooth) * 2) var(--tooth) repeat-x;
  }

  h1 {
    display: grid;
    gap: 0.15em;
    font-size: 1em;
    text-align: center;
  }

  .receipt__name {
    font-size: 2em;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .receipt__line {
    font-size: 1em;
    font-weight: 500;
  }

  .receipt__place {
    margin-top: -0.5em;
    text-align: center;
  }

  ul {
    border-block: 2px dashed #16181a;
    padding-block: 0.3em;
  }

  a {
    display: flex;
    gap: 1em;
    justify-content: space-between;
    padding: 0.42em 0.25em;
    color: inherit;
    text-decoration: none;
  }

  .receipt__item {
    font-weight: 800;
  }

  .receipt__status {
    text-align: right;
  }

  a:focus-visible {
    outline-color: #16181a;
    outline-offset: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      background: #16181a;
      color: #fffdf4;
    }
  }

  .receipt__total {
    display: flex;
    justify-content: space-between;
    font-weight: 800;
  }

  .receipt__thanks {
    text-align: center;
  }

  .receipt__bars {
    display: flex;
    gap: 2px;
    justify-content: center;
    height: calc(var(--type) * 2.6);
  }

  .receipt__bars i {
    width: calc(var(--w) * 2px);
    background: #16181a;
  }

  @media (prefers-reduced-motion: no-preference) {
    .receipt__paper {
      animation: print 1.5s steps(24, end) 200ms both;
    }
  }

  @keyframes print {
    from {
      transform: translateY(-100%);
    }
  }

  /* Phones: the status drops under each name, so a small screen still gets it all. */
  @media (max-aspect-ratio: 1/1) and (max-width: 520px) {
    .till {
      --type: min(3.5vw, 1.9svh);
    }

    .receipt__status {
      font-size: 0.9em;
    }
  }

  /* Phones on their side have room for the name and the list, and not the tail of the slip. */
  @media (max-height: 480px) {
    .till {
      --type: 3.3svh;
      padding-top: 2.25rem;
    }

    .till__slot {
      width: 34rem;
    }

    .receipt {
      width: 31rem;
    }

    .receipt__paper {
      gap: 0.35em;
      padding-block: 0.8em 1.1em;
    }

    .receipt__name {
      font-size: 1.6em;
    }

    .receipt__place,
    .receipt__total,
    .receipt__thanks,
    .receipt__bars {
      display: none;
    }
  }
</style>
