---
import { worlds } from './worlds';
---

<div class="sentence" data-sentence>
  <h1 class="sr-only">Nathan Pannell builds things for real people.</h1>
  <div class="sentence__type" aria-hidden="true">
    <p class="sentence__hi">Hi, I’m Nathan Pannell.</p>
    <p class="sentence__line">
      <span class="sentence__lead">I build</span>
      <span class="sentence__clause">
        <span data-clause>things for real people.</span>
        <i></i>
      </span>
    </p>
  </div>
  <ul class="sentence__worlds">
    {worlds.map(({ name, href, colour, clause }) => (
      <li>
        <a href={href} data-clause-of={clause} data-colour={colour} style={`--c: ${colour}`}>
          {name}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .sentence {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem;
    height: 100svh;
    overflow: clip;
    padding: 4.25rem var(--gutter) 5.25rem;
    background: var(--ink);
    color: var(--bone);
  }

  .sentence__type {
    display: grid;
    gap: clamp(0.75rem, 3svh, 2rem);
    align-content: center;
  }

  .sentence__hi {
    font-size: min(3.4vw, 6svh);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #b6b9b6;
  }

  .sentence__line {
    /* Tall enough for the longest clause, so the page doesn't jump as they swap. */
    min-height: 3em;
    font-size: min(9.6vw, 20svh);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .sentence__lead {
    display: block;
  }

  .sentence__clause {
    color: var(--clause, var(--signal));
    transition: color 200ms;
  }

  .sentence__clause i {
    display: inline-block;
    width: 0.38em;
    height: 0.72em;
    margin-left: 0.07em;
    background: var(--signal);
    vertical-align: -0.04em;
    animation: blink 1.1s steps(2, jump-none) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }

  .sentence__worlds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .sentence__worlds a {
    display: block;
    padding: 0.5rem 0.85rem;
    border: 1px solid #454a4b;
    border-radius: 99rem;
    color: #e4e3dd;
    font-family: var(--mono);
    font-size: 0.85rem;
    text-decoration: none;
    transition:
      background 200ms,
      border-color 200ms,
      color 200ms;
  }

  .sentence__worlds a[data-current] {
    border-color: var(--c);
    background: var(--c);
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .sentence__worlds a:hover {
      border-color: var(--c);
      background: var(--c);
      color: var(--ink);
    }
  }

  @media (max-aspect-ratio: 1/1) {
    .sentence__hi {
      font-size: min(7vw, 4svh);
    }

    .sentence__line {
      min-height: 4em;
      font-size: min(15vw, 10svh);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sentence__clause i {
      animation: none;
    }
  }
</style>
