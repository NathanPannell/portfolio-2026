---
import { worlds } from './worlds';

// One still from each. These only load if this option is picked, because it sits in a template.
const pictures = [
  { src: '/media/build-night/live-1.webp', alt: '', fit: 'site', tint: '#f5f4f0' },
  { src: '/media/offbooked/play-640.webp', alt: '', fit: 'phone', tint: '#a8382a' },
  { src: '/media/parkdex/arrival-640.webp', alt: '', fit: 'phone', tint: '#2f7a58' },
  { src: '/media/sandbox/site-800.webp', alt: '', fit: 'site', tint: '#cdb7d9' },
];
---

<div class="channels" data-channels>
  <h1>
    Nathan Pannell builds things <span>for real people.</span>
  </h1>

  <div class="tv">
    <div class="tv__screen" aria-hidden="true">
      {pictures.map(({ src, alt, fit, tint }, index) => (
        <div class={`tv__picture tv__picture--${fit}`} style={`--tint: ${tint}`} data-picture>
          <img src={src} alt={alt} />
          <p class="tv__ident">{`CH ${index + 1}`}</p>
        </div>
      ))}
      <i class="tv__static"></i>
    </div>

    <ol class="tv__dial">
      {worlds.map(({ name, href, colour }, index) => (
        <li>
          <a href={href} style={`--lit: ${colour}`} data-channel>
            <span class="tv__number" aria-hidden="true">
              {index + 1}
            </span>
            <span class="tv__name">{name}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  .channels {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: clamp(0.5rem, 2.5svh, 1.75rem);
    height: 100svh;
    overflow: clip;
    padding: 3.25rem var(--gutter) 4.5rem;
    background: #143b46;
    color: #f7efdc;
  }

  h1 {
    max-width: 30ch;
    font-size: min(4.2vw, 7.4svh);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  h1 span {
    display: inline-block;
    color: #ffc83d;
  }

  /* A wood-cased set: the screen, and a dial of four channels down the side. */
  .tv {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 22vw);
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    align-self: center;
    justify-self: center;
    width: min(100%, calc((100svh - 13rem) * 2));
    max-height: 100%;
    padding: clamp(0.75rem, 1.6vw, 1.25rem);
    border: 3px solid #0e1113;
    border-radius: 1.6rem;
    background: linear-gradient(170deg, #8a5a33, #5e3a1e);
    box-shadow:
      inset 0 2px 2px rgb(255 255 255 / 22%),
      0 1.2rem 2.2rem rgb(0 0 0 / 42%);
  }

  .tv__screen {
    position: relative;
    aspect-ratio: 8 / 5;
    overflow: hidden;
    border: 3px solid #0e1113;
    border-radius: 1.4rem / 1.8rem;
    background: #0e1113;
    box-shadow: inset 0 0 2.5rem rgb(0 0 0 / 55%);
  }

  .tv__picture {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--tint);
    opacity: 0;
  }

  .tv__picture:first-child,
  .tv__picture[data-on] {
    opacity: 1;
  }

  [data-channels][data-tuning] .tv__picture:first-child:not([data-on]) {
    opacity: 0;
  }

  .tv__picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  /* An app stands up in the middle of its own colour, cropped to the top of the phone's screen. */
  .tv__picture--phone img {
    width: auto;
    height: 136%;
    margin-top: 18%;
    max-width: none;
    border: 0.4rem solid #161514;
    border-radius: 1.2rem;
    object-fit: contain;
  }

  .tv__ident {
    position: absolute;
    top: 0.6rem;
    right: 0.9rem;
    color: #7dff9b;
    font-family: var(--mono);
    font-size: clamp(0.9rem, 1.8vw, 1.5rem);
    font-weight: 700;
    text-shadow:
      0 0 0.4em #29c352,
      0 1px 2px #000;
  }

  /* Scanlines all the time. Snow only for the moment between channels. */
  .tv__screen::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(transparent 0 2px, rgb(0 0 0 / 12%) 2px 4px);
    pointer-events: none;
  }

  .tv__static {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(12deg, #fff 0 1px, #333 1px 3px, #999 3px 4px),
      repeating-linear-gradient(97deg, rgb(0 0 0 / 60%) 0 2px, transparent 2px 5px);
    opacity: 0;
  }

  .tv__static[data-on] {
    animation: snow 170ms steps(3, end);
  }

  @keyframes snow {
    from {
      opacity: 0.95;
    }

    to {
      opacity: 0.4;
    }
  }

  .tv__dial {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 0.45rem;
    list-style: none;
  }

  .tv__dial a {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    height: 100%;
    padding: 0.3rem 0.7rem;
    border: 2px solid #0e1113;
    border-radius: 0.7rem;
    background: linear-gradient(#e7dcc1, #cbbd9b);
    box-shadow: 0 0.2rem 0 #0e1113;
    color: #0e1113;
    font-size: clamp(0.95rem, min(1.5vw, 2.8svh), 1.35rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .tv__dial a[data-on] {
    background: var(--lit);
  }

  .tv__dial a:focus-visible {
    outline-color: #fff;
  }

  .tv__number {
    flex: none;
    font-family: var(--mono);
    font-size: 1.15em;
  }

  /* Phones and tall screens: the set stands up, with its dial under the screen. */
  @media (max-aspect-ratio: 1/1) {
    h1 {
      font-size: min(9vw, 6svh);
    }

    .tv {
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
    }

    .tv__dial {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
    }

    .tv__dial a {
      min-height: clamp(2.4rem, 6.4svh, 3.6rem);
      font-size: clamp(1rem, 4.6vw, 1.5rem);
    }
  }

  /* Phones on their side: the words beside a smaller set. */
  @media (max-height: 480px) {
    .channels {
      grid-template-rows: none;
      grid-template-columns: minmax(0, 2fr) minmax(0, 7fr);
      align-items: center;
      padding-block: 2.5rem 3.75rem;
    }

    h1 {
      font-size: 7.4svh;
    }

    .tv {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      width: 100%;
      padding: 0.5rem;
    }

    .tv__dial a {
      font-size: 0.85rem;
    }
  }
</style>
