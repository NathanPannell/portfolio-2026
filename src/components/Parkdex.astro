---
const stops = [
  {
    image: 'arrival',
    title: 'Go to a park.',
    alt: 'Parkdex map of Beacon Hill Park: inside the boundary, with a flag to take',
    flag: ['#1fa08d', '#2b2455'],
  },
  {
    image: 'planted',
    title: 'Plant your flag.',
    alt: 'Parkdex flag planted screen: plus six points',
    flag: ['#7a3fb0', '#1fa08d'],
  },
  {
    image: 'founder',
    title: 'Be the founder.',
    alt: 'Parkdex park page for Holland Point with a Become the founder button',
    flag: ['#f7c948', '#e0483a'],
  },
  {
    image: 'take',
    title: 'Steal it.',
    alt: 'Parkdex screen: a flag being knocked over, reading Take it from at salish sky',
    flag: ['#e0483a', '#f7c948'],
  },
];
---

<section id="parkdex" class="pk" data-audience="rivals" aria-labelledby="pk-title">
  <div class="pk-trip" data-frame data-moment data-trip data-loops tabindex="-1">
    <div class="pk-back" aria-hidden="true">
      <div class="pk-layer pk-layer--far" data-layer="0.12"></div>
      <div class="pk-layer pk-layer--mid" data-layer="0.3"></div>
    </div>

    <div class="pk-world" data-world>
      <div class="pk-vine" data-vine aria-hidden="true"></div>

      <div class="pk-sky">
        <i class="pk-cloud pk-cloud--one" aria-hidden="true"></i>
        <i class="pk-cloud pk-cloud--two" aria-hidden="true"></i>
        <h2 id="pk-title">Capture the flag, for real parks.</h2>
      </div>

      <div class="pk-canopy" aria-hidden="true"></div>

      <div class="pk-forest" data-forest-floor>
        <ol class="pk-stops">
          {stops.map((stop, index) => (
            <li class="pk-stop" data-stop style={`--stop: ${index}`}>
              <h3>{stop.title}</h3>
              <figure class="pk-hang">
                <div
                  class="pk-pole"
                  style={`--a: ${stop.flag[0]}; --b: ${stop.flag[1]}`}
                  aria-hidden="true"
                >
                  <i />
                </div>
                <img
                  src={`/media/parkdex/${stop.image}-360.webp`}
                  srcset={`/media/parkdex/${stop.image}-360.webp 360w, /media/parkdex/${stop.image}-640.webp 640w`}
                  sizes="(max-width: 760px) 40vw, 19rem"
                  width="640"
                  height="1385"
                  loading="lazy"
                  decoding="async"
                  alt={stop.alt}
                />
              </figure>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="pk-layer pk-layer--near" data-layer="1.5" aria-hidden="true"></div>

    <p class="pk-score" aria-hidden="true">
      <i class="flagmark"></i>
      <b data-score>0</b>
    </p>

    <div class="pk-rider" data-rider aria-hidden="true">
      <span class="pk-rider__say">KLEEP!</span>
      <img
        data-pose
        data-on
        src="/media/parkdex/kip-wave.webp"
        width="360"
        height="360"
        loading="lazy"
        alt=""
      />
      <img
        data-pose
        src="/media/parkdex/kip-point.webp"
        width="360"
        height="360"
        loading="lazy"
        alt=""
      />
    </div>

    <button
      class="pk-plant"
      type="button"
      data-moment-control
      aria-expanded="false"
      aria-label="Plant your flag and ride the vine down"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 21V3h13l-3 4.5 3 4.5H6"></path>
      </svg>
      <span>Plant!</span>
    </button>
  </div>

  <div class="pk-ground" data-frame>
    <svg class="pk-hill" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 220V120C220 30 460 20 720 70s520 70 720-20v170z"></path>
    </svg>
    <div class="pk-end">
      <img
        class="pk-end__kip"
        src="/media/parkdex/kip-cheer.webp"
        width="360"
        height="360"
        loading="lazy"
        alt=""
      />
      <h3>1,000+ parks. Which one’s yours?</h3>
      <div class="pk-end__links">
        <a
          class="pk-btn pk-btn--main"
          href="https://play.google.com/store/apps/details?id=app.parkdex"
        >
          Get it on Google Play
        </a>
        <a class="pk-btn" href="https://parkdex.app/">
          parkdex.app ↗
        </a>
        <a class="pk-btn" href="https://web.parkdex.app/">
          Open the web app ↗
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .pk {
    --ink: #142620;
    --orange: #ff5a1f;
    --cream: #fff7e8;
    --yellow: #ffc83d;
    --forest: #1f6448;
    --floor: #16452f;
    --bar: calc(100lvh - 100svh);
    position: relative;
    color: var(--ink);
    font-family: 'Bricolage Grotesque Variable', var(--sans);
  }

  /* With no script the trip is plain page content, top to bottom. The script makes it a stage. */
  .pk-trip {
    position: relative;
    background: var(--forest);
  }

  .pk-trip:focus {
    outline: none;
  }

  .pk-trip[data-waiting],
  .pk-trip[data-open] {
    height: 100lvh;
    overflow: clip;
  }

  .pk-back,
  .pk-layer--near,
  .pk-rider,
  .pk-score,
  .pk-plant {
    display: none;
  }

  .pk-trip[data-waiting] .pk-back,
  .pk-trip[data-open] .pk-back {
    position: absolute;
    inset: 0;
    display: block;
    overflow: clip;
    background: linear-gradient(#3f9a72, #1f6a4c);
  }

  /* A little dusk over the trees, so the stops stand out. */
  .pk-back::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #0d3024;
    opacity: 0.3;
  }

  .pk-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 200%;
    background-repeat: repeat;
    will-change: transform;
    pointer-events: none;
  }

  .pk-layer--far {
    background-image: url('../art/parkdex/far.svg');
    background-position: center top;
    background-size: max(100%, 62rem) 50%;
  }

  .pk-layer--mid {
    background-image: url('../art/parkdex/mid.svg');
    background-position: center top;
    background-size: max(100%, 56rem) 50%;
  }

  /* Foreground leaves whip past on the ride, and are gone by the time Kip lands. */
  .pk-trip[data-riding] .pk-layer--near {
    display: block;
    z-index: 3;
    animation: leaves 2800ms ease-in-out both;
  }

  @keyframes leaves {
    0%,
    30% {
      opacity: 0;
    }

    50%,
    80% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  .pk-layer--near::before,
  .pk-layer--near::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1rem;
    width: clamp(4rem, 10vw, 10rem);
    background: url('../art/parkdex/near.svg') left top / 100% 50% repeat-y;
  }

  .pk-layer--near::after {
    right: -1rem;
    left: auto;
    scale: -1 1;
  }

  .pk-world {
    position: relative;
    --vine-x: 50%;
    --vine-width: clamp(14rem, 23vw, 21.5rem);
  }

  .pk-trip[data-waiting] .pk-world,
  .pk-trip[data-open] .pk-world {
    position: absolute;
    inset: 0 0 auto;
    will-change: transform;
  }

  .pk-vine {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    left: calc(var(--vine-x) - var(--vine-width) / 2);
    width: var(--vine-width);
    background: url('../art/parkdex/vine.svg') center top / 100% auto repeat-y;
  }

  .pk-sky {
    position: relative;
    display: grid;
    align-content: center;
    height: 100lvh;
    padding: 5rem var(--gutter) calc(2rem + var(--bar));
    overflow: clip;
    background: linear-gradient(#cdeeff, #eaf7ff);
  }

  h2 {
    position: relative;
    z-index: 2;
    max-width: 42vw;
    font-size: clamp(3rem, min(7.4vw, 15svh), 7rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .pk-cloud {
    position: absolute;
    width: 22rem;
    height: 7rem;
    border-radius: 99rem;
    background: #fff;
    box-shadow:
      5rem -2.4rem 0 0.4rem #fff,
      11rem -1.1rem 0 -0.5rem #fff;
    animation: drift 26s ease-in-out infinite alternate;
  }

  .pk-cloud--one {
    top: 26%;
    right: 3%;
  }

  .pk-cloud--two {
    top: 66%;
    right: 24%;
    scale: 0.6;
    animation-duration: 34s;
    animation-direction: alternate-reverse;
  }

  @keyframes drift {
    to {
      translate: -5rem 0;
    }
  }

  /* The solid band of leaves hides the moment the sky gives way to the forest. */
  .pk-canopy {
    height: 110lvh;
    background: url('../art/parkdex/canopy.svg') center / cover no-repeat;
  }

  .pk-forest {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: center;
    min-height: 100svh;
    padding: 4.5rem var(--gutter) 1.5rem;
  }

  .pk-trip[data-waiting] .pk-forest,
  .pk-trip[data-open] .pk-forest {
    height: 100lvh;
    padding-bottom: calc(1.5rem + var(--bar));
  }

  /* Four phones in a row, each sized from whichever runs out first, the width or the height. */
  .pk-stops {
    --shot: min(calc((100vw - var(--gutter) * 2 - 6rem) / 4), calc((100svh - 11rem) * 0.4624));
    display: flex;
    gap: 2rem;
    align-items: start;
    justify-content: center;
  }

  .pk-stop {
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    width: var(--shot);
  }

  .pk-stop:nth-child(even) {
    margin-top: 1.5rem;
  }

  /* The phones drop in on the vine one by one, once Kip has landed. */
  .pk-trip:not([data-landed])[data-waiting] .pk-stop,
  .pk-trip:not([data-landed])[data-open] .pk-stop {
    visibility: hidden;
    transform: translate3d(0, -110lvh, 0) rotate(6deg);
  }

  .pk-trip[data-landed]:not([data-settled]) .pk-stop {
    transition: transform 760ms cubic-bezier(0.2, 1.3, 0.4, 1) calc(var(--stop) * 260ms);
  }

  h3 {
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .pk-stop h3 {
    padding: 0.25rem 0.7rem 0.35rem;
    border: 3px solid var(--ink);
    border-radius: 0.8rem;
    background: var(--cream);
    box-shadow: 0 0.25rem 0 var(--ink);
    font-size: clamp(0.9rem, min(1.75vw, 3.1svh), 1.7rem);
    line-height: 1;
    white-space: nowrap;
    rotate: -2deg;
  }

  .pk-stop:nth-child(even) h3 {
    rotate: 2deg;
  }

  .pk-hang {
    position: relative;
    transform-origin: 50% -2rem;
    animation: swing 3.4s ease-in-out infinite alternate;
  }

  .pk-stop:nth-child(even) .pk-hang {
    animation-delay: -1.4s;
  }

  @keyframes swing {
    from {
      transform: rotate(-1.8deg);
    }

    to {
      transform: rotate(1.8deg);
    }
  }

  .pk-hang img {
    position: relative;
    width: var(--shot);
    border: 0.3rem solid var(--ink);
    border-radius: 1.6rem;
    box-shadow: 0.35rem 0.35rem 0 var(--ink);
  }

  .pk-pole {
    position: absolute;
    z-index: 2;
    top: -0.5rem;
    right: 0.6rem;
    width: 0.4rem;
    height: 3.4rem;
    border: 2px solid var(--ink);
    border-radius: 0.3rem;
    background: var(--cream);
    transform-origin: 50% 100%;
  }

  .pk-trip:not([data-landed])[data-waiting] .pk-pole,
  .pk-trip:not([data-landed])[data-open] .pk-pole {
    transform: scaleY(0);
  }

  .pk-trip[data-landed]:not([data-settled]) .pk-pole {
    transition: transform 500ms cubic-bezier(0.2, 1.5, 0.4, 1) calc(var(--stop) * 260ms + 500ms);
  }

  .pk-pole i {
    position: absolute;
    top: 0.1rem;
    right: 100%;
    width: 2.6rem;
    height: 1.8rem;
    border: 3px solid var(--ink);
    background: linear-gradient(90deg, var(--a) 50%, var(--b) 50%);
    transform-origin: 100% 50%;
    animation: wave 1.5s ease-in-out infinite alternate;
  }

  @keyframes wave {
    to {
      transform: skewY(-7deg) scaleX(0.94);
    }
  }

  .pk-ground {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 100lvh;
    padding: clamp(4.5rem, 10vw, 8rem) var(--gutter) calc(2rem + var(--bar));
    color: var(--cream);
    background: linear-gradient(var(--forest) clamp(3rem, 8vw, 6rem), var(--floor) 0);
  }

  .pk-hill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: clamp(3rem, 8vw, 6rem);
    fill: var(--floor);
  }

  .pk-end {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .pk-end__kip {
    width: clamp(8rem, min(15vw, 26svh), 13rem);
    animation: hop 1s ease-in-out infinite alternate;
  }

  @keyframes hop {
    to {
      translate: 0 -0.8rem;
    }
  }

  .pk-end h3 {
    max-width: 14ch;
    font-size: clamp(2.8rem, min(7vw, 13svh), 6.5rem);
    line-height: 0.95;
  }

  .pk-end__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  .pk-btn {
    display: inline-block;
    padding: 0.7rem 1.1rem;
    border: 3px solid var(--ink);
    border-radius: 99rem;
    background: var(--cream);
    box-shadow: 0 0.3rem 0 var(--ink);
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 120ms,
      box-shadow 120ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .pk-btn:hover {
      transform: translateY(0.15rem);
      box-shadow: 0 0.15rem 0 var(--ink);
    }
  }

  .pk-btn--main {
    background: var(--orange);
  }

  .pk-trip[data-waiting] .pk-score,
  .pk-trip[data-open] .pk-score {
    position: absolute;
    z-index: 4;
    top: 3.4rem;
    right: var(--gutter);
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.3rem 0.9rem 0.3rem 0.5rem;
    border: 3px solid var(--ink);
    border-radius: 99rem;
    background: var(--cream);
    box-shadow: 0 0.25rem 0 var(--ink);
  }

  .pk-score b {
    font-size: 1.3rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .flagmark {
    width: 1.9rem;
    height: 1.3rem;
    border: 2px solid var(--ink);
    border-radius: 0.15rem;
    background: linear-gradient(90deg, #7a3fb0 50%, #1fa08d 50%);
  }

  /* Holds Kip on the vine's line, a little above the middle of the screen. */
  .pk-rider {
    --size: clamp(6.5rem, 11vw, 10rem);
    position: absolute;
    z-index: 2;
    top: 38%;
    left: calc(50% - var(--size) * 0.72);
    width: var(--size);
    height: var(--size);
    transition: opacity 240ms;
  }

  .pk-trip[data-waiting] .pk-rider,
  .pk-trip[data-open] .pk-rider {
    display: block;
  }

  .pk-trip[data-landed] .pk-rider {
    opacity: 0;
  }

  .pk-rider img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 120ms;
  }

  .pk-rider img[data-on] {
    opacity: 1;
  }

  .pk-rider__say {
    position: absolute;
    bottom: 96%;
    left: -12%;
    padding: 0.25rem 0.7rem;
    border: 3px solid var(--ink);
    border-radius: 0.9rem;
    background: var(--cream);
    box-shadow: 0 0.2rem 0 var(--ink);
    font-size: 0.95rem;
    font-weight: 800;
    white-space: nowrap;
  }

  /* The one big button, and the point of the game: plant it. */
  .pk-plant {
    position: absolute;
    z-index: 3;
    top: calc(50svh - 4.25rem);
    left: calc(50% + clamp(6rem, 13vw, 11rem));
    justify-items: center;
    width: 8.5rem;
    height: 8.5rem;
    padding: 1.15rem 0 0;
    border: 5px solid var(--ink);
    border-radius: 50%;
    background: var(--orange);
    box-shadow:
      0 0 0 5px var(--cream),
      0 0.65rem 0 5px var(--ink);
    color: var(--cream);
    transition:
      transform 100ms,
      box-shadow 100ms;
  }

  .pk-trip[data-waiting] .pk-plant {
    display: grid;
    animation: beckon 2.2s ease-in-out infinite;
  }

  .pk-trip[data-open]:not([data-settled]) .pk-plant {
    display: grid;
    pointer-events: none;
    animation: planted 520ms var(--ease) forwards;
  }

  @keyframes beckon {
    0%,
    70%,
    100% {
      scale: 1;
    }

    80% {
      scale: 1.07;
    }

    90% {
      scale: 0.98;
    }
  }

  @keyframes planted {
    20% {
      transform: translateY(0.65rem) scale(0.94);
    }

    100% {
      visibility: hidden;
      opacity: 0;
      transform: translateY(0.65rem) scale(0.2);
    }
  }

  .pk-plant:active {
    transform: translateY(0.45rem);
    box-shadow:
      0 0 0 5px var(--cream),
      0 0.2rem 0 5px var(--ink);
  }

  .pk-plant svg {
    width: 3.2rem;
    height: 3.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .pk-plant span {
    margin-top: -0.2rem;
    padding: 0 0.7rem;
    border: 2px solid var(--ink);
    border-radius: 99rem;
    background: var(--yellow);
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 800;
  }

  :global(.pk-mark) {
    position: absolute;
    width: 3.2rem;
    height: 3.6rem;
    margin-top: -3.6rem;
    border-left: 0.32rem solid #142620;
    animation: sprout 420ms cubic-bezier(0.2, 1.6, 0.4, 1);
    transform-origin: 0 100%;
  }

  :global(.pk-mark)::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3rem;
    height: 2rem;
    border: 2px solid #142620;
    background: var(--flag);
  }

  :global(.pk-points) {
    position: absolute;
    z-index: 4;
    top: 26%;
    left: 50%;
    color: #fff1b8;
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    -webkit-text-stroke: 2px #142620;
    pointer-events: none;
    animation: rise 900ms ease-out forwards;
  }

  @keyframes sprout {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes rise {
    to {
      opacity: 0;
      transform: translateY(-5rem) scale(1.25);
    }
  }

  /* On a phone the vine runs down the left, and the stops sit two by two. */
  @media (max-width: 760px) {
    .pk-world {
      --vine-x: 17%;
      --vine-width: 10rem;
    }

    .pk-sky {
      padding-left: 32%;
    }

    /* Fewer big moving layers for a phone to hold in memory: the mid trees carry the depth here, and
       the vine has this side, so only the far edge keeps its leaves. */
    .pk-layer--far,
    .pk-layer--near::before {
      display: none;
    }

    .pk-layer--near {
      right: 0;
      left: auto;
      width: 4rem;
    }

    h2 {
      max-width: none;
      font-size: clamp(2.7rem, 12.5vw, 4.5rem);
    }

    .pk-cloud {
      scale: 0.5;
    }

    .pk-cloud--one {
      top: 12%;
      right: -10rem;
    }

    .pk-cloud--two {
      top: 84%;
      right: -6rem;
    }

    .pk-forest {
      padding: 5.5rem 0.75rem 1rem;
    }

    .pk-trip[data-waiting] .pk-forest,
    .pk-trip[data-open] .pk-forest {
      padding-bottom: calc(1rem + var(--bar));
    }

    .pk-stops {
      --shot: min(calc((100vw - 3.5rem) / 2), calc((100svh - 14rem) / 2 * 0.4624));
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
    }

    .pk-stop {
      gap: 0.45rem;
    }

    .pk-stop:nth-child(even) {
      margin-top: 0;
    }

    .pk-stop h3 {
      font-size: 0.95rem;
    }

    .pk-hang img {
      border-width: 0.22rem;
      border-radius: 1.05rem;
      box-shadow: 0.22rem 0.22rem 0 var(--ink);
    }

    .pk-pole {
      height: 2.6rem;
    }

    .pk-pole i {
      width: 2rem;
      height: 1.4rem;
    }

    .pk-rider {
      --size: 4.75rem;
      top: 44%;
      left: calc(17% - var(--size) * 0.5);
    }

    .pk-rider__say {
      display: none;
    }

    .pk-trip[data-waiting] .pk-score,
    .pk-trip[data-open] .pk-score {
      top: 2.9rem;
    }

    .pk-plant {
      top: auto;
      right: var(--gutter);
      bottom: calc(2rem + var(--bar));
      left: auto;
      width: 7rem;
      height: 7rem;
      padding-top: 0.85rem;
    }

    .pk-plant svg {
      width: 2.6rem;
      height: 2.6rem;
    }
  }

  /* Phones on their side: four across, with just enough room for each title. */
