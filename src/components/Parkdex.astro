---
const stops = [
  {
    image: 'arrival',
    title: 'Go to a park.',
    alt: 'Parkdex map of Beacon Hill Park: inside the boundary, with a flag to take',
    flag: ['#1fa08d', '#2b2455'],
  },
  {
    image: 'planted',
    title: 'Plant your flag.',
    alt: 'Parkdex flag planted screen: plus six points',
    flag: ['#7a3fb0', '#1fa08d'],
  },
  {
    image: 'founder',
    title: 'Be the founder.',
    alt: 'Parkdex park page for Holland Point with a Become the founder button',
    flag: ['#f7c948', '#e0483a'],
  },
  {
    image: 'take',
    title: 'Steal it.',
    alt: 'Parkdex screen: a flag being knocked over, reading Take it from at salish sky',
    flag: ['#e0483a', '#f7c948'],
  },
];
---

<svg class="pk-rise" viewBox="0 0 1440 170" preserveAspectRatio="none" aria-hidden="true">
  <path d="M0 170V96c60-44 150-40 196 4 50-62 164-72 222-8 44-40 130-44 176 2 64-74 196-70 250 8 52-46 150-44 192 6 58-52 164-48 214 6 40-34 116-36 190-12v164z"></path>
</svg>

<section id="parkdex" class="pk" data-audience="rivals" aria-labelledby="pk-title">
  <div class="pk-trip" data-track data-descent data-loops>
    <div class="pk-back" aria-hidden="true">
      <div class="pk-layer pk-layer--far" data-layer="0.12"></div>
      <div class="pk-layer pk-layer--mid" data-layer="0.3"></div>
    </div>

    <div class="pk-front" data-front>
      <div class="pk-layer pk-layer--near" data-layer="1.5" aria-hidden="true"></div>

      <p class="pk-score" aria-hidden="true">
        <i class="flagmark"></i>
        <b data-score>0</b>
      </p>

      <div class="pk-rider" data-rider aria-hidden="true">
        <span class="pk-rider__say" data-kip>
          KLEEP!
        </span>
        <img
          data-pose
          data-on
          src="/media/parkdex/kip-wave.webp"
          width="360"
          height="360"
          loading="lazy"
          alt=""
        />
        <img
          data-pose
          src="/media/parkdex/kip-point.webp"
          width="360"
          height="360"
          loading="lazy"
          alt=""
        />
      </div>

      <button class="pk-plant" type="button" data-plant>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 21V3h13l-3 4.5 3 4.5H6"></path>
        </svg>
        <span>Plant!</span>
      </button>
    </div>

    <div class="pk-route">
      <div class="pk-vine" data-vine aria-hidden="true"></div>

      <div class="pk-sky">
        <i class="pk-cloud pk-cloud--one" aria-hidden="true"></i>
        <i class="pk-cloud pk-cloud--two" aria-hidden="true"></i>
        <h2 id="pk-title">Capture the flag, for real parks.</h2>
      </div>

      <div class="pk-canopy" data-canopy aria-hidden="true"></div>

      {stops.map((stop) => (
        <article class="pk-stop" data-stop>
          <h3>{stop.title}</h3>
          <figure class="pk-hang">
            <div
              class="pk-pole"
              style={`--a: ${stop.flag[0]}; --b: ${stop.flag[1]}`}
              aria-hidden="true"
            >
              <i />
            </div>
            <img
              src={`/media/parkdex/${stop.image}-360.webp`}
              srcset={`/media/parkdex/${stop.image}-360.webp 360w, /media/parkdex/${stop.image}-640.webp 640w`}
              sizes="(max-width: 760px) 60vw, 19rem"
              width="640"
              height="1385"
              loading="lazy"
              decoding="async"
              alt={stop.alt}
            />
          </figure>
        </article>
      ))}

      <div class="pk-ground" data-ground>
        <svg class="pk-hill" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 220V120C220 30 460 20 720 70s520 70 720-20v170z"></path>
        </svg>
        <div class="pk-end">
          <img
            class="pk-end__kip"
            src="/media/parkdex/kip-cheer.webp"
            width="360"
            height="360"
            loading="lazy"
            alt=""
          />
          <h3>1,000+ parks. Which one’s yours?</h3>
          <div class="pk-end__links">
            <a
              class="pk-btn pk-btn--main"
              href="https://play.google.com/store/apps/details?id=app.parkdex"
            >
              Get it on Google Play
            </a>
            <a class="pk-btn" href="https://parkdex.app/">
              parkdex.app ↗
            </a>
            <a class="pk-btn" href="https://web.parkdex.app/">
              Open the web app ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pk-rise {
    position: relative;
    pointer-events: none;
    z-index: 3;
    width: 100%;
    height: clamp(5rem, 12vw, 11rem);
    margin-top: calc(clamp(5rem, 12vw, 11rem) * -1);
    fill: #cdeeff;
  }

  .pk {
    --ink: #142620;
    --orange: #ff5a1f;
    --cream: #fff7e8;
    --yellow: #ffc83d;
    --forest: #1f6448;
    --floor: #16452f;
    position: relative;
    z-index: 2;
    color: var(--ink);
    font-family: 'Bricolage Grotesque Variable', var(--sans);
  }

  .pk-trip {
    position: relative;
    background: var(--forest);
  }

  /* Pinned for the whole trip, behind and in front of the route. Taking no height of their own, they
     let the route set the page's length, so the journey is ordinary scrolling. */
  .pk-back,
  .pk-front {
    position: sticky;
    top: 0;
    height: 100lvh;
    margin-bottom: -100lvh;
    overflow: clip;
    pointer-events: none;
  }

  .pk-back {
    z-index: 0;
    background: linear-gradient(#58b488, #2c7f5c);
  }

  /* The forest darkens the deeper it goes. */
  .pk-back::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #0d3024;
    opacity: calc(var(--p, 0) * 0.6);
  }

  .pk-front {
    z-index: 2;
  }

  .pk-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 200%;
    background-repeat: repeat;
    will-change: transform;
  }

  .pk-layer--far {
    background-image: url('../art/parkdex/far.svg');
    background-position: center top;
    background-size: max(100%, 62rem) 50%;
  }

  .pk-layer--mid {
    background-image: url('../art/parkdex/mid.svg');
    background-position: center top;
    background-size: max(100%, 56rem) 50%;
  }

  /* Foreground leaves belong to the forest, so they stay off the sky and the ground. */
  .pk-layer--near {
    opacity: 0;
    transition: opacity 260ms;
  }

  .pk-front[data-forest] .pk-layer--near {
    opacity: 1;
  }

  /* The header blends with what's behind it, and mid-greens would swallow it. */
  .pk-front::before {
    content: '';
    position: absolute;
    z-index: 3;
    inset: 0 0 auto;
    height: 5rem;
    background: linear-gradient(rgb(9 36 27 / 85%), transparent);
    opacity: 0;
    transition: opacity 260ms;
  }

  .pk-front[data-forest]::before {
    opacity: 1;
  }

  .pk-layer--near::before,
  .pk-layer--near::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1rem;
    width: clamp(4rem, 10vw, 10rem);
    background: url('../art/parkdex/near.svg') left top / 100% 50% repeat-y;
  }

  .pk-layer--near::after {
    right: -1rem;
    left: auto;
    scale: -1 1;
  }

  .pk-route {
    position: relative;
    z-index: 1;
    --vine-x: 50%;
    --vine-width: clamp(14rem, 23vw, 21.5rem);
  }

  .pk-vine {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    left: calc(var(--vine-x) - var(--vine-width) / 2);
    width: var(--vine-width);
    background: url('../art/parkdex/vine.svg') center top / 100% auto repeat-y;
  }

  .pk-sky {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 120lvh;
    padding: 6rem var(--gutter) 2rem;
    overflow: clip;
    background: linear-gradient(#cdeeff, #eaf7ff);
  }

  h2 {
    position: relative;
    z-index: 2;
    max-width: 42vw;
    font-size: clamp(3rem, 7.4vw, 7rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .pk-cloud {
    position: absolute;
    width: 22rem;
    height: 7rem;
    border-radius: 99rem;
    background: #fff;
    box-shadow:
      5rem -2.4rem 0 0.4rem #fff,
      11rem -1.1rem 0 -0.5rem #fff;
    animation: drift 26s ease-in-out infinite alternate;
  }

  .pk-cloud--one {
    top: 26%;
    right: 3%;
  }

  .pk-cloud--two {
    top: 66%;
    right: 24%;
    scale: 0.6;
    animation-duration: 34s;
    animation-direction: alternate-reverse;
  }

  @keyframes drift {
    to {
      translate: -5rem 0;
    }
  }

  /* The solid band of leaves hides the moment the sky gives way to the forest. */
  .pk-canopy {
    height: 110lvh;
    background: url('../art/parkdex/canopy.svg') center / cover no-repeat;
  }

  .pk-stop {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    min-height: 118lvh;
    padding: 2rem calc(var(--gutter) + 9vw);
  }

  h3 {
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .pk-stop h3 {
    justify-self: start;
    max-width: 12ch;
    padding: 0.5rem 1rem 0.6rem;
    border: 4px solid var(--ink);
    border-radius: 1.1rem;
    background: var(--cream);
    box-shadow: 0 0.4rem 0 var(--ink);
    font-size: clamp(2.2rem, 4.2vw, 3.9rem);
    line-height: 1;
    rotate: -2deg;
  }

  .pk-stop:nth-of-type(odd) h3 {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    rotate: 2deg;
  }

  .pk-hang {
    position: relative;
    justify-self: center;
    width: fit-content;
    transform-origin: 50% -2rem;
    animation: swing 3.4s ease-in-out infinite alternate;
  }

  .pk-stop:nth-of-type(odd) .pk-hang {
    grid-column: 1;
    grid-row: 1;
    animation-delay: -1.4s;
  }

  @keyframes swing {
    from {
      transform: rotate(-1.8deg);
    }

    to {
      transform: rotate(1.8deg);
    }
  }

  .pk-hang img {
    position: relative;
    width: auto;
    height: min(74lvh, 40rem);
    max-width: none;
    border: 0.45rem solid var(--ink);
    border-radius: 2.1rem;
    box-shadow: 0.55rem 0.55rem 0 var(--ink);
  }

  .pk-pole {
    position: absolute;
    z-index: 2;
    top: 8%;
    left: -2.4rem;
    width: 0.55rem;
    height: 62%;
    border: 2px solid var(--ink);
    border-radius: 0.3rem;
    background: var(--cream);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 500ms cubic-bezier(0.2, 1.5, 0.4, 1) 120ms;
  }

  .pk-stop:nth-of-type(even) .pk-pole {
    right: -2.4rem;
    left: auto;
  }

  .pk-stop[data-reached] .pk-pole {
    transform: none;
  }

  .pk-pole i {
    position: absolute;
    top: 0.2rem;
    left: 100%;
    width: 4rem;
    height: 2.7rem;
    border: 3px solid var(--ink);
    background: linear-gradient(90deg, var(--a) 50%, var(--b) 50%);
    transform-origin: 0 50%;
    animation: wave 1.5s ease-in-out infinite alternate;
  }

  .pk-stop:nth-of-type(odd) .pk-pole i {
    right: 100%;
    left: auto;
    transform-origin: 100% 50%;
  }

  @keyframes wave {
    to {
      transform: skewY(-7deg) scaleX(0.94);
    }
  }

  .pk-ground {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: center;
    min-height: 100lvh;
    padding: clamp(7rem, 16vw, 13rem) var(--gutter) 4rem;
    color: var(--cream);
    background: linear-gradient(transparent clamp(5rem, 14vw, 11rem), var(--floor) 0);
  }

  .pk-hill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: clamp(5rem, 14vw, 11rem);
    fill: var(--floor);
  }

  .pk-end {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .pk-end__kip {
    width: clamp(8rem, 15vw, 13rem);
    animation: hop 1s ease-in-out infinite alternate;
  }

  @keyframes hop {
    to {
      translate: 0 -0.8rem;
    }
  }

  .pk-end h3 {
    max-width: 14ch;
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    line-height: 0.95;
  }

  .pk-end__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  .pk-btn {
    display: inline-block;
    padding: 0.7rem 1.1rem;
    border: 3px solid var(--ink);
    border-radius: 99rem;
    background: var(--cream);
    box-shadow: 0 0.3rem 0 var(--ink);
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 120ms,
      box-shadow 120ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .pk-btn:hover {
      transform: translateY(0.15rem);
      box-shadow: 0 0.15rem 0 var(--ink);
    }
  }

  .pk-btn--main {
    background: var(--orange);
  }

  .pk-score {
    position: absolute;
    z-index: 3;
    top: 4rem;
    right: var(--gutter);
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.35rem 1rem 0.35rem 0.55rem;
    border: 3px solid var(--ink);
    border-radius: 99rem;
    background: var(--cream);
    box-shadow: 0 0.25rem 0 var(--ink);
  }

  .pk-score b {
    font-size: 1.3rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .flagmark {
    width: 1.9rem;
    height: 1.3rem;
    border: 2px solid var(--ink);
    border-radius: 0.15rem;
    background: linear-gradient(90deg, #7a3fb0 50%, #1fa08d 50%);
  }

  /* Holds Kip on the vine's line, a little above the middle of the screen. */
  .pk-rider {
    --size: clamp(6.5rem, 11vw, 10rem);
    position: absolute;
    z-index: 2;
    top: 38%;
    left: calc(50% - var(--size) * 0.72);
    width: var(--size);
    height: var(--size);
    transition: opacity 240ms;
  }

  .pk-rider img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 120ms;
  }

  .pk-rider img[data-on] {
    opacity: 1;
  }

  .pk-rider__say {
    position: absolute;
    bottom: 96%;
    left: -12%;
    padding: 0.25rem 0.7rem;
    border: 3px solid var(--ink);
    border-radius: 0.9rem;
    background: var(--cream);
    box-shadow: 0 0.2rem 0 var(--ink);
    font-size: 0.95rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .pk-front[data-done] .pk-rider,
  .pk-front[data-done] .pk-score {
    opacity: 0;
  }

  /* Over the ground, the buttons need the room. */
  .pk-front[data-done] .pk-plant {
    visibility: hidden;
  }

  .pk-plant {
    position: absolute;
    z-index: 3;
    right: var(--gutter);
    bottom: calc(1.25rem + 100lvh - 100svh);
    display: grid;
    justify-items: center;
    width: 5.6rem;
    height: 5.6rem;
    padding: 0.8rem 0 0;
    border: 4px solid var(--ink);
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 4px var(--cream);
    color: var(--cream);
    pointer-events: auto;
    transition: transform 100ms;
  }

  .pk-plant:active {
    transform: scale(0.92);
  }

  .pk-plant svg {
    width: 2.2rem;
    height: 2.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .pk-plant span {
    margin-top: -0.2rem;
    padding: 0 0.5rem;
    border: 2px solid var(--ink);
    border-radius: 99rem;
    background: var(--yellow);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 800;
  }

  :global(.pk-mark) {
    position: absolute;
    width: 3.2rem;
    height: 3.6rem;
    margin-top: -3.6rem;
    border-left: 0.32rem solid #142620;
    animation: sprout 420ms cubic-bezier(0.2, 1.6, 0.4, 1);
    transform-origin: 0 100%;
  }

  :global(.pk-mark)::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3rem;
    height: 2rem;
    border: 2px solid #142620;
    background: var(--flag);
  }

  :global(.pk-points) {
    position: absolute;
    z-index: 4;
    top: 26%;
    left: 50%;
    color: #fff1b8;
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    -webkit-text-stroke: 2px #142620;
    pointer-events: none;
    animation: rise 900ms ease-out forwards;
  }

  @keyframes sprout {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes rise {
    to {
      opacity: 0;
      transform: translateY(-5rem) scale(1.25);
    }
  }

  /* Short of room at the edge of the screen, the flags fly in over their phones. */
  @media (max-width: 1000px) {
    .pk-stop:nth-of-type(even) .pk-pole i {
      right: 100%;
      left: auto;
      transform-origin: 100% 50%;
    }

    .pk-stop:nth-of-type(odd) .pk-pole i {
      right: auto;
      left: 100%;
      transform-origin: 0 50%;
    }
  }

  /* On a phone the vine runs down the left, and the stops hang beside it. */
  @media (max-width: 760px) {
    .pk-route {
      --vine-x: 17%;
      --vine-width: 10rem;
    }

    .pk-sky {
      padding-left: 32%;
    }

    /* Fewer big moving layers for a phone to hold in memory: the mid trees carry the depth here, and
       the vine has this side, so only the far edge keeps its leaves. */
    .pk-layer--far,
    .pk-layer--near::before {
      display: none;
    }

    .pk-layer--near {
      right: 0;
      left: auto;
      width: 4rem;
    }

    h2 {
      max-width: none;
      font-size: clamp(2.7rem, 12.5vw, 4.5rem);
    }

    .pk-cloud {
      scale: 0.5;
    }

    .pk-cloud--one {
      top: 12%;
      right: -10rem;
    }

    .pk-cloud--two {
      top: 84%;
      right: -6rem;
    }

    .pk-stop {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
      justify-items: center;
      align-content: center;
      min-height: 108lvh;
      padding: 1.5rem 1rem 1.5rem 30%;
    }

    .pk-stop h3,
    .pk-stop:nth-of-type(odd) h3 {
      grid-column: 1;
      grid-row: auto;
      justify-self: center;
      max-width: none;
      font-size: clamp(1.7rem, 7.8vw, 2.6rem);
      text-align: center;
      white-space: nowrap;
    }

    .pk-stop:nth-of-type(odd) .pk-hang {
      grid-column: 1;
      grid-row: auto;
    }

    /* Sized from whichever runs out first, the space beside the vine or the screen's height. */
    .pk-hang img {
      width: min(70vw - 1.75rem, 62svh * 0.4624, 13.9rem);
      height: auto;
      border-width: 0.3rem;
      border-radius: 1.5rem;
      box-shadow: 0.35rem 0.35rem 0 var(--ink);
    }

    .pk-pole,
    .pk-stop:nth-of-type(even) .pk-pole {
      top: -0.5rem;
      right: 1rem;
      left: auto;
      height: 3.4rem;
    }

    .pk-pole i,
    .pk-stop:nth-of-type(odd) .pk-pole i {
      right: 100%;
      left: auto;
      width: 2.6rem;
      height: 1.8rem;
      transform-origin: 100% 50%;
    }

    .pk-rider {
      --size: 4.75rem;
      top: 44%;
      left: calc(17% - var(--size) * 0.5);
    }

    .pk-rider__say {
      display: none;
    }

    .pk-plant {
      width: 4.6rem;
      height: 4.6rem;
      padding-top: 0.55rem;
    }

    .pk-plant svg {
      width: 1.8rem;
      height: 1.8rem;
    }
  }

  /* Phones on their side: the stops keep their phones and lose the controls that would cover them. */
  @media (max-height: 480px) {
    .pk-plant,
    .pk-rider {
      display: none;
    }

    .pk-hang img {
      height: 82svh;
    }

    .pk-sky {
      min-height: 100lvh;
    }

    h2 {
      font-size: 2.4rem;
    }
  }

  @media (scripting: none) {
    .pk-plant,
    .pk-score,
    .pk-rider {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce), (scripting: none) {
    .pk-back,
    .pk-front {
      display: none;
    }

    .pk-trip {
      background: #2c7f5c;
    }

    .pk-cloud,
    .pk-hang,
    .pk-pole i,
    .pk-end__kip {
      animation: none;
    }

    .pk-pole {
      transform: none;
    }

    .pk-stop {
      min-height: 0;
      padding-block: 3rem;
    }

    .pk-sky {
      min-height: 70svh;
    }

    .pk-canopy {
      height: 60svh;
    }
  }
</style>
