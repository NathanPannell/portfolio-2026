---
import StepsToggle from './StepsToggle.astro';

const stops = [
  {
    image: 'arrival',
    title: 'Visit a park.',
    alt: 'Parkdex map of Beacon Hill Park: inside the boundary, with a flag to take',
  },
  {
    image: 'planted',
    title: 'Plant your flag.',
    alt: 'Parkdex flag planted screen: plus six points',
  },
  {
    image: 'leaderboard',
    title: 'Earn points.',
    alt: 'Parkdex leaderboard of demo players: a podium, then everyone else ranked by points',
  },
  {
    image: 'explore',
    title: 'Explore your city!',
    alt: 'Parkdex map of Victoria, with flags flying over its parks',
  },
];
---

<section
  id="parkdex"
  class="pk"
  data-frame
  data-moment
  data-trip
  data-loops
  tabindex="-1"
  aria-labelledby="pk-title"
>
  <div class="pk-trip">
    <div class="pk-back" aria-hidden="true">
      <div class="pk-layer pk-layer--far" data-layer="0.12"></div>
      <div class="pk-layer pk-layer--mid" data-layer="0.3"></div>
    </div>

    <div class="pk-world" data-world>
      <div class="pk-vine" data-vine aria-hidden="true"></div>

      <div class="pk-sky">
        <i class="pk-cloud pk-cloud--one" aria-hidden="true"></i>
        <i class="pk-cloud pk-cloud--two" aria-hidden="true"></i>
        <div class="pk-title">
          <p class="pk-name">Parkdex</p>
          <h2 id="pk-title">Capture the flag, for real parks.</h2>
        </div>
      </div>

      <div class="pk-canopy" aria-hidden="true"></div>

      <div class="pk-forest" data-forest-floor data-opens>
        <div
          class="pk-steps"
          data-steps="parkdex"
          data-layout-default="side"
          data-start-on="moment:landed"
          style={`--count: ${stops.length}`}
        >
          <ol class="pk-stops" data-steps-list>
            {stops.map((stop, index) => (
              <li class="pk-stop" data-stop data-step style={`--stop: ${index}`}>
                <h3>
                  <span aria-hidden="true">{index + 1}</span> {stop.title}
                </h3>
                <figure class="pk-hang">
                  <img
                    src={`/media/parkdex/${stop.image}-360.webp`}
                    srcset={`/media/parkdex/${stop.image}-360.webp 360w, /media/parkdex/${stop.image}-640.webp 640w`}
                    sizes="(max-width: 760px) 54vw, 24rem"
                    width="640"
                    height="1385"
                    loading="lazy"
                    decoding="async"
                    alt={stop.alt}
                  />
                </figure>
              </li>
            ))}
          </ol>
          <div class="pk-window" data-steps-window hidden>
            <div class="pk-window__view" data-steps-view></div>
          </div>
          <img
            class="pk-guide"
            src="/media/parkdex/kip-point.webp"
            width="360"
            height="360"
            loading="lazy"
            alt=""
          />
          <button class="pk-slide" type="button" data-slide>
            Slide down with Kip <span aria-hidden="true">↓</span>
          </button>
          <StepsToggle />
        </div>
      </div>
    </div>

    <div class="pk-layer pk-layer--near" data-layer="1.5" aria-hidden="true"></div>

    <div class="pk-rider" data-rider aria-hidden="true">
      <span class="pk-rider__say">KLEEP!</span>
      <img
        data-pose
        data-on
        src="/media/parkdex/kip-wave.webp"
        width="360"
        height="360"
        loading="lazy"
        alt=""
      />
      <img
        data-pose
        src="/media/parkdex/kip-point.webp"
        width="360"
        height="360"
        loading="lazy"
        alt=""
      />
    </div>

    <button
      class="pk-plant"
      type="button"
      data-moment-control
      aria-expanded="false"
      aria-label="Plant your flag and ride the vine down"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 21V3h13l-3 4.5 3 4.5H6"></path>
      </svg>
      <span>Plant!</span>
    </button>
  </div>

  <div class="pk-ground" data-ground data-opens tabindex="-1">
    <div class="pk-vine pk-vine--end" data-vine-end aria-hidden="true"></div>
    <div class="pk-end">
      <img
        class="pk-end__kip"
        data-kip-spot
        src="/media/parkdex/kip-cheer.webp"
        width="360"
        height="360"
        loading="lazy"
        alt=""
      />
      <div class="pk-sign">
        <h3>1,000+ parks. Which one’s yours?</h3>
        <div class="pk-end__links">
          <a
            class="pk-btn pk-btn--main"
            href="https://play.google.com/store/apps/details?id=app.parkdex"
          >
            Get it on Google Play
          </a>
          <a class="pk-btn" href="https://parkdex.app/">
            parkdex.app ↗
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="pk-diver" data-diver aria-hidden="true">
    <img
      data-pose
      src="/media/parkdex/kip-wave.webp"
      width="360"
      height="360"
      loading="lazy"
      alt=""
    />
    <img
      data-pose
      data-on
      src="/media/parkdex/kip-point.webp"
      width="360"
      height="360"
      loading="lazy"
      alt=""
    />
  </div>
</section>

<style>
  .pk {
    --ink: #142620;
    --orange: #ff5a1f;
    --cream: #fff7e8;
    --yellow: #ffc83d;
    --forest: #1f6448;
    --floor: #16452f;
    --bar: calc(100lvh - 100svh);
    --vine-x: 50%;
    --vine-width: clamp(14rem, 23vw, 21.5rem);
    position: relative;
    color: var(--ink);
    font-family: 'Bricolage Grotesque Variable', var(--sans);
  }

  .pk:focus,
  .pk-ground:focus {
    outline: none;
  }

  /* Without a stage the trip is plain page content, top to bottom. */
  .pk-trip {
    position: relative;
    background: var(--forest);
  }

  :global(.stage) .pk-trip {
    height: 100lvh;
    overflow: clip;
  }

  .pk-back,
  .pk-layer--near,
  .pk-rider,
  .pk-plant,
  .pk-slide,
  .pk-diver,
  .pk-vine--end {
    display: none;
  }

  :global(.stage) .pk-trip .pk-back {
    position: absolute;
    inset: 0;
    display: block;
    overflow: clip;
    background: linear-gradient(#3f9a72, #1f6a4c);
  }

  /* A little dusk over the trees, so the stops stand out. */
  .pk-back::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #0d3024;
    opacity: 0.3;
  }

  .pk-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 200%;
    background-repeat: repeat;
    will-change: transform;
    pointer-events: none;
  }

  .pk-layer--far {
    background-image: url('../art/parkdex/far.svg');
    background-position: center top;
    background-size: max(100%, 62rem) 50%;
  }

  .pk-layer--mid {
    background-image: url('../art/parkdex/mid.svg');
    background-position: center top;
    background-size: max(100%, 56rem) 50%;
  }

  /* Foreground leaves whip past on the ride, and are gone by the time Kip lands. */
  .pk[data-riding] .pk-layer--near {
    display: block;
    z-index: 3;
    animation: leaves 2800ms ease-in-out both;
  }

  @keyframes leaves {
    0%,
    30% {
      opacity: 0;
    }

    50%,
    80% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  .pk-layer--near::before,
  .pk-layer--near::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1rem;
    width: clamp(4rem, 10vw, 10rem);
    background: url('../art/parkdex/near.svg') left top / 100% 50% repeat-y;
  }

  .pk-layer--near::after {
    right: -1rem;
    left: auto;
    scale: -1 1;
  }

  .pk-world {
    position: relative;
  }

  :global(.stage) .pk-trip .pk-world {
    position: absolute;
    inset: 0 0 auto;
    will-change: transform;
  }

  .pk-vine {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    left: calc(var(--vine-x) - var(--vine-width) / 2);
    width: var(--vine-width);
    background: url('../art/parkdex/vine.svg') center top / 100% auto repeat-y;
  }

  .pk-sky {
    position: relative;
    display: grid;
    align-content: center;
    height: 100lvh;
    padding: 5rem var(--gutter) calc(2rem + var(--bar));
    overflow: clip;
    background: linear-gradient(#cdeeff, #eaf7ff);
  }

  .pk-title {
    position: relative;
    z-index: 2;
  }

  .pk-name {
    color: #c9420f;
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  h2 {
    max-width: 42vw;
    font-size: clamp(3rem, min(7.4vw, 15svh), 7rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .pk-cloud {
    position: absolute;
    width: 22rem;
    height: 7rem;
    border-radius: 99rem;
    background: #fff;
    box-shadow:
      5rem -2.4rem 0 0.4rem #fff,
      11rem -1.1rem 0 -0.5rem #fff;
    animation: drift 26s ease-in-out infinite alternate;
  }

  .pk-cloud--one {
    top: 26%;
    right: 3%;
  }

  .pk-cloud--two {
    top: 66%;
    right: 24%;
    scale: 0.6;
    animation-duration: 34s;
    animation-direction: alternate-reverse;
  }

  @keyframes drift {
    to {
      translate: -5rem 0;
    }
  }

  /* The solid band of leaves hides the moment the sky gives way to the forest. */
  .pk-canopy {
    height: 110lvh;
    background: url('../art/parkdex/canopy.svg') center / cover no-repeat;
  }

  .pk-forest {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: center;
    min-height: 100svh;
    padding: 4.5rem var(--gutter) 1.5rem;
  }

  :global(.stage) .pk-trip .pk-forest {
    height: 100lvh;
    padding-bottom: calc(4.5rem + var(--bar));
  }

  /* The steps side by side need nothing of their own here. See the rotating layout below. */
  .pk-steps {
    display: contents;
  }

  /* Four phones in a row, each sized from whichever runs out first, the width or the height. */
  .pk-stops {
    --shot: min(calc((100vw - var(--gutter) * 2 - 6rem) / 4), calc((100svh - 13.5rem) * 0.4624));
    display: flex;
    gap: 2rem;
    align-items: start;
    justify-content: center;
  }

  .pk-stop {
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    width: var(--shot);
  }

  .pk-stop:nth-child(even) {
    margin-top: 1.5rem;
  }

  /* The phones drop in on the vine one by one, once Kip has landed. */
  :global(.stage) .pk:not([data-landed]) .pk-stop {
    visibility: hidden;
    transform: translate3d(0, -110lvh, 0) rotate(6deg);
  }

  .pk[data-landed] .pk-stop {
    transition: transform 760ms cubic-bezier(0.2, 1.3, 0.4, 1) calc(var(--stop) * 260ms);
  }

  h3 {
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .pk-stop h3 {
    padding: 0.25rem 0.7rem 0.35rem;
    border: 3px solid var(--ink);
    border-radius: 0.8rem;
    background: var(--cream);
    box-shadow: 0 0.25rem 0 var(--ink);
    font-size: clamp(0.9rem, min(1.75vw, 3.1svh), 1.7rem);
    line-height: 1;
    white-space: nowrap;
    rotate: -2deg;
  }

  .pk-stop:nth-child(even) h3 {
    rotate: 2deg;
  }

  .pk-stop h3 span {
    color: #c9420f;
  }

  .pk-hang {
    position: relative;
    transform-origin: 50% -2rem;
    animation: swing 3.4s ease-in-out infinite alternate;
  }

  .pk-stop:nth-child(even) .pk-hang {
    animation-delay: -1.4s;
  }

  @keyframes swing {
    from {
      transform: rotate(-1.8deg);
    }

    to {
      transform: rotate(1.8deg);
    }
  }

  .pk-hang img {
    position: relative;
    width: var(--shot);
    border: 0.3rem solid var(--ink);
    border-radius: 1.6rem;
    box-shadow: 0.35rem 0.35rem 0 var(--ink);
  }

  /* Rotating: trail signs down one side of the vine, and one big phone hanging on the other. Kip
     climbs down the vine beside whichever sign is showing. */
  .pk-steps[data-layout='rotating'] {
    --shot: min(
      calc((100vw - var(--gutter) * 2 - var(--vine-width)) / 2),
      calc((100svh - 10.5rem) * 0.46)
    );
    --row: 4.5rem;
    --row-gap: 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--vine-width);
    align-items: center;
  }

  .pk-steps[data-layout='rotating'] .pk-stops {
    grid-row: 1;
    grid-column: 1;
    flex-direction: column;
    gap: var(--row-gap);
    align-items: end;
  }

  .pk-steps[data-layout='rotating'] .pk-stop {
    display: flex;
    align-items: center;
    width: auto;
    height: var(--row);
    margin: 0;
    rotate: -2deg;
  }

  .pk-steps[data-layout='rotating'] .pk-stop:nth-child(even) {
    rotate: 2deg;
  }

  .pk-steps[data-layout='rotating'] h3 {
    padding: 0;
    font-size: clamp(1.05rem, min(1.9vw, 3.4svh), 1.9rem);
    white-space: normal;
    rotate: none;
    transition: background 200ms;
  }

  .pk-steps[data-layout='rotating'] [data-current] h3 {
    background: var(--orange);
  }

  .pk-steps[data-layout='rotating'] [data-current] h3 span {
    color: var(--ink);
  }

  .pk-stop h3 :global(.step__pick) {
    padding: 0.4rem 0.8rem 0.5rem;
    border: 0;
    border-radius: 0.6rem;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: start;
    cursor: pointer;
  }

  .pk-window {
    grid-row: 1;
    grid-column: 2;
    width: var(--shot);
    overflow: hidden;
    border: 0.3rem solid var(--ink);
    border-radius: 1.6rem;
    background: var(--ink);
    box-shadow: 0.35rem 0.35rem 0 var(--ink);
    transform-origin: 50% -2rem;
    animation: sway 3.4s ease-in-out infinite alternate;
  }

  .pk-window[hidden] {
    display: none;
  }

  @keyframes sway {
    from {
      rotate: -1.2deg;
    }

    to {
      rotate: 1.2deg;
    }
  }

  .pk-window__view {
    display: grid;
  }

  .pk-window .pk-hang {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 320ms,
      visibility 0s 320ms;
    animation: none;
  }

  .pk-window .pk-hang[data-current] {
    opacity: 1;
    visibility: visible;
    transition: opacity 320ms;
  }

  .pk-window .pk-hang img {
    width: 100%;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .pk-guide {
    display: none;
  }

  [data-layout='rotating'] > .pk-guide {
    z-index: 2;
    display: block;
    grid-row: 1;
    grid-column: 1 / -1;
    justify-self: center;
    width: clamp(6rem, 9vw, 8.5rem);
    transform: translate3d(
      -8%,
      calc((var(--now, 0) - (var(--count) - 1) / 2) * (var(--row) + var(--row-gap))),
      0
    );
    transition: transform 700ms var(--ease);
    pointer-events: none;
  }

  /* The window and Kip follow the signs in, once the first Kip has landed. */
  :global(.stage) .pk:not([data-landed]) .pk-window,
  :global(.stage) .pk:not([data-landed]) .pk-guide {
    visibility: hidden;
    translate: 0 -110lvh;
  }

  .pk[data-landed] .pk-window,
  .pk[data-landed] .pk-guide {
    transition:
      translate 760ms cubic-bezier(0.2, 1.3, 0.4, 1) 260ms,
      transform 700ms var(--ease);
  }

  /* The bottom of the vine. On a stage, this screen waits until the flag is planted. */
  .pk-ground {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 100lvh;
    overflow: clip;
    padding: clamp(4.5rem, 10vw, 8rem) var(--gutter) calc(2rem + var(--bar));
    color: var(--cream);
    background: url('../art/parkdex/ground.svg') center bottom / cover no-repeat var(--forest);
  }

  :global(.stage) .pk:not([data-open]) .pk-ground {
    display: none;
  }

  :global(.stage) .pk-vine--end {
    display: block;
    bottom: 58%;
    mask: linear-gradient(#000 calc(100% - 3rem), transparent);
  }

  /* A layer of its own in front of the vine, which keeps the sign's posts in front of the view. */
  .pk-end {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  /* Waits for Kip to arrive, then takes over from the one on the vine. */
  .pk-end__kip {
    position: relative;
    z-index: 1;
    width: clamp(7rem, min(13vw, 22svh), 11rem);
    margin-bottom: -1.4rem;
    animation: hop 1s ease-in-out infinite alternate;
  }

  :global(.stage) .pk:not([data-jumped]) .pk-end__kip {
    visibility: hidden;
  }

  @keyframes hop {
    to {
      translate: 0 -0.8rem;
    }
  }

  /* A park's own sign: planks and two posts, so the type stays clear of the view behind it. */
  .pk-sign {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    max-width: min(100%, 52rem);
    padding: clamp(1.25rem, 3svh, 2.25rem) clamp(1.25rem, 4vw, 3.25rem);
    border: 0.3rem solid var(--ink);
    border-radius: 1.1rem;
    background:
      repeating-linear-gradient(rgb(20 38 32 / 34%) 0 3px, transparent 3px 33.33%),
      linear-gradient(#7a4a26, #5b3419);
    box-shadow: 0 0.55rem 0 var(--ink);
  }

  .pk-sign::before,
  .pk-sign::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: 100%;
    width: 1.5rem;
    height: 100lvh;
    border: 0.3rem solid var(--ink);
    background: #5b3419;
  }

  .pk-sign::before {
    left: 16%;
  }

  .pk-sign::after {
    right: 16%;
  }

  .pk-end h3 {
    max-width: 14ch;
    font-size: clamp(2.4rem, min(6vw, 11svh), 5.5rem);
    line-height: 0.95;
  }

  .pk-end__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .pk-btn {
    display: inline-block;
    padding: 0.7rem 1.1rem;
    border: 3px solid var(--ink);
    border-radius: 99rem;
    background: var(--cream);
    box-shadow: 0 0.3rem 0 var(--ink);
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 120ms,
      box-shadow 120ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .pk-btn:hover {
      transform: translateY(0.15rem);
      box-shadow: 0 0.15rem 0 var(--ink);
    }
  }

  .pk-btn--main {
    background: var(--orange);
  }

  /* Holds Kip on the vine's line, a little above the middle of the screen. */
  .pk-rider {
    --size: clamp(6.5rem, 11vw, 10rem);
    position: absolute;
    z-index: 2;
    top: 38%;
    left: calc(50% - var(--size) * 0.72);
    width: var(--size);
    height: var(--size);
    transition: opacity 240ms;
  }

  :global(.stage) .pk-trip .pk-rider {
    display: block;
  }

  .pk[data-landed] .pk-rider {
    opacity: 0;
  }

  /* One Kip for the rest of the way down, loose in the section so the frames can't clip it. */
  .pk-diver {
    position: absolute;
    z-index: 5;
    top: 0;
    left: 0;
    width: clamp(6.5rem, 11vw, 10rem);
    aspect-ratio: 1;
    pointer-events: none;
  }

  .pk[data-diving] .pk-diver {
    display: block;
  }

  .pk-diver img {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .pk-diver img[data-on] {
    opacity: 1;
  }

  /* The way on down, once the phones are in. */
  .pk-slide {
    position: absolute;
    z-index: 3;
    bottom: calc(1.25rem + var(--bar));
    left: 50%;
    padding: 0.7rem 1.3rem;
    border: 3px solid var(--ink);
    border-radius: 99rem;
    background: var(--yellow);
    box-shadow: 0 0.3rem 0 var(--ink);
    color: var(--ink);
    font-weight: 800;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  :global(.stage) .pk[data-landed]:not([data-diving], [data-jumped]) .pk-slide {
    display: block;
  }

  .pk-slide:active {
    box-shadow: 0 0.1rem 0 var(--ink);
    translate: 0 0.2rem;
  }

  .pk-rider img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 120ms;
  }

  .pk-rider img[data-on] {
    opacity: 1;
  }

  .pk-rider__say {
    position: absolute;
    bottom: 96%;
    left: -12%;
    padding: 0.25rem 0.7rem;
    border: 3px solid var(--ink);
    border-radius: 0.9rem;
    background: var(--cream);
    box-shadow: 0 0.2rem 0 var(--ink);
    font-size: 0.95rem;
    font-weight: 800;
    white-space: nowrap;
  }

  /* The one big button, and the point of the game: plant it. */
  .pk-plant {
    position: absolute;
    z-index: 3;
    top: calc(50svh - 4.25rem);
    left: calc(50% + clamp(6rem, 13vw, 11rem));
    justify-items: center;
    width: 8.5rem;
    height: 8.5rem;
    padding: 1.15rem 0 0;
